---
import "../styles/scss/global/_index.scss";
// import "../lib/nav.js";

const { title = "Lords and Legends" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <!-- favicons -->
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="src/assets/favicon/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="src/assets/favicon/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="src/assets/favicon/favicon-16x16.png"
        />
        <link rel="manifest" href="src/assets/favicon/site.webmanifest" />
        <link
            rel="icon"
            type="image/svg+xml"
            href="src/assets/favicon/favicon.svg"
        />
        <link rel="icon" href="src/assets/favicon/favicon.ico" />
        <!-- style sheets -->
        <!-- <link rel="stylesheet" href="dist/styles/style.css" /> -->

        <!-- <meta name="generator" content={Astro.generator} /> -->
        <title>{title}</title>
        <script
            is:inline
            defer
            src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
        ></script>
        <!-- <script is:inline src="../lib/nav.js"></script> -->
    </head>
    <body>
        <slot />
    </body>
</html>
