---
// import "../../src/style.css";
import Favicons from "../components/MetaData/Favicons.astro"; // Import the favicons component
import Fonts from "../../src/components/Fonts.astro"; // Import the fonts component
import Nav from "../components/Nav.astro"; // Import the navigation component
import TopBtn from "../components/topBtn.astro"; // Import the top button component
import Footer from "../components/Footer.astro"; // Import the footer component
import SiteDialog from "../components/SiteDialog.astro"; // Styled confirm / alert / toast pop-ups

import "../styles/icons.css"; // Placeholder icon slots (see the file for how to add your SVGs)
import "../styles/main.scss"; // Import the main styles
import "../styles/contact.scss"; // Import the contact styles
import "../styles/menu.scss"; // Import the menu styles
// import "../lib/nav.js";

const { title = "Lords and Legends" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <!-- favicons -->
        <Favicons />
        <!-- style sheets -->

        <!-- <meta name="generator" content={Astro.generator} /> -->
        <title>{title}</title>
        <!-- 1. Collapse Plugin (MUST be placed before Alpine core) -->
        <script
            defer
            src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"
        ></script>
        <!-- 2. Alpine Core -->
        <script
            defer
            src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
        ></script>
        <Fonts />
        <!-- Extra tags a page wants in <head>: <meta name="robots" content="noindex" slot="head" /> -->
        <slot name="head" />
        <!-- font awesome icons -->
        <!-- <script
            src="https://kit.fontawesome.com/07324e9632.js"
            crossorigin="anonymous"
            is:inline
            defer
        ></script> -->
        <!-- <script is:inline src="../lib/nav.js"></script> -->
    </head>
    <style lang="scss">
        html {
            scroll-behavior: smooth;
        }
        :target {
            scroll-margin-top: var(--nav-header);
        }
        body {
            font-family: "Noto Sans", sans-serif;
            background-color: var(--bg-color);
            // overflow-x: hidden;
            margin: 0;
            padding: 0;
        }
        :root {
            --bg-color-light: hsl(14, 45%, 95%);
            --bg-color-btn: hsl(14, 45%, 30%);
            --bg-color-dark: hsl(20, 100%, 5%);
            --bg-color: var(--bg-color-light);

            --ham-color: hsl(215 30% 10%);
            --ham-color-active: hsl(215 30% 70%);

            --nav-bg: hsl(14, 45%, 85%);
            --nav-bg-highlight: hsl(17 30% 85.5%);
            --nav-bg-shadow: hsl(226 99.6% 7%);
            --nav-bg-shadowA: hsla(226 99.6% 7%/0.5);
            --nav-header: 6em;
            --nav-headerM: 4em;

            --text-color: hsl(30, 50%, 99%);
            --text-color-light: hsl(20, 100%, 5%);
            --text-color-dark: hsl(30, 50%, 99%);
            --txt-color: var(--text-color-light);

            --text-color-hover: hsl(16, 45%, 30%);

            --MenuColor: hsl(185 85% 40%);
            --MenuColorA: hsla(185 85% 5% / 0.9);

            --img-overlay: hsla(183 85.4% 2.3%/0.8);

            //         @media (prefers-color-scheme: dark) {
            //             --txt-color: var(--text-color-dark);
            //             --bg-color: var(--bg-color-dark);
            //         }
        }
    </style>

    <body>
        <TopBtn />
        <Nav />
        <slot />
        <Footer />
        <SiteDialog />
    </body>
</html>
