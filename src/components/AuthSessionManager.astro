---
interface Props {
    userEmail?: string;
    loginPath?: string;
    timeoutMinutes?: number;
}

const {
    userEmail = "User",
    loginPath = "/staff/login",
    timeoutMinutes = 15,
} = Astro.props;

const totalTimeoutMs = timeoutMinutes * 60 * 1000;
const warningWindowMs = 60 * 1000; // Warning shown at 14 minutes (60 seconds remaining)
---

<div class="session-manager-bar">
    <div class="user-info">
        <span class="status-indicator"></span>
        <span class="user-email">{userEmail}</span>
    </div>
    <button id="manual-logout-btn" class="signout-btn">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Sign Out
    </button>
</div>

<!-- Animated Inactivity Warning Popup -->
<div id="inactivity-modal" class="inactivity-modal hidden">
    <div class="inactivity-card">
        <div class="warning-icon">⚠️</div>
        <h3>Inactivity Notice</h3>
        <p>
            You have been inactive. To secure your account, you will be logged
            out in:
        </p>
        <div id="countdown-timer" class="timer-display">
            60s
        </div>
        <div class="modal-actions">
            <button id="stay-logged-in-btn" class="btn-stay">
                Stay Logged In
            </button>
            <button id="now-logout-btn" class="btn-logout">
                Log Out Now
            </button>
        </div>
    </div>
</div>

<script
    data-total-timeout={totalTimeoutMs}
    data-warning-window={warningWindowMs}
    data-login-path={loginPath}
>
    const scriptTag = document.currentScript;
    const totalTimeoutMs = parseInt(
        scriptTag?.dataset.totalTimeout || "900000",
        10,
    );
    const warningWindowMs = parseInt(
        scriptTag?.dataset.warningWindow || "60000",
        10,
    );
    const loginPath = scriptTag?.dataset.loginPath || "/staff/login";

    let lastActivityTime = Date.now();
    let warningTimer = null;
    let logoutTimer = null;
    let countdownInterval = null;
    let remainingSeconds = Math.floor(warningWindowMs / 1000);

    const modal = document.getElementById("inactivity-modal");
    const countdownEl = document.getElementById("countdown-timer");
    const stayBtn = document.getElementById("stay-logged-in-btn");
    const logoutBtn = document.getElementById("now-logout-btn");
    const manualLogoutBtn = document.getElementById("manual-logout-btn");

    async function performLogout() {
        try {
            await fetch("/api/logout", { method: "POST" });
        } catch (err) {
            console.error("Error logging out:", err);
        } finally {
            window.location.href = loginPath;
        }
    }

    function hideWarning() {
        if (modal) {
            modal.classList.remove("visible");
            setTimeout(() => modal.classList.add("hidden"), 300);
        }
        if (countdownInterval) clearInterval(countdownInterval);
    }

    function showWarning() {
        remainingSeconds = Math.floor(warningWindowMs / 1000);
        if (countdownEl) countdownEl.textContent = `${remainingSeconds}s`;

        if (modal) {
            modal.classList.remove("hidden");
            requestAnimationFrame(() => modal.classList.add("visible"));
        }

        countdownInterval = setInterval(() => {
            remainingSeconds -= 1;
            if (countdownEl) countdownEl.textContent = `${remainingSeconds}s`;
            if (remainingSeconds <= 0) {
                clearInterval(countdownInterval);
            }
        }, 1000);
    }

    function resetTimers() {
        lastActivityTime = Date.now();

        if (modal && modal.classList.contains("visible")) {
            hideWarning();
        }

        if (warningTimer) clearTimeout(warningTimer);
        if (logoutTimer) clearTimeout(logoutTimer);

        const timeUntilWarning = totalTimeoutMs - warningWindowMs;

        warningTimer = setTimeout(() => {
            showWarning();
        }, timeUntilWarning);

        logoutTimer = setTimeout(() => {
            performLogout();
        }, totalTimeoutMs);
    }

    // User activity listeners
    const activityEvents = [
        "mousemove",
        "keydown",
        "mousedown",
        "touchstart",
        "scroll",
    ];
    activityEvents.forEach((event) => {
        window.addEventListener(
            event,
            () => {
                // Only reset if modal is not currently displayed
                if (!modal || !modal.classList.contains("visible")) {
                    const now = Date.now();
                    if (now - lastActivityTime > 2000) {
                        // Throttle resets every 2s
                        resetTimers();
                    }
                }
            },
            { passive: true },
        );
    });

    if (stayBtn) {
        stayBtn.addEventListener("click", () => {
            hideWarning();
            resetTimers();
        });
    }

    if (logoutBtn) logoutBtn.addEventListener("click", performLogout);
    if (manualLogoutBtn)
        manualLogoutBtn.addEventListener("click", performLogout);

    // Initialize timers
    resetTimers();
</script>

<style>
    .session-manager-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        top: calc(var(--nav-header) / 3);
        background: #1a202c;
        color: #edf2f7;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .status-indicator {
        width: 8px;
        height: 8px;
        background-color: #00d4aa;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 6px #00d4aa;
    }

    .user-email {
        font-weight: 500;
        color: #e2e8f0;
    }

    .signout-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.1);
        color: #f7fafc;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 0.4rem 0.85rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .signout-btn:hover {
        background: #e53e3e;
        border-color: #e53e3e;
        color: white;
    }

    /* Animated Inactivity Modal */
    .inactivity-modal {
        position: fixed;
        top: 0;
        /*top: var(--nav-header);*/
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.7);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
            visibility 0.3s;
    }

    .inactivity-modal.hidden {
        display: none;
    }

    .inactivity-modal.visible {
        opacity: 1;
        visibility: visible;
        display: flex;
    }

    .inactivity-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        width: 90%;
        max-width: 380px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
        transform: scale(0.9) translateY(20px);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .inactivity-modal.visible .inactivity-card {
        transform: scale(1) translateY(0);
        animation: pulseWarning 2s infinite ease-in-out;
    }

    .warning-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .inactivity-card h3 {
        margin: 0 0 8px 0;
        color: #1e293b;
        font-size: 1.3rem;
    }

    .inactivity-card p {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 1.25rem;
        line-height: 1.4;
    }

    .timer-display {
        font-size: 2.2rem;
        font-weight: 800;
        color: #e11d48;
        margin-bottom: 1.5rem;
        font-variant-numeric: tabular-nums;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .btn-stay {
        flex: 1;
        background: #00d4aa;
        color: white;
        border: none;
        padding: 0.75rem;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-stay:hover {
        background: #00b894;
    }

    .btn-logout {
        flex: 1;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        padding: 0.75rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-logout:hover {
        background: #e2e8f0;
    }

    @keyframes pulseWarning {
        0% {
            box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.2);
        }
        70% {
            box-shadow: 0 0 0 15px rgba(225, 29, 72, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(225, 29, 72, 0);
        }
    }
    @media (max-width: 768px) {
        .session-manager-bar {
            top: calc(var(--nav-header) - 15%);
        }
    }
</style>
