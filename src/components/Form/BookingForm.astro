---
import type { BlockedDate } from "../../lib/blockedDates";

interface Props {
    whatsappNumber: string;
    blockedDates?: BlockedDate[];
    bookingTimeBlocks?: Array<{
        id: string;
        block_date: string;
        start_time: string;
        end_time: string;
        reason?: string | null;
    }>;
}

const { whatsappNumber, blockedDates = [], bookingTimeBlocks = [] } = Astro.props;
const blockedDatesJson = JSON.stringify(blockedDates);
const bookingTimeBlocksJson = JSON.stringify(bookingTimeBlocks);
---

<section class="form-card" aria-labelledby="booking-title">
    <header class="form-card__header">
        <p class="form-kicker">Planning a group visit?</p>
        <h2 id="booking-title">Booking Request</h2>
        <p>
            Group bookings start at 10 people. Submit your details and we’ll
            open WhatsApp with the request ready to send.
        </p>
    </header>

    <form
        class="contact-form"
        data-booking-form
        data-whatsapp-number={whatsappNumber}
        data-blocked-dates={blockedDatesJson}
        data-booking-time-blocks={bookingTimeBlocksJson}
        novalidate
    >
        <div class="form-grid form-grid--two">
            <div class="form-field">
                <label for="booking-people">
                    Number of people <span aria-hidden="true">*</span>
                </label>
                <input
                    id="booking-people"
                    name="peopleCount"
                    type="number"
                    min="10"
                    step="1"
                    inputmode="numeric"
                    required
                />
                <p class="field-hint">Minimum 10 people.</p>
                <p
                    class="field-error"
                    data-error-for="peopleCount"
                    role="alert"
                ></p>
            </div>

            <div class="form-field">
                <label for="booking-contact-name">
                    Name of person making the booking
                    <span aria-hidden="true">*</span>
                </label>
                <input
                    id="booking-contact-name"
                    name="contactName"
                    type="text"
                    autocomplete="name"
                    maxlength="80"
                    required
                />
                <p
                    class="field-error"
                    data-error-for="contactName"
                    role="alert"
                ></p>
            </div>
        </div>

        <div class="form-field">
            <label for="booking-name">Name for the booking</label>
            <input
                id="booking-name"
                name="bookingName"
                type="text"
                maxlength="100"
                placeholder="Leave blank if the same as the contact name"
            />
            <p class="field-hint">
                Optional. Leave blank when it should use the contact name.
            </p>
            <p
                class="field-error"
                data-error-for="bookingName"
                role="alert"
            ></p>
        </div>

        <div class="form-field">
            <label for="booking-phone">
                Contact phone number <span aria-hidden="true">*</span>
            </label>
            <input
                id="booking-phone"
                name="contactPhone"
                type="tel"
                autocomplete="tel"
                inputmode="tel"
                maxlength="30"
                placeholder="082 555 0142"
                required
            />
            <p
                class="field-error"
                data-error-for="contactPhone"
                role="alert"
            ></p>
        </div>

        <div class="form-field collection-field">
            <label for="booking-date-trigger">
                Date of booking <span aria-hidden="true">*</span>
            </label>
            <input type="hidden" name="bookingDate" data-booking-date-input />
            <button
                id="booking-date-trigger"
                type="button"
                class="collection-trigger"
                data-booking-date-trigger
                aria-haspopup="dialog"
                aria-controls="booking-date-picker"
                aria-expanded="false"
            >
                <span class="collection-trigger-copy">
                    <span class="collection-trigger-label">Booking date</span>
                    <strong data-booking-date-label>Choose a booking date</strong>
                </span>
                <span class="collection-trigger-arrow" aria-hidden="true">›</span>
            </button>
            <p class="field-hint" data-availability-hint></p>
            <p
                class="field-error"
                data-error-for="bookingDate"
                role="alert"
            ></p>
        </div>

        <div class="form-field collection-field">
            <label for="booking-time-trigger">
                Start time <span class="optional-tag">(optional)</span>
            </label>
            <input type="hidden" name="bookingTime" data-booking-time-input />
            <button
                id="booking-time-trigger"
                type="button"
                class="collection-trigger is-disabled"
                data-booking-time-trigger
                aria-haspopup="dialog"
                aria-controls="booking-date-picker"
                aria-expanded="false"
                aria-disabled="true"
            >
                <span class="collection-trigger-copy">
                    <span class="collection-trigger-label">Start time</span>
                    <strong data-booking-time-label>Choose a date first</strong>
                </span>
                <span class="collection-trigger-arrow" aria-hidden="true">›</span>
            </button>
            <button type="button" class="field-clear" data-booking-time-clear hidden>
                Clear start time
            </button>
            <p
                class="field-error"
                data-error-for="bookingTime"
                role="alert"
            ></p>
        </div>

        <div class="form-field collection-field">
            <label for="booking-end-trigger">
                Finish time <span class="optional-tag">(optional)</span>
            </label>
            <input type="hidden" name="bookingEndTime" data-booking-end-input />
            <button
                id="booking-end-trigger"
                type="button"
                class="collection-trigger is-disabled"
                data-booking-end-trigger
                aria-haspopup="dialog"
                aria-controls="booking-date-picker"
                aria-expanded="false"
                aria-disabled="true"
            >
                <span class="collection-trigger-copy">
                    <span class="collection-trigger-label">Finish time</span>
                    <strong data-booking-end-label>Choose a date first</strong>
                </span>
                <span class="collection-trigger-arrow" aria-hidden="true">›</span>
            </button>
            <button type="button" class="field-clear" data-booking-end-clear hidden>
                Clear finish time
            </button>
            <p class="field-hint">
                Times are optional. Monday–Saturday, 10:30–19:30. If you only choose a finish time, we'll use it as the booking time.
            </p>
            <p
                class="field-error"
                data-error-for="bookingEndTime"
                role="alert"
            ></p>
        </div>

        <p class="form-status" data-form-status role="status" aria-live="polite"></p>

        <button type="submit" class="form-submit" data-submit>
            Request Booking via WhatsApp
        </button>
    </form>

    <div
        id="booking-date-picker"
        class="collection-picker-overlay"
        data-booking-picker
        hidden
        aria-hidden="true"
    >
        <div
            class="collection-picker"
            role="dialog"
            aria-modal="true"
            aria-labelledby="booking-picker-title"
            tabindex="-1"
            data-booking-picker-panel
        >
            <div data-booking-picker-date-view>
                <div class="collection-picker-head">
                    <button
                        type="button"
                        class="picker-nav-btn"
                        data-booking-prev-month
                        aria-label="Previous month"
                    >‹</button>
                    <strong id="booking-picker-title" data-booking-month-label></strong>
                    <button
                        type="button"
                        class="picker-nav-btn"
                        data-booking-next-month
                        aria-label="Next month"
                    >›</button>
                </div>

                <div class="calendar-weekdays" aria-hidden="true">
                    <span>Mon</span>
                    <span>Tue</span>
                    <span>Wed</span>
                    <span>Thu</span>
                    <span>Fri</span>
                    <span>Sat</span>
                    <span>Sun</span>
                </div>

                <div class="calendar-grid" data-booking-calendar></div>

                <div class="calendar-legend" aria-label="Calendar availability legend">
                    <span class="calendar-legend-item">
                        <span class="calendar-legend-swatch calendar-legend-swatch--blocked" aria-hidden="true">×</span>
                        Blocked date
                    </span>
                    <span class="calendar-legend-item">
                        <span class="calendar-legend-swatch calendar-legend-swatch--today" aria-hidden="true"></span>
                        Today
                    </span>
                </div>

                <p class="picker-note">
                    Blocked dates are unavailable for group bookings. Dates are checked again when you submit.
                </p>

                <div class="picker-actions">
                    <button type="button" class="cancel-btn" data-booking-picker-close>
                        Close
                    </button>
                </div>
            </div>

            <div data-booking-picker-time-view hidden>
                <div class="collection-picker-head collection-picker-head--time">
                    <button type="button" class="picker-back" data-booking-time-back>‹ Date</button>
                    <strong id="booking-picker-time-title" data-booking-time-title>Start time</strong>
                    <span class="picker-head-spacer" aria-hidden="true"></span>
                </div>
                <p class="selected-date-summary" data-booking-time-date></p>
                <div class="time-options" data-booking-time-options></div>
                <p class="picker-note" data-booking-time-note></p>
                <div class="picker-actions">
                    <button type="button" class="cancel-btn" data-booking-picker-close>
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!--
        "Only a finish time" prompt. Shown on submit when a finish time was
        entered without a start time. Reuses the picker's overlay/panel classes;
        its see-through backdrop is controlled by --finish-only-overlay-opacity
        in the <style> block below.
    -->
    <div
        class="collection-picker-overlay finish-only-overlay"
        data-finish-only
        hidden
        aria-hidden="true"
    >
        <div
            class="collection-picker finish-only-dialog"
            role="alertdialog"
            aria-modal="true"
            aria-labelledby="finish-only-title"
            aria-describedby="finish-only-text"
            tabindex="-1"
            data-finish-only-panel
        >
            <h3 id="finish-only-title" class="finish-only-title">Only a finish time was entered</h3>
            <p id="finish-only-text" class="finish-only-text">
                You've chosen a finish time of <strong data-finish-only-time></strong>
                but no start time. What would you like to do?
            </p>
            <div class="finish-only-actions">
                <button type="button" class="form-submit" data-finish-only-use>
                    Use <span data-finish-only-time></span> as my start time
                </button>
                <button type="button" class="cancel-btn" data-finish-only-both>
                    Set a start and finish time
                </button>
                <button type="button" class="cancel-btn" data-finish-only-start>
                    Set a start time only
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    import { normaliseWhatsAppNumber } from "../../lib/phone";

    const forms = document.querySelectorAll<HTMLFormElement>("[data-booking-form]");

    forms.forEach((form) => {
        if (form.dataset.bound === "true") return;
        form.dataset.bound = "true";

        const component = form.closest<HTMLElement>(".form-card") ?? form.parentElement ?? form;

        const status = form.querySelector<HTMLElement>("[data-form-status]")!;
        const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
        const dateInput = form.querySelector<HTMLInputElement>("[data-booking-date-input]")!;
        const timeInput = form.querySelector<HTMLInputElement>("[data-booking-time-input]")!;
        const dateTrigger = form.querySelector<HTMLButtonElement>("[data-booking-date-trigger]")!;
        const timeTrigger = form.querySelector<HTMLButtonElement>("[data-booking-time-trigger]")!;
        const dateLabel = form.querySelector<HTMLElement>("[data-booking-date-label]")!;
        const timeLabel = form.querySelector<HTMLElement>("[data-booking-time-label]")!;
        const availabilityHint = form.querySelector<HTMLElement>("[data-availability-hint]")!;
        // Optional finish time (second hidden input + trigger) and the clear buttons.
        const endInput = form.querySelector<HTMLInputElement>("[data-booking-end-input]")!;
        const endTrigger = form.querySelector<HTMLButtonElement>("[data-booking-end-trigger]")!;
        const endLabel = form.querySelector<HTMLElement>("[data-booking-end-label]")!;
        const timeClear = form.querySelector<HTMLButtonElement>("[data-booking-time-clear]")!;
        const endClear = form.querySelector<HTMLButtonElement>("[data-booking-end-clear]")!;

        // The picker is rendered alongside the form (not inside the <form>),
        // so picker elements must be queried from the component root.
        const picker = component.querySelector<HTMLElement>("[data-booking-picker]");
        const pickerPanel = component.querySelector<HTMLElement>("[data-booking-picker-panel]");
        const dateView = component.querySelector<HTMLElement>("[data-booking-picker-date-view]");
        const timeView = component.querySelector<HTMLElement>("[data-booking-picker-time-view]");
        const monthLabel = component.querySelector<HTMLElement>("[data-booking-month-label]");
        const calendar = component.querySelector<HTMLElement>("[data-booking-calendar]");
        const timeOptions = component.querySelector<HTMLElement>("[data-booking-time-options]");
        const timeDate = component.querySelector<HTMLElement>("[data-booking-time-date]");
        const timeNote = component.querySelector<HTMLElement>("[data-booking-time-note]");
        const timeTitle = component.querySelector<HTMLElement>("[data-booking-time-title]");

        if (!picker || !pickerPanel || !dateView || !timeView || !monthLabel || !calendar || !timeOptions || !timeDate || !timeNote) {
            console.error("[BookingForm] Date/time picker markup could not be found.");
            return;
        }
        picker.setAttribute("inert", "");

        // ── "Only a finish time" prompt ───────────────────────────
        const finishOnly = component.querySelector<HTMLElement>("[data-finish-only]")!;
        const finishOnlyPanel = component.querySelector<HTMLElement>("[data-finish-only-panel]")!;
        finishOnly.setAttribute("inert", "");

        type FinishOnlyChoice = "use" | "both" | "start" | "cancel";

        // Opens the prompt and resolves with the button the customer pressed
        // ("cancel" for Escape or a click on the dimmed backdrop).
        const askFinishOnly = (time: string) =>
            new Promise<FinishOnlyChoice>((resolve) => {
                finishOnly.querySelectorAll<HTMLElement>("[data-finish-only-time]").forEach((el) => {
                    el.textContent = time;
                });

                const finish = (choice: FinishOnlyChoice) => {
                    finishOnly.setAttribute("aria-hidden", "true");
                    finishOnly.setAttribute("inert", "");
                    finishOnly.hidden = true;
                    finishOnly.removeEventListener("click", onClick);
                    document.removeEventListener("keydown", onKey);
                    resolve(choice);
                };
                const onClick = (event: Event) => {
                    const target = event.target as HTMLElement;
                    if (target === finishOnly) return finish("cancel");
                    if (target.closest("[data-finish-only-use]")) return finish("use");
                    if (target.closest("[data-finish-only-both]")) return finish("both");
                    if (target.closest("[data-finish-only-start]")) return finish("start");
                };
                const onKey = (event: KeyboardEvent) => {
                    if (event.key === "Escape") finish("cancel");
                };

                finishOnly.addEventListener("click", onClick);
                document.addEventListener("keydown", onKey);
                finishOnly.hidden = false;
                finishOnly.removeAttribute("inert");
                finishOnly.setAttribute("aria-hidden", "false");
                window.requestAnimationFrame(() => finishOnlyPanel.focus());
            });
        const blocks = JSON.parse(form.dataset.blockedDates || "[]") as Array<{
            id: string;
            start_date: string;
            end_date: string;
            reason?: string | null;
        }>;

        const timeBlocks = JSON.parse(form.dataset.bookingTimeBlocks || "[]") as Array<{
            id: string;
            block_date: string;
            start_time: string;
            end_time: string;
            reason?: string | null;
        }>;

        let calendarMonth = new Date();
        calendarMonth.setDate(1);
        let pickerMode: "date" | "time" = "date";
        // Which time the shared time picker is currently choosing.
        let timeTarget: "start" | "end" = "start";

        const todayLocalIso = () => {
            const parts = new Intl.DateTimeFormat("en-CA", {
                timeZone: "Africa/Johannesburg",
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
            }).formatToParts(new Date());
            const year = parts.find((part) => part.type === "year")?.value;
            const month = parts.find((part) => part.type === "month")?.value;
            const day = parts.find((part) => part.type === "day")?.value;
            return `${year}-${month}-${day}`;
        };

        const parseIsoDate = (iso: string) => {
            const [year, month, day] = iso.split("-").map(Number);
            return new Date(year, month - 1, day);
        };

        const localIso = (date: Date) => {
            const pad = (value: number) => String(value).padStart(2, "0");
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
        };

        const formatDate = (iso: string, options: Intl.DateTimeFormatOptions = {}) =>
            new Intl.DateTimeFormat("en-ZA", {
                weekday: "short",
                day: "numeric",
                month: "long",
                year: "numeric",
                ...options,
            }).format(parseIsoDate(iso));

        const formatBlock = (block: { start_date: string; end_date: string; reason?: string | null }) => {
            const range =
                block.start_date === block.end_date
                    ? formatDate(block.start_date)
                    : `${formatDate(block.start_date)} – ${formatDate(block.end_date)}`;
            return block.reason ? `${range} (${block.reason})` : range;
        };

        const getBlock = (iso: string) =>
            blocks.find((block) => block.start_date <= iso && block.end_date >= iso);

        const isSunday = (iso: string) => parseIsoDate(iso).getDay() === 0;

        const getTimeRange = (iso: string) => {
            if (!iso) return null;
            if (isSunday(iso)) return null;
            return { earliest: "10:30", latest: "19:30" };
        };

        const getAllTimeOptions = (iso: string) => {
            const range = getTimeRange(iso);
            if (!range) return [];
            const result: string[] = [];
            for (let hour = 10; hour <= 19; hour++) {
                for (const minute of [0, 30]) {
                    const value = `${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}`;
                    if (value >= range.earliest && value <= range.latest) result.push(value);
                }
            }
            return result;
        };

        const normaliseBlockTime = (value: string) => String(value || "").slice(0, 5);

        const getTimeBlock = (iso: string, time: string) =>
            timeBlocks.find((block) =>
                block.block_date === iso &&
                normaliseBlockTime(block.start_time) <= time &&
                normaliseBlockTime(block.end_time) > time,
            );

        const getTimeOptions = (iso: string) =>
            getAllTimeOptions(iso).filter((time) => !getTimeBlock(iso, time));

        const hasAvailableTimes = (iso: string) => getTimeOptions(iso).length > 0;

        // A finish time may run to 20:00 when a start time was chosen.
        const LAST_FINISH = "20:00";

        // True when any blocked slot overlaps the period start -> end.
        const getRangeBlock = (iso: string, start: string, end: string) =>
            timeBlocks.find((block) =>
                block.block_date === iso &&
                normaliseBlockTime(block.start_time) < end &&
                normaliseBlockTime(block.end_time) > start,
            );

        // Candidate finish times for the chosen date (and start time, if any).
        const getAllEndOptions = (iso: string) => {
            const start = timeInput.value;
            const base = getAllTimeOptions(iso);
            if (!start) return base; // finish becomes the booking time, so keep it <= 19:30
            return [...base, LAST_FINISH].filter((time) => time > start);
        };

        // Why a finish time cannot be used (null when it is fine).
        const endBlock = (iso: string, time: string) =>
            timeInput.value
                ? getRangeBlock(iso, timeInput.value, time)
                : getTimeBlock(iso, time);

        const setError = (field: string, message = "") => {
            const target = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
            if (target) target.textContent = message;
        };

        const clearErrors = () => {
            ["peopleCount", "contactName", "bookingName", "contactPhone", "bookingDate", "bookingTime", "bookingEndTime"].forEach((field) => setError(field));
            status.textContent = "";
            status.className = "form-status";
        };

        const isDateBlocked = (iso: string) => !!getBlock(iso);
        const isDateUnavailable = (iso: string) =>
            !iso ||
            iso < todayLocalIso() ||
            isDateBlocked(iso) ||
            isSunday(iso) ||
            !hasAvailableTimes(iso);

        const validateDate = () => {
            const value = dateInput.value;
            if (!value) {
                setError("bookingDate", "Please select a booking date.");
                return false;
            }
            const block = getBlock(value);
            if (block) {
                setError("bookingDate", `That date is unavailable${block.reason ? `: ${block.reason}` : "."}`);
                return false;
            }
            if (value < todayLocalIso()) {
                setError("bookingDate", "Please select today or a future date.");
                return false;
            }
            if (isSunday(value)) {
                setError("bookingDate", "Group booking times are currently available Monday to Saturday only.");
                return false;
            }
            setError("bookingDate");
            return true;
        };

        // Both times are optional. When given they must be inside the opening
        // hours, not blocked, and the finish must come after the start.
        const validateTime = () => {
            let ok = true;
            const start = timeInput.value;
            const end = endInput.value;
            setError("bookingTime");
            setError("bookingEndTime");

            if (start) {
                const options = getTimeOptions(dateInput.value);
                if (!options.includes(start)) {
                    const blocked = getTimeBlock(dateInput.value, start);
                    setError(
                        "bookingTime",
                        blocked
                            ? `That time is unavailable${blocked.reason ? `: ${blocked.reason}` : "."}`
                            : "Please choose a time between 10:30 and 19:30, Monday to Saturday.",
                    );
                    ok = false;
                }
            }

            if (end) {
                if (start && end <= start) {
                    setError("bookingEndTime", "The finish time must be after the start time.");
                    ok = false;
                } else if (!getAllEndOptions(dateInput.value).includes(end)) {
                    setError("bookingEndTime", "Please choose a finish time within opening hours.");
                    ok = false;
                } else {
                    const blocked = endBlock(dateInput.value, end);
                    if (blocked) {
                        setError(
                            "bookingEndTime",
                            `That period is unavailable${blocked.reason ? `: ${blocked.reason}` : "."}`,
                        );
                        ok = false;
                    }
                }
            }
            return ok;
        };

        const renderAvailabilityHint = () => {
            const futureBlocks = blocks.filter((block) => block.end_date >= todayLocalIso());
            availabilityHint.textContent = futureBlocks.length
                ? `Blocked: ${futureBlocks.map(formatBlock).join("; ")}`
                : "Blocked dates are unavailable for group bookings.";
        };

        const renderCalendar = () => {
            const year = calendarMonth.getFullYear();
            const month = calendarMonth.getMonth();
            monthLabel.textContent = calendarMonth.toLocaleDateString("en-ZA", {
                month: "long",
                year: "numeric",
            });
            calendar.replaceChildren();

            const first = new Date(year, month, 1);
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const leading = (first.getDay() + 6) % 7;

            for (let i = 0; i < leading; i++) {
                const empty = document.createElement("span");
                empty.className = "calendar-day is-empty";
                empty.setAttribute("aria-hidden", "true");
                calendar.append(empty);
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const date = new Date(year, month, day);
                const iso = localIso(date);
                const block = getBlock(iso);
                const sunday = isSunday(iso);
                const unavailable = isDateUnavailable(iso);
                const button = document.createElement("button");
                button.type = "button";
                button.className = "calendar-day";
                if (iso === todayLocalIso()) button.classList.add("is-today");
                if (iso === dateInput.value) button.classList.add("is-selected");
                if (unavailable) button.classList.add("is-unavailable");
                if (block) button.classList.add("is-blocked");
                if (sunday && !block) button.classList.add("is-booking-closed");
                if (!block && !sunday && !hasAvailableTimes(iso)) button.classList.add("is-time-blocked");
                button.textContent = String(day);
                button.disabled = unavailable;

                const labelParts = [formatDate(iso)];
                if (block) labelParts.push(`Blocked${block.reason ? `: ${block.reason}` : ""}`);
                else if (sunday) labelParts.push("Group bookings unavailable on Sunday");
                else if (!hasAvailableTimes(iso)) labelParts.push("No booking times available");
                if (iso === todayLocalIso()) labelParts.push("Today");
                button.setAttribute("aria-label", labelParts.join(" — "));
                if (block) button.title = block.reason ? `Blocked: ${block.reason}` : "Blocked date";
                else if (sunday) button.title = "Group bookings are currently available Monday to Saturday only";
                else if (!hasAvailableTimes(iso)) button.title = "No booking times are currently available";

                button.addEventListener("click", () => selectDate(iso));
                calendar.append(button);
            }
        };

        const renderTimeOptions = () => {
            timeOptions.replaceChildren();
            const isEnd = timeTarget === "end";
            const selectedValue = isEnd ? endInput.value : timeInput.value;
            if (timeTitle) timeTitle.textContent = isEnd ? "Finish time" : "Start time";
            timeDate.textContent = dateInput.value ? formatDate(dateInput.value) : "Choose a date first";

            if (!dateInput.value) {
                timeNote.textContent = "Choose a booking date first.";
                return;
            }

            if (isSunday(dateInput.value)) {
                timeNote.textContent = "Group booking times are currently available Monday to Saturday only.";
                return;
            }

            timeNote.textContent = isEnd
                ? timeInput.value
                    ? `Choose when you expect to finish (after ${timeInput.value}).`
                    : "No start time chosen, so the finish time will be used as the booking time."
                : "Bookings are available every 30 minutes from 10:30 to 19:30. This is optional.";

            const allOptions = isEnd ? getAllEndOptions(dateInput.value) : getAllTimeOptions(dateInput.value);
            let available = 0;
            allOptions.forEach((time) => {
                const blocked = isEnd ? endBlock(dateInput.value, time) : getTimeBlock(dateInput.value, time);
                if (!blocked) available++;
                const button = document.createElement("button");
                button.type = "button";
                button.className = "time-option";
                if (blocked) button.classList.add("is-blocked");
                if (time === selectedValue) button.classList.add("is-selected");
                button.disabled = Boolean(blocked);
                button.textContent = blocked ? `${time} · Unavailable` : time;
                if (blocked) button.title = blocked.reason ? `Unavailable: ${blocked.reason}` : "Unavailable";
                else button.addEventListener("click", () => selectTime(time));
                timeOptions.append(button);
            });
            if (allOptions.length && available === 0) {
                timeNote.textContent = "No times are available for this date.";
            }
        };

        const openPicker = (mode: "date" | "time", target: "start" | "end" = "start") => {
            if (mode === "time" && !dateInput.value) mode = "date";
            timeTarget = target;
            // Drop a start time that is no longer available (e.g. a new block was added).
            if (mode === "time" && timeInput.value && !getTimeOptions(dateInput.value).includes(timeInput.value)) {
                timeInput.value = "";
            }
            if (dateInput.value && mode === "date") {
                calendarMonth = parseIsoDate(dateInput.value);
                calendarMonth.setDate(1);
            }

            pickerMode = mode;
            dateView.hidden = mode !== "date";
            timeView.hidden = mode !== "time";
            dateTrigger.setAttribute("aria-expanded", mode === "date" ? "true" : "false");
            timeTrigger.setAttribute("aria-expanded", mode === "time" && target === "start" ? "true" : "false");
            endTrigger.setAttribute("aria-expanded", mode === "time" && target === "end" ? "true" : "false");
            pickerPanel.setAttribute(
                "aria-labelledby",
                mode === "date" ? "booking-picker-title" : "booking-picker-time-title",
            );

            // The picker is initially inert/hidden. Make it available before
            // moving focus into the dialog.
            picker.hidden = false;
            picker.removeAttribute("inert");
            picker.setAttribute("aria-hidden", "false");

            if (mode === "date") renderCalendar();
            else renderTimeOptions();
            window.requestAnimationFrame(() => pickerPanel.focus());
        };

        const closePicker = () => {
            // Never hide/aria-hide the picker while one of its controls still
            // has focus. Return focus to the trigger first.
            const activeElement = document.activeElement;
            if (picker.contains(activeElement)) {
                const returnFocus = pickerMode === "time" ? (timeTarget === "end" ? endTrigger : timeTrigger) : dateTrigger;
                returnFocus.focus();
            }

            pickerMode = "date";
            dateView.hidden = false;
            timeView.hidden = true;
            picker.setAttribute("aria-hidden", "true");
            picker.setAttribute("inert", "");
            picker.hidden = true;
            pickerPanel.setAttribute("aria-labelledby", "booking-picker-title");
            dateTrigger.setAttribute("aria-expanded", "false");
            timeTrigger.setAttribute("aria-expanded", "false");
            endTrigger.setAttribute("aria-expanded", "false");
        };

        // Keep the time trigger visibly unavailable until a date exists.
        const updateTimeTrigger = () => {
            const hasDate = !!dateInput.value;
            [timeTrigger, endTrigger].forEach((trigger) => {
                trigger.classList.toggle("is-disabled", !hasDate);
                trigger.setAttribute("aria-disabled", hasDate ? "false" : "true");
            });
            timeLabel.textContent = hasDate ? timeInput.value || "Any time (optional)" : "Choose a date first";
            endLabel.textContent = hasDate ? endInput.value || "Any time (optional)" : "Choose a date first";
            // Show the clear buttons only when there is something to clear.
            timeClear.hidden = !timeInput.value;
            endClear.hidden = !endInput.value;
        };

        const selectDate = (iso: string) => {
            if (isDateUnavailable(iso)) return;
            dateInput.value = iso;
            dateLabel.textContent = formatDate(iso);
            // A new date means the old times may no longer apply.
            timeInput.value = "";
            endInput.value = "";
            updateTimeTrigger();
            validateDate();
            validateTime();
            renderTimeOptions();
            openPicker("time", "start");
        };

        const selectTime = (time: string) => {
            if (timeTarget === "end") {
                if (endBlock(dateInput.value, time) || !getAllEndOptions(dateInput.value).includes(time)) return;
                endInput.value = time;
            } else {
                if (!getTimeOptions(dateInput.value).includes(time)) return;
                timeInput.value = time;
                // A finish time that is not after the new start no longer makes sense.
                if (endInput.value && endInput.value <= time) endInput.value = "";
            }
            updateTimeTrigger();
            validateTime();
            closePicker();
        };

        const changeMonth = (delta: number) => {
            calendarMonth = new Date(
                calendarMonth.getFullYear(),
                calendarMonth.getMonth() + delta,
                1,
            );
            renderCalendar();
        };

        renderAvailabilityHint();
        renderCalendar();
        updateTimeTrigger();

        dateTrigger.addEventListener("click", () => openPicker("date"));
        timeTrigger.addEventListener("click", () => openPicker("time", "start"));
        endTrigger.addEventListener("click", () => openPicker("time", "end"));
        timeClear.addEventListener("click", () => {
            timeInput.value = "";
            updateTimeTrigger();
            validateTime();
        });
        endClear.addEventListener("click", () => {
            endInput.value = "";
            updateTimeTrigger();
            validateTime();
        });
        component.querySelector<HTMLButtonElement>("[data-booking-prev-month]")?.addEventListener("click", () => changeMonth(-1));
        component.querySelector<HTMLButtonElement>("[data-booking-next-month]")?.addEventListener("click", () => changeMonth(1));
        component.querySelectorAll<HTMLButtonElement>("[data-booking-picker-close]").forEach((button) =>
            button.addEventListener("click", closePicker),
        );
        component.querySelector<HTMLButtonElement>("[data-booking-time-back]")?.addEventListener("click", () => openPicker("date"));

        picker.addEventListener("click", (event) => {
            if (event.target === picker) closePicker();
        });

        document.addEventListener("keydown", (event) => {
            if (!picker.hidden && event.key === "Escape") closePicker();
        });

        timeTrigger.addEventListener("click", () => {
            if (!dateInput.value) setError("bookingTime", "Please select a booking date first.");
        });
        endTrigger.addEventListener("click", () => {
            if (!dateInput.value) setError("bookingEndTime", "Please select a booking date first.");
        });

        form.querySelector<HTMLInputElement>("[name='contactPhone']")!.addEventListener("blur", (event) => {
            const input = event.currentTarget as HTMLInputElement;
            if (input.value.trim() && !normaliseWhatsAppNumber(input.value)) {
                setError("contactPhone", "Please enter a valid WhatsApp/mobile number.");
            } else {
                setError("contactPhone");
            }
        });

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            clearErrors();

            const data = new FormData(form);
            const peopleCount = Number(data.get("peopleCount"));
            const contactName = String(data.get("contactName") ?? "").trim();
            const bookingName = String(data.get("bookingName") ?? "").trim();
            const contactPhone = normaliseWhatsAppNumber(data.get("contactPhone"));
            const bookingDate = String(data.get("bookingDate") ?? "").trim();
            let bookingTime = String(data.get("bookingTime") ?? "").trim();
            let bookingEndTime = String(data.get("bookingEndTime") ?? "").trim();

            let valid = true;
            if (!Number.isInteger(peopleCount) || peopleCount < 10) {
                setError("peopleCount", "Bookings require a minimum of 10 people.");
                valid = false;
            }
            if (!contactName) {
                setError("contactName", "Please enter the name of the person making the booking.");
                valid = false;
            }
            if (!contactPhone) {
                setError("contactPhone", "Please enter a valid WhatsApp/mobile number.");
                valid = false;
            }
            if (!validateDate()) valid = false;
            if (!validateTime()) valid = false;
            if (!valid) return;

            // Finish time but no start time: ask the customer what they meant
            // instead of guessing.
            if (!bookingTime && bookingEndTime) {
                const choice = await askFinishOnly(bookingEndTime);
                if (choice === "cancel") return;
                if (choice === "both") {
                    // Keep the finish time and let them pick a start time.
                    openPicker("time", "start");
                    return;
                }
                if (choice === "start") {
                    // Drop the finish time and let them pick a start time.
                    endInput.value = "";
                    updateTimeTrigger();
                    openPicker("time", "start");
                    return;
                }
                // "use": the finish time becomes the booking (start) time.
                bookingTime = bookingEndTime;
                bookingEndTime = "";
            }

            submit.disabled = true;
            submit.setAttribute("aria-busy", "true");
            status.textContent = "Checking availability…";

            try {
                const response = await fetch("/api/booking", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        peopleCount,
                        contactName,
                        bookingName,
                        contactPhone,
                        bookingDate,
                        bookingTime,
                        bookingEndTime,
                    }),
                });
                const result = await response.json().catch(() => ({}));

                if (response.ok && result.ok && result.whatsappUrl) {
                    window.location.href = result.whatsappUrl;
                    return;
                }

                if (result.error === "minimum_people") {
                    setError("peopleCount", "Bookings require a minimum of 10 people.");
                    return;
                }
                if (result.error === "invalid_phone") {
                    setError("contactPhone", "Please enter a valid WhatsApp/mobile number.");
                    return;
                }
                if (result.error === "date_blocked") {
                    setError("bookingDate", "That date has just become unavailable. Please choose another date.");
                    return;
                }
                if (result.error === "past_date") {
                    setError("bookingDate", "Please select today or a future date.");
                    return;
                }
                if (result.error === "invalid_time") {
                    setError(
                        "bookingTime",
                        `Please choose a time between 10:30 and ${result.latest || "19:30"}, or leave it blank.`,
                    );
                    return;
                }
                if (result.error === "invalid_end_time") {
                    setError("bookingEndTime", "The finish time must be after the start time and within opening hours.");
                    return;
                }
                if (result.error === "time_blocked") {
                    setError(
                        "bookingTime",
                        result.reason ? `That time is unavailable: ${result.reason}` : "That time has just become unavailable. Please choose another time.",
                    );
                    renderTimeOptions();
                    return;
                }
                if (result.error === "sunday_unavailable") {
                    setError("bookingDate", "Group booking times are currently available Monday to Saturday only.");
                    return;
                }
                if (result.error === "rate_limited") {
                    status.textContent = "Too many booking requests in a short time. Please wait a few minutes and try again.";
                    status.className = "form-status form-status--error";
                    return;
                }

                throw new Error(result.error || `HTTP ${response.status}`);
            } catch (error) {
                console.error("[BookingForm] request failed", error);
                status.textContent = "We couldn't submit the booking request. Please try again.";
                status.className = "form-status form-status--error";
            } finally {
                submit.disabled = false;
                submit.removeAttribute("aria-busy");
            }
        });

    });
</script>

