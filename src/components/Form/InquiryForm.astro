---
interface Props {
    whatsappNumber: string;
}

const { whatsappNumber } = Astro.props;
---

<section class="form-card" aria-labelledby="inquiry-title">
    <header class="form-card__header">
        <p class="form-kicker">Have a question?</p>
        <h2 id="inquiry-title">General Enquiry</h2>
        <p>
            Send us your question and we’ll open WhatsApp with your message
            ready to send.
        </p>
    </header>

    <form
        class="contact-form"
        data-inquiry-form
        data-whatsapp-number={whatsappNumber}
        novalidate
    >
        <div class="form-field">
            <label for="inquiry-name">Name <span aria-hidden="true">*</span></label>
            <input
                id="inquiry-name"
                name="name"
                type="text"
                autocomplete="name"
                maxlength="80"
                required
            />
            <p class="field-error" data-error-for="name" role="alert"></p>
        </div>

        <div class="form-field">
            <label for="inquiry-phone"
                >Contact phone number <span aria-hidden="true">*</span></label
            >
            <input
                id="inquiry-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                inputmode="tel"
                maxlength="30"
                placeholder="082 555 0142"
                required
            />
            <p class="field-hint">South African mobile numbers are accepted in local or international format.</p>
            <p class="field-error" data-error-for="phone" role="alert"></p>
        </div>

        <div class="form-field">
            <label for="inquiry-message">Message <span aria-hidden="true">*</span></label>
            <textarea
                id="inquiry-message"
                name="message"
                rows="7"
                maxlength="2000"
                required
            ></textarea>
            <p class="field-error" data-error-for="message" role="alert"></p>
        </div>

        <p class="form-status" data-form-status role="status" aria-live="polite"></p>

        <button type="submit" class="form-submit" data-submit>
            Send via WhatsApp
        </button>
    </form>
</section>

<script>
    import { normaliseWhatsAppNumber } from "../../lib/phone";

    const forms = document.querySelectorAll<HTMLFormElement>("[data-inquiry-form]");

    forms.forEach((form) => {
        if (form.dataset.bound === "true") return;
        form.dataset.bound = "true";

        const status = form.querySelector<HTMLElement>("[data-form-status]")!;
        const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
        const phoneInput = form.querySelector<HTMLInputElement>("[name='phone']")!;
        const whatsappNumber = form.dataset.whatsappNumber || "";

        const setError = (field: string, message = "") => {
            const target = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
            if (target) target.textContent = message;
        };

        const clearErrors = () => {
            ["name", "phone", "message"].forEach((field) => setError(field));
            status.textContent = "";
            status.className = "form-status";
        };

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            clearErrors();

            const data = new FormData(form);
            const name = String(data.get("name") ?? "").trim();
            const phone = normaliseWhatsAppNumber(data.get("phone"));
            const message = String(data.get("message") ?? "").trim();

            let valid = true;
            if (!name) {
                setError("name", "Please enter your name.");
                valid = false;
            }
            if (!phone) {
                setError("phone", "Please enter a valid WhatsApp/mobile number.");
                valid = false;
            }
            if (!message) {
                setError("message", "Please enter a message.");
                valid = false;
            }
            if (!valid) return;

            submit.disabled = true;
            submit.setAttribute("aria-busy", "true");
            status.textContent = "Preparing WhatsApp…";

            const fallbackMessage = [
                "GENERAL INQUIRY - Lords & Legends",
                "",
                `Name: ${name}`,
                `Phone: ${phone}`,
                "",
                "Message:",
                message,
            ].join("\n");
            const fallbackUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(fallbackMessage)}`;

            try {
                const response = await fetch("/api/inquiry", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin",
                    body: JSON.stringify({ name, phone, message }),
                });
                const result = await response.json().catch(() => ({}));

                if (response.ok && result.ok && result.whatsappUrl) {
                    window.location.href = result.whatsappUrl;
                    return;
                }

                if (result.error === "invalid_phone") {
                    setError("phone", "Please enter a valid WhatsApp/mobile number.");
                    return;
                }
                if (result.error === "rate_limited") {
                    status.textContent = "Too many enquiries in a short time. Please wait a few minutes and try again.";
                    status.className = "form-status form-status--error";
                    return;
                }

                throw new Error(result.error || `HTTP ${response.status}`);
            } catch (error) {
                console.warn("[InquiryForm] save failed; using WhatsApp fallback", error);
                status.textContent = "We couldn't save the enquiry, but you can still send it via WhatsApp.";
                status.className = "form-status form-status--error";
                setTimeout(() => {
                    window.location.href = fallbackUrl;
                }, 1200);
            } finally {
                submit.disabled = false;
                submit.removeAttribute("aria-busy");
            }
        });

        phoneInput.addEventListener("blur", () => {
            if (phoneInput.value.trim() && !normaliseWhatsAppNumber(phoneInput.value)) {
                setError("phone", "Please enter a valid WhatsApp/mobile number.");
            } else {
                setError("phone");
            }
        });
    });
</script>

<style lang="scss">
    .form-card {
        background: color-mix(in srgb, var(--text-color-dark) 92%, white);
        border: 1px solid var(--nav-bg);
        border-radius: 16px;
        padding: clamp(1.25rem, 4vw, 2rem);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
    }

    .form-card__header {
        margin-bottom: 1.5rem;

        .form-kicker {
            margin: 0 0 0.25rem;
            color: var(--text-color-hover);
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-size: 0.78rem;
        }

        h2 {
            margin: 0;
            color: var(--bg-color-btn);
            font-size: clamp(1.5rem, 4vw, 2rem);
        }

        h2::after {
            content: "";
            display: block;
            width: 3.25rem;
            height: 3px;
            margin-top: 0.6rem;
            border-radius: 2px;
            background: var(--MenuColor);
        }

        > p:last-child {
            margin: 0.9rem 0 0;
            line-height: 1.6;
            color: var(--txt-color);
        }
    }

    .contact-form {
        display: grid;
        gap: 1.15rem;
    }

    .form-field {
        display: grid;
        gap: 0.45rem;
    }

    .form-field label {
        font-weight: 700;
        color: var(--txt-color);
    }

    .form-field label span {
        color: var(--bg-color-btn);
    }

    input,
    textarea {
        width: 100%;
        box-sizing: border-box;
        border: 2px solid var(--nav-bg);
        border-radius: 10px;
        padding: 0.75rem 0.85rem;
        background: #fff;
        color: var(--txt-color);
        font: inherit;
        transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }

    textarea {
        resize: vertical;
        min-height: 9rem;
    }

    input:focus,
    textarea:focus {
        outline: none;
        border-color: var(--MenuColor);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--MenuColor) 18%, transparent);
    }

    .field-hint,
    .field-error,
    .form-status {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.45;
    }

    .field-hint {
        color: color-mix(in srgb, var(--txt-color) 70%, transparent);
    }

    .field-error {
        color: #a63b2f;
        min-height: 1.15em;
    }

    .form-status {
        min-height: 1.25em;
        color: var(--txt-color);
    }

    .form-status--error {
        padding: 0.7rem 0.8rem;
        border: 1px solid #e8b4ad;
        border-radius: 8px;
        background: #fff5f3;
        color: #8f3026;
    }

    .form-submit {
        min-height: 48px;
        border: 0;
        border-radius: 8px;
        padding: 0.75rem 1.25rem;
        background: var(--bg-color-btn);
        color: var(--text-color-dark);
        font: inherit;
        font-weight: 800;
        cursor: pointer;
        transition: background-color 0.18s ease, transform 0.18s ease;
    }

    .form-submit:hover:not(:disabled),
    .form-submit:focus-visible:not(:disabled) {
        background: var(--text-color-hover);
        transform: translateY(-1px);
    }

    .form-submit:disabled {
        cursor: wait;
        opacity: 0.65;
    }
</style>
