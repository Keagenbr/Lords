---
// Navigation.astro - Responsive Navigation with Animated Hamburger Menu
// Place in: src/components/Navigation.astro
//

import LogoSrcMobile from "../../src/assets/L&LmobileLogo.svg";
import LogoSrcDesktop from "../../src/assets/LordsLogo.svg";

interface Props {
    logoSrc?: string;
    logoAlt?: string;
}

// const {
//     logoSrcDesktop = "../../src/assets/LordsLogo.png",
//     logoAlt = "Restaurant Logo",
// } = Astro.props;

const navItems = [
    { label: "Home", href: "/", icon: "home" },
    { label: "Menu", href: "/menu", icon: "menu" },
    { label: "Contact", href: "/contact", icon: "contact" },
    { label: "Staff", href: "/staff", icon: "staff" },
];
---

<style lang="scss">
    /* Header & Navigation Container */

    // .menu-is-open {
    //     overflow: hidden;

    //     .nav-header {
    //         filter: none;
    //     }
    // }

    .nav-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        max-height: var(--nav-header);
        background: var(--nav-bg);
        border-bottom: 1px solid var(--nav-bg-shadow);
        transform: none; // not translateY(0), so fixed children aren't trapped
        transition:
            transform 300ms ease-in-out,
            box-shadow 300ms ease-in-out; // not "all"
        will-change: transform;
        &.nav-hidden {
            transform: translateY(-100%);
        }

        &.nav-scrolled {
            box-shadow: 0 2px 10px var(--nav-bg-shadowA);
        }
    }

    .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Logo */
    .nav-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        z-index: 1001;
    }

    .logo-img {
        height: 6em;
        width: auto;
        object-fit: cover;
        &-mobile {
            display: none;
        }
    }

    /* Desktop Navigation */
    .nav-links-desktop {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        color: var(--txt-color);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9375rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        position: relative;
    }

    .nav-link:hover {
        background: var(--nav-bg-highlight);
        color: var(--text-color-hover);
    }

    .nav-link::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: var(--nav-bg-highlight);
        transition: all 0.3s ease;
        transform: translateX(-50%);
    }

    .nav-link:hover::after {
        width: 60%;
    }

    .lock-icon {
        width: 14px;
        height: 14px;
        opacity: 0.6;
    }

    /* Hamburger Button */
    .hamburger-btn {
        display: none;
        background: none;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
        z-index: 1101;
    }

    .hamburger-lines {
        width: 28px;
        height: 20px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .line {
        display: block;
        width: 100%;
        height: 3px;
        background: var(--ham-color);
        border-radius: 2px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        transform-origin: center;
    }

    .hamburger-lines.open .line {
        background: var(--ham-color-active);
    }

    /* Hamburger Animation */
    .hamburger-lines.open .line-1 {
        transform: translateY(8.5px) rotate(45deg);
    }

    .hamburger-lines.open .line-2 {
        opacity: 0;
        transform: scaleX(0);
    }

    .hamburger-lines.open .line-3 {
        transform: translateY(-8.5px) rotate(-45deg);
    }
    .hamburger-btn.open {
        transform: translateY(50%);
    }

    /* Mobile Menu */
    .mobile-menu {
        display: none;
        position: fixed;
        top: 25%;
        left: 0;
        right: 0;
        z-index: 1100;
        max-height: calc(100vh - 80px);
        overflow-y: auto;
    }

    .mobile-menu-content {
        padding: 1rem;
    }

    .mobile-nav-link {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem 1rem;
        margin-bottom: 0.5rem;
        color: var(--text-color);
        text-decoration: none;
        font-weight: 500;
        font-size: 1.125rem;
        border-radius: 12px;
        transition: all 0.2s ease;
        opacity: 0;
        transform: translateY(-10px);
        animation: slideIn 0.5s ease forwards;
    }

    @keyframes slideIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .mobile-nav-link:hover {
        background: var(--MenuColorA);
        color: var(--text-color-hover);
    }

    .mobile-lock-icon {
        width: 18px;
        height: 18px;
        opacity: 0.5;
    }

    /* Mobile Backdrop */
    .mobile-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        height: 100vh;
        background: var(--MenuColorA);
        z-index: 1000;
    }

    /* Responsive Styles */
    @media (max-width: 768px) {
        .nav-links-desktop {
            display: none;
        }

        .hamburger-btn {
            display: block;
        }

        .mobile-menu {
            display: block;
        }

        .mobile-backdrop {
            display: block;
        }

        .logo-img {
            display: none;
            &-mobile {
                display: block;
                height: 3.5em;
            }
        }

        .nav-container {
            max-height: var(--nav-headerM);
            padding: 0.875rem 1rem;
        }
    }

    /* Add padding to body to account for fixed header */
    :global(body) {
        padding-top: 80px;
    }

    @media (max-width: 768px) {
        :global(body) {
            padding-top: 72px;
        }
    }

    /* For people who prefer reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .nav-header {
            transition: none;
        }
    }
</style>
<div
    id="nav"
    class="nav-header"
    x-data="{
  mobileMenuOpen: false,

  toggleMobileMenu() {
    this.mobileMenuOpen = !this.mobileMenuOpen;
    document.body.style.overflow = this.mobileMenuOpen ? 'hidden' : '';
  },

  closeMobileMenu() {
    this.mobileMenuOpen = false;
    document.body.style.overflow = '';
  },

}"
    @keydown.escape.window="closeMobileMenu()"
>
    <nav class="nav-container">
        <!-- Logo -->
        <a href="/" class="nav-logo" @click="closeMobileMenu()">
            <LogoSrcDesktop class="logo-img" />
            <LogoSrcMobile class="logo-img-mobile" />
        </a>

        <!-- Desktop Navigation -->
        <div class="nav-links-desktop">
            {navItems.map((item) => (
                <a href={item.href} class="nav-link">
                    <span class="nav-link-text">{item.label}</span>
                </a>
            ))}
        </div>

        <!-- Mobile Menu Button (Hamburger) -->
        <button
            class="hamburger-btn"
            @click="toggleMobileMenu()"
            :aria-expanded="mobileMenuOpen"
            aria-label="Toggle menu"
        >
            <div class="hamburger-lines" :class="{ 'open': mobileMenuOpen }">
                <span class="line line-1"></span>
                <span class="line line-2"></span>
                <span class="line line-3"></span>
            </div>
        </button>
    </nav>

    <!-- Mobile Menu Dropdown -->
    <div
        class="mobile-menu"
        :class="{ 'open': mobileMenuOpen }"
        x-show="mobileMenuOpen"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 -translate-y-4"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-4"
    >
        <div class="mobile-menu-content">
            {navItems.map((item, index) => (
                <a
                    href={item.href}
                    class="mobile-nav-link"
                    style={`animation-delay: ${index * 50}ms`}
                >
                    <span class="mobile-nav-link-text">{item.label}</span>
                </a>
            ))}
        </div>
    </div>

    <!-- Backdrop for mobile menu -->
    <div
        class="mobile-backdrop"
        x-show="mobileMenuOpen"
        @click="closeMobileMenu()"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-20"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-20"
        x-transition:leave-end="opacity-0"
    ></div>
</div>
<script>
    const THRESHOLD = 5; // ignore tiny scroll jitters
    let lastY = window.scrollY;
    let ticking = false;

    function update() {
        const nav = document.getElementById("nav");
        ticking = false;
        if (!nav) return;

        const y = Math.max(window.scrollY, 0); // ignore iOS overscroll bounce
        const menuOpen =
            nav
                .querySelector(".hamburger-btn")
                ?.getAttribute("aria-expanded") === "true";

        nav.classList.toggle("nav-scrolled", y > 0);

        if (menuOpen) {
            nav.classList.remove("nav-hidden");
        } else if (Math.abs(y - lastY) > THRESHOLD) {
            const goingDown = y > lastY;
            // only hide once we've scrolled past the nav's own height
            nav.classList.toggle(
                "nav-hidden",
                goingDown && y > nav.offsetHeight,
            );
        }
        lastY = y;
    }

    window.addEventListener(
        "scroll",
        () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        },
        { passive: true },
    );

    update();
</script>
