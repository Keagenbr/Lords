---
import LogoSrcMobile from "../assets/L&LmobileLogo.svg";
import LogoSrcDesktop from "../assets/LordsLogo.svg";

export interface Category {
    id: string;
    label: string;
    type_id: string;
}

export interface Type {
    id: string;
    label: string;
}

interface Props {
    userRole?: "admin" | "owner" | "customer" | string;
    types?: Type[];
    categories?: Category[];
}

const { userRole = "customer", types = [], categories = [] } = Astro.props;
const isAdminOrOwner = userRole === "admin" || userRole === "owner";
---

<div
    id="nav"
    class="nav-header"
    x-data="{
        mobileMenuOpen: false,
        menuDropdownOpen: false,
        typesDropdownOpen: false,
        categoriesDropdownOpen: false,
        activeMobileAccordion: null,
        toggleMobileMenu() {
            this.mobileMenuOpen = !this.mobileMenuOpen;
            document.body.style.overflow = this.mobileMenuOpen ? 'hidden' : '';
        },
        closeMobileMenu() {
            this.mobileMenuOpen = false;
            document.body.style.overflow = '';
        },
        toggleAccordion(name) {
            this.activeMobileAccordion = this.activeMobileAccordion === name ? null : name;
        }
    }"
    @keydown.escape.window="closeMobileMenu()"
>
    <nav class="nav-container">
        <!-- Logo -->
        <a href="/" class="nav-logo" @click="closeMobileMenu()">
            <LogoSrcDesktop class="logo-img" />
            <LogoSrcMobile class="logo-img-mobile" />
        </a>

        <!-- Desktop Navigation Links -->
        <div class="nav-links-desktop">
            <a href="/" class="nav-link">
                <span class="nav-link-text">Home</span>
            </a>

            <!-- Menu Dropdown -->
            <div
                class="nav-item-wrapper"
                @mouseenter="menuDropdownOpen = true"
                @mouseleave="menuDropdownOpen = false"
            >
                <a href="/menu" class="nav-link">
                    <span class="nav-link-text">Menu</span>
                    <i class="fa-solid fa-chevron-down dropdown-arrow"></i>
                </a>

                <div
                    class="nav-dropdown-menu"
                    x-show="menuDropdownOpen"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 translate-y-2 scale-95"
                    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                    x-transition:leave-end="opacity-0 translate-y-2 scale-95"
                    x-cloak
                >
                    <a href="/menu" class="dropdown-item">
                        <i class="fa-solid fa-book-open"></i>
                        <span>View Full Menu</span>
                    </a>

                    {isAdminOrOwner && (
                        <>
                            <div class="dropdown-divider"></div>
                            <a
                                href="/admin/menu-editor"
                                class="dropdown-item editor-link"
                            >
                                <i class="fa-solid fa-pen-to-square"></i>
                                <span>Menu Editor</span>
                                <span class="role-badge">{userRole}</span>
                            </a>
                        </>
                    )}
                </div>
            </div>

            <!-- Types Dropdown -->
            {types.length > 0 && (
                <div
                    class="nav-item-wrapper"
                    @mouseenter="typesDropdownOpen = true"
                    @mouseleave="typesDropdownOpen = false"
                >
                    <button class="nav-link nav-link-btn">
                        <span class="nav-link-text">Types</span>
                        <i class="fa-solid fa-chevron-down dropdown-arrow"></i>
                    </button>

                    <div
                        class="nav-dropdown-menu"
                        x-show="typesDropdownOpen"
                        x-transition:enter="transition ease-out duration-200"
                        x-transition:enter-start="opacity-0 translate-y-2 scale-95"
                        x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                        x-transition:leave="transition ease-in duration-150"
                        x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                        x-transition:leave-end="opacity-0 translate-y-2 scale-95"
                        x-cloak
                    >
                        <div class="dropdown-header">Menu Types</div>
                        <div class="dropdown-list">
                            {types.map((type) => (
                                <a
                                    href={`/menu#type-${type.id}`}
                                    class="dropdown-item"
                                >
                                    <i class="fa-solid fa-layer-group item-icon"></i>
                                    <span>{type.label}</span>
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            )}

            <!-- Categories Dropdown -->
            {categories.length > 0 && (
                <div
                    class="nav-item-wrapper"
                    @mouseenter="categoriesDropdownOpen = true"
                    @mouseleave="categoriesDropdownOpen = false"
                >
                    <button class="nav-link nav-link-btn">
                        <span class="nav-link-text">Categories</span>
                        <i class="fa-solid fa-angles-down dropdown-arrow"></i>
                        <!-- <i class="fa-solid fa-chevron-down dropdown-arrow"></i> -->
                    </button>

                    <div
                        class="nav-dropdown-menu"
                        x-show="categoriesDropdownOpen"
                        x-transition:enter="transition ease-out duration-200"
                        x-transition:enter-start="opacity-0 translate-y-2 scale-95"
                        x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                        x-transition:leave="transition ease-in duration-150"
                        x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                        x-transition:leave-end="opacity-0 translate-y-2 scale-95"
                        x-cloak
                    >
                        <div class="dropdown-header">
                            Food & Drink Categories
                        </div>
                        <div class="dropdown-list scrollable">
                            {categories.map((cat) => (
                                <a
                                    href={`/menu#cat-${cat.id}`}
                                    class="dropdown-item"
                                >
                                    <i class="fa-solid fa-utensils item-icon"></i>
                                    <span>{cat.label.replace(/_/g, " ")}</span>
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            )}

            <a href="/contact" class="nav-link">
                <span class="nav-link-text">Contact</span>
            </a>
        </div>

        <!-- Animated Mobile Hamburger Button -->
        <button
            class="hamburger-btn"
            @click="toggleMobileMenu()"
            :aria-expanded="mobileMenuOpen"
            aria-label="Toggle Navigation Menu"
        >
            <div class="hamburger-lines" :class="{ 'open': mobileMenuOpen }">
                <span class="line line-1"></span>
                <span class="line line-2"></span>
                <span class="line line-3"></span>
            </div>
        </button>
    </nav>

    <!-- Animated Mobile Menu Drawer -->
    <div
        class="mobile-menu"
        x-show="mobileMenuOpen"
        x-transition:enter="transition cubic-bezier(0.16, 1, 0.3, 1) duration-300"
        x-transition:enter-start="opacity-0 -translate-y-6 scale-98"
        x-transition:enter-end="opacity-100 translate-y-0 scale-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100 translate-y-0 scale-100"
        x-transition:leave-end="opacity-0 -translate-y-4 scale-98"
        x-cloak
    >
        <div class="mobile-menu-inner">
            <a href="/" class="mobile-nav-item" @click="closeMobileMenu()">
                <i class="fa-solid fa-house"></i>
                <span>Home</span>
            </a>

            <!-- Menu Accordion Section -->
            <div class="mobile-accordion-card">
                <button
                    class="accordion-trigger"
                    @click="toggleAccordion('menu')"
                    :class="{ 'is-active': activeMobileAccordion === 'menu' }"
                >
                    <span class="trigger-title">
                        <i class="fa-solid fa-book-open"></i> Menu Options
                    </span>
                    <i
                        class="fa-solid fa-chevron-down accordion-arrow"
                        :class="{ 'rotate': activeMobileAccordion === 'menu' }"
                    ></i>
                </button>
                <div
                    class="accordion-panel"
                    x-show="activeMobileAccordion === 'menu'"
                    x-collapse
                >
                    <div class="panel-content">
                        <a
                            href="/menu"
                            class="mobile-sub-link"
                            @click="closeMobileMenu()"
                        >
                            <i class="fa-solid fa-utensils"></i> View Full Menu
                        </a>
                        {isAdminOrOwner && (
                            <a
                                href="/admin/menu-editor"
                                class="mobile-sub-link editor-highlight"
                                @click="closeMobileMenu()"
                            >
                                <i class="fa-solid fa-pen-to-square"></i> Menu
                                Editor ({userRole})
                            </a>
                        )}
                    </div>
                </div>
            </div>

            <!-- Types Accordion Section -->
            {types.length > 0 && (
                <div class="mobile-accordion-card">
                    <button
                        class="accordion-trigger"
                        @click="toggleAccordion('types')"
                        :class="{ 'is-active': activeMobileAccordion === 'types' }"
                    >
                        <span class="trigger-title">
                            <i class="fa-solid fa-layer-group"></i> Types
                        </span>
                        <i
                            class="fa-solid fa-chevron-down accordion-arrow"
                            :class="{ 'rotate': activeMobileAccordion === 'types' }"
                        ></i>
                    </button>
                    <div
                        class="accordion-panel"
                        x-show="activeMobileAccordion === 'types'"
                        x-collapse
                    >
                        <div class="chip-grid">
                            {types.map((type) => (
                                <a
                                    href={`/menu#type-${type.id}`}
                                    class="mobile-chip"
                                    @click="closeMobileMenu()"
                                >
                                    {type.label}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            )}

            <!-- Categories Accordion Section -->
            {categories.length > 0 && (
                <div class="mobile-accordion-card">
                    <button
                        class="accordion-trigger"
                        @click="toggleAccordion('categories')"
                        :class="{ 'is-active': activeMobileAccordion === 'categories' }"
                    >
                        <span class="trigger-title">
                            <i class="fa-solid fa-list"></i> Categories
                        </span>
                        <i
                            class="fa-solid fa-chevron-down accordion-arrow"
                            :class="{ 'rotate': activeMobileAccordion === 'categories' }"
                        ></i>
                    </button>
                    <div
                        class="accordion-panel"
                        x-show="activeMobileAccordion === 'categories'"
                        x-collapse
                    >
                        <div class="chip-grid">
                            {categories.map((cat) => (
                                <a
                                    href={`/menu#cat-${cat.id}`}
                                    class="mobile-chip"
                                    @click="closeMobileMenu()"
                                >
                                    {cat.label.replace(/_/g, " ")}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            )}

            <a
                href="/contact"
                class="mobile-nav-item"
                @click="closeMobileMenu()"
            >
                <i class="fa-solid fa-envelope"></i>
                <span>Contact</span>
            </a>
        </div>
    </div>

    <!-- Mobile Backdrop -->
    <div
        class="mobile-backdrop"
        x-show="mobileMenuOpen"
        @click="closeMobileMenu()"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        x-cloak
    ></div>
</div>

<script>
    const THRESHOLD = 5;
    let lastY = window.scrollY;
    let ticking = false;

    function update() {
        const nav = document.getElementById("nav");
        ticking = false;
        if (!nav) return;

        const y = Math.max(window.scrollY, 0);
        const menuOpen =
            nav
                .querySelector(".hamburger-btn")
                ?.getAttribute("aria-expanded") === "true";

        nav.classList.toggle("nav-scrolled", y > 0);

        if (menuOpen) {
            nav.classList.remove("nav-hidden");
        } else if (Math.abs(y - lastY) > THRESHOLD) {
            const goingDown = y > lastY;
            nav.classList.toggle(
                "nav-hidden",
                goingDown && y > nav.offsetHeight,
            );
        }
        lastY = y;
    }

    window.addEventListener(
        "scroll",
        () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        },
        { passive: true },
    );

    update();
</script>

<style lang="scss">
    [x-cloak] {
        display: none !important;
    }

    .nav-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        height: var(--nav-header);
        background: var(--nav-bg);
        border-bottom: 1px solid var(--nav-bg-shadowA);
        transition:
            transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
            box-shadow 300ms ease;

        &.nav-hidden {
            transform: translateY(-100%);
        }

        &.nav-scrolled {
            box-shadow: 0 4px 20px var(--nav-bg-shadowA);
        }
    }

    .nav-container {
        max-width: 1200px;
        height: 100%;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .nav-logo {
        display: flex;
        align-items: center;
        z-index: 1101;
    }

    .logo-img {
        height: 4.5em;
        width: auto;
        object-fit: contain;
        transition: transform 0.2s ease;

        &:hover {
            transform: scale(1.02);
        }

        &-mobile {
            display: none;
        }
    }

    .nav-links-desktop {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .nav-item-wrapper {
        position: relative;
    }

    .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 1rem;
        color: var(--txt-color);
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        background: transparent;
        border: none;
        cursor: pointer;

        &:hover {
            background: var(--nav-bg-highlight);
            color: var(--text-color-hover);
        }
    }

    .dropdown-arrow {
        font-size: 0.75rem;
        transition: transform 0.2s ease;
    }

    .nav-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 230px;
        background: var(--bg-color-light);
        border: 1px solid var(--nav-bg-shadowA);
        border-radius: 12px;
        box-shadow: 0 12px 30px var(--nav-bg-shadowA);
        padding: 0.5rem 0;
        z-index: 1200;
        margin-top: 0.35rem;
    }

    .dropdown-header {
        padding: 0.5rem 1rem 0.25rem;
        font-size: 0.725rem;
        font-weight: 700;
        color: var(--txt-color);
        opacity: 0.7;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .dropdown-list {
        padding: 0.25rem 0;

        &.scrollable {
            max-height: 260px;
            overflow-y: auto;
        }
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.6rem 1rem;
        color: var(--txt-color);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition:
            background 0.15s ease,
            color 0.15s ease;

        .item-icon {
            font-size: 0.85rem;
            color: var(--bg-color-btn);
        }

        &:hover {
            background: var(--nav-bg-highlight);
            color: var(--text-color-hover);
        }
    }

    .dropdown-divider {
        height: 1px;
        background: var(--nav-bg-shadowA);
        margin: 0.4rem 0;
    }

    .editor-link {
        color: var(--bg-color-btn);
        font-weight: 600;

        .role-badge {
            margin-left: auto;
            font-size: 0.65rem;
            text-transform: uppercase;
            padding: 0.15rem 0.45rem;
            background: var(--nav-bg);
            color: var(--txt-color);
            border-radius: 4px;
            border: 1px solid var(--nav-bg-shadowA);
        }

        &:hover {
            background: var(--nav-bg-highlight);
        }
    }

    /* Hamburger Toggle Button */
    .hamburger-btn {
        display: none;
        background: transparent;
        border: none;
        padding: 0.5rem;
        cursor: pointer;
        z-index: 1101;
        border-radius: 8px;
        transition: background 0.2s ease;

        &:active {
            background: var(--nav-bg-highlight);
        }
    }

    .hamburger-lines {
        width: 26px;
        height: 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;

        .line {
            display: block;
            width: 100%;
            height: 3px;
            background: var(--ham-color);
            border-radius: 4px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        &.open .line {
            background: var(--ham-color-active);
        }

        &.open .line-1 {
            transform: translateY(8.5px) rotate(45deg);
        }

        &.open .line-2 {
            opacity: 0;
            transform: scaleX(0);
        }

        &.open .line-3 {
            transform: translateY(-8.5px) rotate(-45deg);
        }
    }

    /* Mobile Navigation Container & Drawer */
    .mobile-menu {
        display: none;
        position: fixed;
        top: calc(var(--nav-headerM) + 0.5rem);
        left: 0.75rem;
        right: 0.75rem;
        background: var(--MenuColorA);
        backdrop-filter: blur(12px);
        border: 1px solid var(--nav-bg-shadowA);
        border-radius: 16px;
        z-index: 1100;
        max-height: calc(85vh - var(--nav-headerM));
        overflow-y: auto;
        box-shadow: 0 16px 36px var(--nav-bg-shadow);
    }

    .mobile-menu-inner {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .mobile-nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        color: var(--text-color);
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.08);
        transition:
            background 0.2s ease,
            transform 0.15s ease;

        &:active {
            transform: scale(0.98);
            background: rgba(255, 255, 255, 0.15);
        }

        i {
            color: var(--MenuColor);
        }
    }

    /* Accordion Cards */
    .mobile-accordion-card {
        background: rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        overflow: hidden;

        .accordion-trigger {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.85rem 1rem;
            background: transparent;
            border: none;
            font-weight: 600;
            font-size: 1rem;
            color: var(--text-color);
            cursor: pointer;

            .trigger-title {
                display: flex;
                align-items: center;
                gap: 0.75rem;

                i {
                    color: var(--MenuColor);
                }
            }

            .accordion-arrow {
                font-size: 0.8rem;
                color: var(--text-color);
                opacity: 0.7;
                transition: transform 0.25s ease;

                &.rotate {
                    transform: rotate(180deg);
                }
            }
        }

        .accordion-panel {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.15);
            padding: 0.75rem;
        }
    }

    .panel-content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .mobile-sub-link {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.65rem 0.85rem;
        color: var(--text-color);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        border-radius: 8px;

        &:hover,
        &:active {
            background: rgba(255, 255, 255, 0.1);
        }

        &.editor-highlight {
            background: var(--bg-color-btn);
            color: var(--text-color);
            font-weight: 600;
        }
    }

    .chip-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .mobile-chip {
        font-size: 0.825rem;
        padding: 0.4rem 0.8rem;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        color: var(--text-color);
        text-decoration: none;
        font-weight: 500;
        transition: all 0.15s ease;

        &:active {
            background: var(--bg-color-btn);
            color: var(--text-color);
            transform: scale(0.95);
        }
    }

    .mobile-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        height: 100vh;
        background: var(--img-overlay);
        backdrop-filter: blur(4px);
        z-index: 1000;
    }

    @media (max-width: 768px) {
        .nav-header {
            height: var(--nav-headerM);
        }

        .nav-links-desktop {
            display: none;
        }

        .hamburger-btn,
        .mobile-menu,
        .mobile-backdrop {
            display: inline-block;
        }

        .logo-img {
            display: none;
            &-mobile {
                display: block;
                height: 3em;
            }
        }
    }
</style>
