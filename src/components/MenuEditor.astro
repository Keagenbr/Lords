---
// src/components/MenuEditor.astro
//
// Edits menu items (text, price, picture, takeaway availability/schedule) and the picture of
// each category. Changes are collected in the browser and written when the
// admin presses "Save Menu", one row at a time, through /admin/menu-crud
// (admin-only, allow-listed columns). Pictures are uploaded through
// /admin/upload-image (admin-only).
import { getMenu, getModifierGroups, type MenuType } from "../lib/menu";
import { STORAGE_PUBLIC_BASE } from "../lib/supabaseStorage";

let menuData: MenuType[] = [];
let modifierGroups: Awaited<ReturnType<typeof getModifierGroups>> = [];
let loadError = "";

interface Props {
    owner?: boolean;
    canEditItemOptions?: boolean;
}

const { owner = false, canEditItemOptions = true } = Astro.props;

try {
    [menuData, modifierGroups] = await Promise.all([
        getMenu(),
        getModifierGroups(),
    ]);
} catch (e) {
    console.error("Failed to load menu data for editor:", e);
    loadError = "Could not load the menu or modifier options from Supabase. Please refresh.";
}

const menuJson = JSON.stringify(menuData);
const modifierGroupsJson = JSON.stringify(modifierGroups);
---

<section
    class="menu-editor-container"
    x-data="menuEditorApp"
    data-menu={menuJson}
    data-modifier-groups={modifierGroupsJson}
    data-owner={owner ? "true" : "false"}
    data-can-edit-item-options={canEditItemOptions ? "true" : "false"}
    data-storage-base={STORAGE_PUBLIC_BASE}
    data-load-error={loadError}
>
    <!-- Editor Control Header -->
    <div class="editor-header">
        <div class="header-titles">
            <h1 data-icon="menu-editor">Menu Management Editor</h1>
            <p class="tagline">
                Update menu items and their pictures, then press Save Menu.
            </p>
        </div>
        <div class="header-actions">
            <span
                class="unsaved-note"
                x-show="dirtyCount > 0"
                x-cloak
                x-text="dirtyCount + (dirtyCount === 1 ? ' unsaved change' : ' unsaved changes')"
            ></span>
            <button
                type="button"
                class="save-btn"
                @click="saveAllChanges()"
                :disabled="isSaving"
            >
                <span
                    class="ico-only"
                    data-icon="save"
                    x-show="!isSaving"
                    aria-hidden="true"
                ></span>
                <span
                    class="ico-only ico-spin"
                    data-icon="loader"
                    x-show="isSaving"
                    x-cloak
                    aria-hidden="true"
                ></span>
                <span x-text="isSaving ? 'Saving Changes...' : 'Save Menu'"></span>
            </button>
        </div>
    </div>

    <!-- Choice / 2-for-1 guard popup -->
    <div
        class="choice-guard-overlay"
        x-show="choicePopup.open"
        x-cloak
        @click.self="closeChoicePopup()"
        @keydown.escape.window="closeChoicePopup()"
    >
        <div
            class="choice-guard-popup"
            :class="choicePopup.type === 'refresh' ? 'is-refresh' : 'is-error'"
            role="alertdialog"
            aria-modal="true"
            aria-labelledby="choiceGuardTitle"
        >
            <div class="choice-guard-accent" aria-hidden="true"></div>
            <div class="choice-guard-copy">
                <span class="choice-guard-kicker" x-text="choicePopup.type === 'refresh' ? 'Refresh required' : 'Selection required'"></span>
                <h2 id="choiceGuardTitle" x-text="choicePopup.title"></h2>
                <p x-text="choicePopup.message"></p>
            </div>
            <div class="choice-guard-actions">
                <button
                    type="button"
                    class="choice-guard-secondary"
                    x-show="choicePopup.action !== 'refresh'"
                    x-cloak
                    @click="closeChoicePopup()"
                >
                    Close
                </button>
                <button
                    type="button"
                    class="choice-guard-primary"
                    x-show="choicePopup.action === 'refresh'"
                    x-cloak
                    @click="refreshAfterChoiceChange()"
                    x-ref="choicePopupClose"
                >
                    Refresh page
                </button>
            </div>
        </div>
    </div>

    <!-- Save / upload feedback -->
    <div
        class="status-banner"
        :class="status.type"
        x-show="status.message"
        x-cloak
        role="status"
    >
        <span x-text="status.message"></span>
        <button
            type="button"
            class="status-close"
            @click="status = { type: '', message: '' }"
            aria-label="Dismiss message"
        >
            ✕
        </button>
    </div>

    <!-- Search & Filter Controls -->
    <div class="search-box">
        <span
            class="search-icon ico-only"
            data-icon="search"
            aria-hidden="true"
        ></span>
        <input
            type="text"
            x-model="search"
            placeholder="Search item name, category, or description..."
            class="search-input"
        />
        <button
            x-show="search.length > 0"
            @click="search = ''"
            class="clear-search-btn"
        >
            ✕
        </button>
    </div>

    <!-- Type Tabs -->
    <div class="filter-buttons">
        <button
            class="filter-btn"
            :class="{ active: selectedType === 'all' }"
            @click="selectedType = 'all'"
        >
            All Types
        </button>
        <template x-for="t in types" :key="t.id">
            <button
                class="filter-btn"
                :data-icon="String(t.id).toLowerCase()"
                :class="{ active: selectedType === t.id }"
                @click="selectedType = t.id"
            >
                <span x-text="t.label"></span>
            </button>
        </template>
    </div>

    <!-- Category Sections & Editable Item Grids -->
    <template x-for="type in filteredMenu" :key="type.id">
        <section class="menu-type-section">
            <h2 class="type-header">
                <span
                    class="ico-only"
                    :data-icon="String(type.id).toLowerCase()"
                    aria-hidden="true"
                ></span>
                <span x-text="type.label"></span>
            </h2>

            <template x-for="cat in type.categories" :key="cat.id">
                <div
                    class="category-block"
                    :class="{ 'is-open': isCategoryOpen(cat.id) }"
                >
                    <div class="category-header">
                        <div
                            class="category-title"
                            @click="toggleCategory(cat.id)"
                        >
                            <!-- Editable Category Logo with Image Changer -->
                            <div
                                class="cat-logo-wrapper"
                                @click.stop="openImagePicker('category', cat)"
                            >
                                <img
                                    :src="getCategoryImage(cat)"
                                    :alt="cat.label"
                                    class="category-logo"
                                />
                                <div class="image-overlay-edit">
                                    <span
                                        class="ico-only"
                                        data-icon="camera"
                                        aria-hidden="true"
                                    ></span>
                                </div>
                            </div>
                            <span x-text="cat.label.replace(/_/g, ' ')"></span>
                        </div>

                        <div class="category-actions">
                            <button
                                class="add-item-btn"
                                @click.stop="addNewItem(cat)"
                                title="Add New Item to Category"
                            >
                                Add Item
                            </button>
                            <button
                                class="toggle-cat-btn"
                                @click="toggleCategory(cat.id)"
                            >
                                <span
                                    class="cat-chevron ico-only"
                                    data-icon="double-chevron-down"
                                    :class="{ 'is-open': isCategoryOpen(cat.id) }"
                                    aria-hidden="true"
                                ></span>
                            </button>
                        </div>
                    </div>

                    <!-- Collapsible Category Items -->
                    <div
                        class="category-content"
                        x-show="isCategoryOpen(cat.id)"
                        x-collapse
                    >
                        <ul class="item-list">
                            <template
                                x-for="(item, index) in cat.items"
                                :key="item.id || index"
                            >
                                <li
                                    class="menu-item-editor"
                                    :data-item-id="item.id"
                                >
                                    <div class="item-layout">
                                        <!-- Item Image Preview & Changer -->
                                        <div
                                            class="item-thumb-wrapper"
                                            @click="openImagePicker('item', item)"
                                        >
                                            <div class="image-preview-container">
                                                <img
                                                    :src="getItemImage(item)"
                                                    :alt="item.name"
                                                    class="item-thumb"
                                                    x-show="getItemImage(item)"
                                                />
                                                <div
                                                    class="no-img-placeholder"
                                                    x-show="!getItemImage(item)"
                                                >
                                                    <span
                                                        class="ico-only"
                                                        data-icon="image"
                                                        aria-hidden="true"
                                                    ></span>
                                                    <span>No Img</span>
                                                </div>
                                                <div class="thumb-hover-edit">
                                                    <span
                                                        class="ico-only"
                                                        data-icon="refresh"
                                                        aria-hidden="true"
                                                    ></span>
                                                    Change
                                                </div>
                                            </div>
                                            <button
                                                class="view-lightbox-btn"
                                                x-show="getItemImage(item)"
                                                @click.stop="openLightbox(getItemImage(item), item.name)"
                                                title="View Fullsize"
                                            >
                                                <span
                                                    class="ico-only"
                                                    data-icon="expand"
                                                    aria-hidden="true"
                                                ></span>
                                            </button>
                                        </div>

                                        <!-- Item Details Editor -->
                                        <div class="item-details-fields">
                                            <div class="field-row">
                                                <label class="field field-name">
                                                    <span class="field-label">
                                                        Name
                                                    </span>
                                                    <input
                                                        type="text"
                                                        x-model="item.name"
                                                        placeholder="Item name"
                                                        class="edit-input name-input"
                                                    />
                                                </label>
                                                <label class="field field-price">
                                                    <span class="field-label">
                                                        Price
                                                    </span>
                                                    <input
                                                        type="text"
                                                        x-model="item.price"
                                                        placeholder="R95.00"
                                                        inputmode="text"
                                                        class="edit-input price-input"
                                                    />
                                                </label>
                                            </div>

                                            <label class="field field-desc">
                                                <span class="field-label">
                                                    Description
                                                </span>
                                                <textarea
                                                    x-model="item.description"
                                                    placeholder="Description / ingredients..."
                                                    class="edit-textarea"
                                                    rows="2"
                                                ></textarea>
                                            </label>

                                            <div class="field-tags">
                                                <label class="field field-serves">
                                                    <span class="field-label">
                                                        Serves
                                                    </span>
                                                    <input
                                                        type="text"
                                                        x-model="item.serves"
                                                        placeholder="e.g. Serves 2"
                                                        class="edit-input serves-input"
                                                    />
                                                </label>
                                                <label class="toggle-checkbox">
                                                    <input
                                                        type="checkbox"
                                                        x-model="item.takeaway"
                                                    />
                                                    <span>Available takeaway</span>
                                                </label>
                                            </div>

                                            <div class="takeaway-schedule" x-show="item.takeaway" x-cloak>
                                                <div class="takeaway-schedule-head">
                                                    <span class="field-label">Takeaway days</span>
                                                    <button
                                                        type="button"
                                                        class="takeaway-all-btn"
                                                        @click="setAllTakeawayDays(item)"
                                                    >
                                                        Every day
                                                    </button>
                                                </div>
                                                <div class="takeaway-day-options">
                                                    <template x-for="day in takeawayWeekdays" :key="day.value">
                                                        <label class="takeaway-day-option" :class="{ 'is-active': item.takeaway_days.includes(day.value) }">
                                                            <input
                                                                type="checkbox"
                                                                :value="day.value"
                                                                :checked="item.takeaway_days.includes(day.value)"
                                                                @change="toggleTakeawayDay(item, day.value)"
                                                            />
                                                            <span x-text="day.short"></span>
                                                        </label>
                                                    </template>
                                                </div>
                                                <p class="takeaway-schedule-hint" x-show="item.takeaway_days.length === 0">Select at least one day for takeaway ordering.</p>
                                            </div>

                                            <div class="modifier-assignment" x-show="canEditItemOptions && isItemSelectionEditorOpen(item)" x-cloak>
                                                <div class="modifier-assignment-head">
                                                    <div>
                                                        <span class="field-label">Item selections</span>
                                                        <p class="modifier-assignment-hint">Attach options to this item only. Category-linked modifiers are inherited automatically.</p>
                                                    </div>
                                                </div>

                                                <label class="two-for-one-toggle" :class="{ 'is-active': item.two_for_one }">
                                                    <input
                                                        type="checkbox"
                                                        :checked="item.two_for_one"
                                                        @click.prevent="toggleTwoForOne(item)"
                                                        :aria-checked="item.two_for_one ? 'true' : 'false'"
                                                    />
                                                    <span class="two-for-one-toggle-copy">
                                                        <strong>2 for 1 special</strong>
                                                        <small>Requires Side choice or Sauce selection. Customers choose two different options from each assigned eligible group.</small>
                                                    </span>
                                                </label>

                                                <div class="modifier-assignment-list" x-show="modifierGroupsCatalog.length > 0">
                                                    <template x-for="group in modifierGroupsCatalog" :key="group.id">
                                                        <label class="modifier-assignment-option" :class="{ 'is-active': item.item_modifier_group_ids.includes(group.id) }">
                                                            <input
                                                                type="checkbox"
                                                                :checked="item.item_modifier_group_ids.includes(group.id)"
                                                                @change="toggleModifierGroup(item, group.id)"
                                                            />
                                                            <span class="modifier-assignment-copy">
                                                                <strong x-text="group.name"></strong>
                                                                <small x-text="group.options.length + (group.options.length === 1 ? ' option' : ' options') + ' · ' + (group.selection_type === 'multiple' ? 'multiple choice' : 'single choice')"></small>
                                                            </span>
                                                        </label>
                                                    </template>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Item Controls -->
                                        <div class="item-actions">
                                            <span
                                                class="dirty-badge"
                                                x-show="isItemDirty(item)"
                                                x-cloak
                                                x-text="isNewItem(item) ? 'New' : 'Edited'"
                                            ></span>
                                            <button
                                                type="button"
                                                class="selection-edit-btn"
                                                x-show="canEditItemOptions"
                                                x-cloak
                                                @click="toggleItemSelectionEditor(item)"
                                                :aria-expanded="isItemSelectionEditorOpen(item)"
                                                title="Edit item selections"
                                            >
                                                <span
                                                    class="ico-only"
                                                    data-icon="edit"
                                                    aria-hidden="true"
                                                ></span>
                                                <span x-text="isItemSelectionEditorOpen(item) ? 'Close selections' : 'Edit selections'"></span>
                                            </button>
                                            <button
                                                type="button"
                                                class="delete-item-btn"
                                                @click="removeItem(cat, index)"
                                                title="Delete item"
                                            >
                                                <span
                                                    class="ico-only"
                                                    data-icon="trash"
                                                    aria-hidden="true"
                                                ></span>
                                                <span>Delete</span>
                                            </button>
                                        </div>
                                    </div>
                                </li>
                            </template>
                        </ul>
                    </div>
                </div>
            </template>
        </section>
    </template>

    <!-- Lightbox Modal for Image Inspection -->
    <div
        class="lightbox-overlay"
        x-show="lightboxOpen"
        x-cloak
        @click="lightboxOpen = false"
    >
        <div class="lightbox-content" @click.stop>
            <button class="close-lightbox-btn" @click="lightboxOpen = false">
                &times;
            </button>
            <img :src="lightboxUrl" :alt="lightboxTitle" />
            <div class="lightbox-caption" x-text="lightboxTitle"></div>
        </div>
    </div>

    <!-- Hidden File Input for Image Uploading -->
    <input
        type="file"
        id="editorImageInput"
        accept="image/*"
        style="display: none;"
        @change="handleImageUpload($event)"
    />

    <!-- Upload Progress Loader Modal -->
    <div class="loader-overlay" x-show="isUploading" x-cloak>
        <div class="loader-box">
            <span
                class="loader-icon ico-only ico-spin"
                data-icon="loader"
                aria-hidden="true"
            ></span>
            <p>Uploading image to Supabase Storage...</p>
        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener("alpine:init", () => {
        // Neutral placeholder (an inline SVG, so no third-party image host).
        const NO_IMAGE =
            "data:image/svg+xml;utf8," +
            encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120">' +
                    '<rect width="120" height="120" fill="#e2e8f0"/>' +
                    '<text x="60" y="64" font-family="sans-serif" font-size="12" ' +
                    'text-anchor="middle" fill="#718096">No image</text></svg>',
            );

        Alpine.data("menuEditorApp", () => ({
            menu: [],
            storageBase: "",
            modifierGroupsCatalog: [],
            owner: false,
            canEditItemOptions: true,
            selectionEditorOpen: {},
            choicePopup: { open: false, type: "error", title: "", message: "", action: "close" },

            // What the database currently holds, used to find unsaved edits.
            baseline: {}, // item id -> JSON snapshot
            categoryBaseline: {}, // category id -> image_url
            deletedIds: [], // saved items the admin removed, pending delete

            search: "",
            selectedType: "all",
            openCategories: {},
            isSaving: false,
            isUploading: false,
            status: { type: "", message: "" },

            // Which picture is being changed: { type, id }
            activeUploadTarget: null,

            // Lightbox
            lightboxOpen: false,
            lightboxUrl: "",
            lightboxTitle: "",

            init() {
                const el = this.$el;
                this.storageBase = el.dataset.storageBase || "";
                this.owner = el.dataset.owner === "true";
                this.canEditItemOptions = el.dataset.canEditItemOptions !== "false";

                try {
                    this.modifierGroupsCatalog = JSON.parse(el.dataset.modifierGroups || "[]");
                } catch (err) {
                    console.error("Modifier groups could not be read:", err);
                    this.modifierGroupsCatalog = [];
                }

                if (el.dataset.loadError) {
                    this.status = {
                        type: "error",
                        message: el.dataset.loadError,
                    };
                }

                let parsed = [];
                try {
                    parsed = JSON.parse(el.dataset.menu || "[]");
                } catch (err) {
                    console.error("Menu data could not be read:", err);
                }

                // Normalise so the form controls always have a value to bind.
                // (takeaway: only an explicit `false` means "not for takeaway".)
                parsed.forEach((t) => {
                    t.categories = t.categories || [];
                    t.categories.forEach((c) => {
                        c.items = c.items || [];
                        c.items.forEach((i) => {
                            i.name = i.name ?? "";
                            i.price = i.price ?? "";
                            i.description = i.description ?? "";
                            i.serves = i.serves ?? "";
                            i.image_url = i.image_url ?? "";
                            i.takeaway = i.takeaway !== false;
                            i.two_for_one = i.two_for_one === true;
                            i.takeaway_days = Array.isArray(i.takeaway_days)
                                ? i.takeaway_days.map(Number).filter((day) => day >= 0 && day <= 6)
                                : [1, 2, 3, 4, 5, 6, 0];
                            i.item_modifier_group_ids = Array.isArray(i.item_modifier_group_ids)
                                ? [...new Set(i.item_modifier_group_ids.map(String))]
                                : [];
                        });
                    });
                });

                this.menu = parsed;
                this.takeSnapshot();
                // Phones: start with the categories closed so the admin sees a
                // short list and taps the one to edit. Larger screens: all open.
                const isPhone = window.matchMedia("(max-width: 768px)").matches;
                this.menu.forEach((t) =>
                    t.categories.forEach((c) => {
                        this.openCategories[c.id] = !isPhone;
                    }),
                );

                window.addEventListener("beforeunload", (event) => {
                    if (this.dirtyCount > 0) {
                        event.preventDefault();
                        event.returnValue = "";
                    }
                });
            },

            // ── Derived data ───────────────────────────────────────
            get types() {
                return this.menu.map((t) => ({ id: t.id, label: t.label }));
            },

            get filteredMenu() {
                return this.menu
                    .filter(
                        (t) =>
                            this.selectedType === "all" ||
                            t.id === this.selectedType,
                    )
                    .map((t) => ({
                        ...t,
                        categories: t.categories.filter((c) => {
                            if (!this.search.trim()) return true;
                            const q = this.search.toLowerCase();
                            return (
                                c.label.toLowerCase().includes(q) ||
                                c.items.some(
                                    (i) =>
                                        (i.name || "")
                                            .toLowerCase()
                                            .includes(q) ||
                                        (i.description || "")
                                            .toLowerCase()
                                            .includes(q),
                                )
                            );
                        }),
                    }));
            },

            // ── Unsaved-change tracking ────────────────────────────
            itemPayload(item) {
                return {
                    name: String(item.name ?? "").trim(),
                    price: String(item.price ?? "").trim(),
                    description: String(item.description ?? "").trim(),
                    serves: String(item.serves ?? "").trim(),
                    image_url: String(item.image_url ?? "").trim(),
                    takeaway: !!item.takeaway,
                    two_for_one: !!item.two_for_one,
                    takeaway_days: Array.isArray(item.takeaway_days)
                        ? [...new Set(item.takeaway_days.map(Number).filter((day) => day >= 0 && day <= 6))].sort((a, b) => a - b)
                        : [0, 1, 2, 3, 4, 5, 6],
                    item_modifier_group_ids: Array.isArray(item.item_modifier_group_ids)
                        ? [...new Set(item.item_modifier_group_ids.map(String))].sort()
                        : [],
                };
            },

            takeSnapshot() {
                this.baseline = {};
                this.categoryBaseline = {};
                this.deletedIds = [];
                this.menu.forEach((t) =>
                    t.categories.forEach((c) => {
                        this.categoryBaseline[c.id] = c.image_url || "";
                        c.items.forEach((i) => {
                            this.baseline[i.id] = JSON.stringify(
                                this.itemPayload(i),
                            );
                        });
                    }),
                );
            },

            isNewItem(item) {
                return String(item.id).startsWith("new_");
            },

            isItemDirty(item) {
                return (
                    this.isNewItem(item) ||
                    this.baseline[item.id] !==
                        JSON.stringify(this.itemPayload(item))
                );
            },

            isCategoryDirty(cat) {
                return (
                    (cat.image_url || "") !==
                    (this.categoryBaseline[cat.id] ?? "")
                );
            },

            get dirtyCount() {
                let n = this.deletedIds.length;
                this.menu.forEach((t) =>
                    t.categories.forEach((c) => {
                        if (this.isCategoryDirty(c)) n++;
                        c.items.forEach((i) => {
                            if (this.isItemDirty(i)) n++;
                        });
                    }),
                );
                return n;
            },

            takeawayWeekdays: [
                { value: 1, short: "Mon" },
                { value: 2, short: "Tue" },
                { value: 3, short: "Wed" },
                { value: 4, short: "Thu" },
                { value: 5, short: "Fri" },
                { value: 6, short: "Sat" },
                { value: 0, short: "Sun" },
            ],

            toggleTakeawayDay(item, day) {
                const days = Array.isArray(item.takeaway_days) ? [...item.takeaway_days] : [];
                const index = days.indexOf(day);
                if (index === -1) days.push(day);
                else days.splice(index, 1);
                item.takeaway_days = [...new Set(days.map(Number).filter((value) => value >= 0 && value <= 6))].sort((a, b) => a - b);
            },

            setAllTakeawayDays(item) {
                item.takeaway_days = [0, 1, 2, 3, 4, 5, 6];
            },

            toggleModifierGroup(item, groupId) {
                const ids = Array.isArray(item.item_modifier_group_ids)
                    ? [...item.item_modifier_group_ids.map(String)]
                    : [];
                const id = String(groupId);
                const index = ids.indexOf(id);
                if (index === -1) ids.push(id);
                else ids.splice(index, 1);
                item.item_modifier_group_ids = [...new Set(ids)].sort();
            },

            getItemModifierGroupIds(item) {
                const itemIds = Array.isArray(item?.item_modifier_group_ids)
                    ? item.item_modifier_group_ids.map(String)
                    : [];
                const inheritedIds = Array.isArray(item?.modifier_groups)
                    ? item.modifier_groups.map((group) => String(group.id))
                    : [];
                return [...new Set([...itemIds, ...inheritedIds])];
            },

            getEligibleTwoForOneGroups(item) {
                const ids = new Set(this.getItemModifierGroupIds(item));
                return this.modifierGroupsCatalog.filter(
                    (group) =>
                        ids.has(String(group.id)) &&
                        (String(group.id) === "side_choice" || String(group.id) === "sauce_selection") &&
                        Array.isArray(group.options) &&
                        group.options.length > 0,
                );
            },

            modifierAssignmentsChanged(item) {
                if (!item || this.isNewItem(item)) {
                    return Array.isArray(item?.item_modifier_group_ids) && item.item_modifier_group_ids.length > 0;
                }
                const current = Array.isArray(item.item_modifier_group_ids)
                    ? [...new Set(item.item_modifier_group_ids.map(String))].sort()
                    : [];
                const baseline = this.baselineModifierIds(item);
                return JSON.stringify(current) !== JSON.stringify(baseline);
            },

            showChoicePopup({ type = "error", title, message, action = "close" }) {
                this.choicePopup = { open: true, type, title, message, action };
                this.$nextTick(() => {
                    this.$refs.choicePopupClose?.focus?.();
                });
            },

            closeChoicePopup() {
                this.choicePopup.open = false;
            },

            refreshAfterChoiceChange() {
                window.location.reload();
            },

            toggleTwoForOne(item) {
                if (!this.canEditItemOptions || !item?.id) return;

                if (item.two_for_one) {
                    item.two_for_one = false;
                    return;
                }

                const eligibleGroups = this.getEligibleTwoForOneGroups(item);
                if (eligibleGroups.length === 0) {
                    this.showChoicePopup({
                        type: "error",
                        title: "2 for 1 cannot be enabled yet",
                        message: `This item does not currently have a Side choice or Sauce selection assigned. Open Edit selections for this item, add at least one of those choice groups, press Save Menu, then refresh the page before enabling 2 for 1.`,
                    });
                    return;
                }

                if (this.modifierAssignmentsChanged(item)) {
                    this.showChoicePopup({
                        type: "refresh",
                        title: "Please refresh before enabling 2 for 1",
                        message: `A choice assignment for "${item.name || "this item"}" was changed recently. Save the choice assignment first, then refresh this page so the latest choice options are loaded before turning on the 2 for 1 special.`,
                        action: "refresh",
                    });
                    return;
                }

                item.two_for_one = true;
            },

            isItemSelectionEditorOpen(item) {
                return this.canEditItemOptions && !!this.selectionEditorOpen[String(item?.id)];
            },

            toggleItemSelectionEditor(item) {
                if (!this.canEditItemOptions || !item?.id) return;
                const id = String(item.id);
                this.selectionEditorOpen[id] = !this.selectionEditorOpen[id];
            },

            // ── UI helpers ─────────────────────────────────────────
            toggleCategory(catId) {
                this.openCategories[catId] = !this.openCategories[catId];
            },

            isCategoryOpen(catId) {
                if (this.search.trim().length > 0) return true;
                return !!this.openCategories[catId];
            },

            // A stored value is either a full URL (what uploads save) or a
            // bare file name from older rows.
            resolveImage(value, folder) {
                if (!value) return "";
                if (/^(https?:)?\/\//.test(value) || value.startsWith("/")) {
                    return value;
                }
                return `${this.storageBase}/${folder}/${encodeURIComponent(value)}`;
            },

            getCategoryImage(cat) {
                return (
                    this.resolveImage(cat.image_url, "Categories") || NO_IMAGE
                );
            },

            getItemImage(item) {
                return this.resolveImage(item.image_url, "MenuItems");
            },

            // ── Item add / remove ──────────────────────────────────
            addNewItem(category) {
                const last = category.items.reduce(
                    (max, i) => Math.max(max, Number(i.sort_order) || 0),
                    0,
                );
                const tempId = "new_" + Date.now();
                category.items.push({
                    id: tempId,
                    category_id: category.id,
                    name: "New Menu Item",
                    price: "",
                    description: "",
                    serves: "",
                    takeaway: true,
                    takeaway_days: [0, 1, 2, 3, 4, 5, 6],
                    item_modifier_group_ids: [],
                    image_url: "",
                    sort_order: last + 1,
                });
                this.openCategories[category.id] = true;
                if (this.canEditItemOptions) this.selectionEditorOpen[tempId] = true;
                this.$nextTick(() => {
                    const rows = this.$el.querySelectorAll(
                        `[data-item-id="${tempId}"]`,
                    );
                    rows[0]?.scrollIntoView({
                        behavior: "smooth",
                        block: "center",
                    });
                });
            },

            async removeItem(category, index) {
                const item = category.items[index];
                if (!item) return;
                const ok = await window.siteDialog.confirm({
                    title: `Delete "${item.name || "this item"}"?`,
                    message: 'This is applied when you press "Save Menu".',
                    confirmText: "Delete item",
                    tone: "danger",
                });
                if (!ok || category.items[index] !== item) return;
                if (!this.isNewItem(item)) this.deletedIds.push(item.id);
                delete this.selectionEditorOpen[String(item.id)];
                category.items.splice(index, 1);
            },

            // ── Pictures ───────────────────────────────────────────
            openImagePicker(type, target) {
                this.activeUploadTarget = { type, id: target.id };
                document.getElementById("editorImageInput").click();
            },

            findUploadTarget() {
                const t = this.activeUploadTarget;
                if (!t) return null;
                for (const type of this.menu) {
                    for (const cat of type.categories) {
                        if (
                            t.type === "category" &&
                            String(cat.id) === String(t.id)
                        ) {
                            return cat;
                        }
                        if (t.type === "item") {
                            const hit = cat.items.find(
                                (i) => String(i.id) === String(t.id),
                            );
                            if (hit) return hit;
                        }
                    }
                }
                return null;
            },

            async handleImageUpload(event) {
                const input = event.target;
                const file = input.files[0];
                const target = this.findUploadTarget();
                if (!file || !target) {
                    input.value = "";
                    return;
                }

                // The host (Vercel) rejects uploads over 4.5 MB, so stop at 4 MB.
                if (file.size > 4 * 1024 * 1024) {
                    this.status = {
                        type: "error",
                        message:
                            "That picture is over 4MB. Shrink it first (e.g. at squoosh.app) and try again.",
                    };
                    input.value = "";
                    return;
                }

                this.isUploading = true;
                try {
                    const form = new FormData();
                    form.append("file", file);
                    form.append(
                        "folder",
                        this.activeUploadTarget.type === "category"
                            ? "Categories"
                            : "MenuItems",
                    );

                    const res = await fetch("/admin/upload-image", {
                        method: "POST",
                        body: form,
                        credentials: "same-origin",
                    });
                    const body = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(this.errorText(res, body));

                    // Shows immediately; it is attached to the menu when the
                    // admin presses "Save Menu".
                    target.image_url = body.url;

                    // The server reports what optimisation did. "failed" means
                    // the ORIGINAL picture was uploaded untouched.
                    const o = body.optimization;
                    const size = (n) =>
                        n >= 1048576
                            ? (n / 1048576).toFixed(1) + " MB"
                            : Math.round(n / 1024) + " KB";
                    let note = "";
                    let type = "info";
                    if (o?.status === "optimized") {
                        note = ` Optimised: ${size(o.originalBytes)} → ${size(o.finalBytes)}.`;
                    } else if (o?.status === "failed") {
                        type = "warning";
                        note = ` Optimisation failed, so the original (${size(o.originalBytes)}) was uploaded instead.`;
                    }
                    this.status = {
                        type,
                        message:
                            "Picture uploaded." +
                            note +
                            ' Press "Save Menu" to attach it.',
                    };
                } catch (err) {
                    this.status = {
                        type: "error",
                        message: "Image upload failed: " + err.message,
                    };
                } finally {
                    this.isUploading = false;
                    this.activeUploadTarget = null;
                    input.value = "";
                }
            },

            openLightbox(url, title) {
                this.lightboxUrl = url;
                this.lightboxTitle = title;
                this.lightboxOpen = true;
            },

            // ── Saving ─────────────────────────────────────────────
            errorText(res, body) {
                if (res.status === 403 || res.status === 401) {
                    return "Your admin session has expired. Please sign in again.";
                }
                if (res.status === 413) {
                    return "The picture is too large (max 4MB).";
                }
                return body?.error || `Request failed (${res.status})`;
            },

            async callCrud(action, table, data) {
                const res = await fetch("/admin/menu-crud", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "same-origin",
                    body: JSON.stringify({ action, table, data }),
                });
                const body = await res.json().catch(() => ({}));
                if (!res.ok) {
                    const error = Object.assign(new Error(this.errorText(res, body)), {
                        code: body?.error || "request_failed",
                    });
                    throw error;
                }
                return body;
            },

            baselineModifierIds(item) {
                if (this.isNewItem(item)) return [];
                try {
                    const saved = JSON.parse(this.baseline[item.id] || "{}");
                    return Array.isArray(saved.item_modifier_group_ids)
                        ? [...new Set(saved.item_modifier_group_ids.map(String))]
                        : [];
                } catch {
                    return [];
                }
            },

            async syncItemModifierGroups(item) {
                const previous = this.baselineModifierIds(item);
                const current = Array.isArray(item.item_modifier_group_ids)
                    ? [...new Set(item.item_modifier_group_ids.map(String))]
                    : [];
                const currentSet = new Set(current);
                const previousSet = new Set(previous);

                for (const groupId of previous) {
                    if (!currentSet.has(groupId)) {
                        await this.callCrud("delete", "menu_item_modifier_groups", {
                            item_id: item.id,
                            group_id: groupId,
                        });
                    }
                }

                for (const groupId of current) {
                    if (!previousSet.has(groupId)) {
                        await this.callCrud("create", "menu_item_modifier_groups", {
                            item_id: item.id,
                            group_id: groupId,
                        });
                    }
                }
            },

            async saveAllChanges() {
                if (this.isSaving) return;

                // The button stays enabled so the admin always gets feedback:
                // with nothing changed we say so instead of silently greying out.
                if (this.dirtyCount === 0) {
                    this.status = { type: "info", message: "No changes to save yet. Edit an item first." };
                    return;
                }

                // Every changed or new item needs a name and a valid takeaway schedule.
                for (const type of this.menu) {
                    for (const cat of type.categories) {
                        const invalidSchedule = cat.items.find(
                            (i) => this.isItemDirty(i) && i.takeaway === true && (!Array.isArray(i.takeaway_days) || i.takeaway_days.length === 0),
                        );
                        const invalidTwoForOne = cat.items.find(
                            (i) => this.isItemDirty(i) && i.two_for_one === true && this.getEligibleTwoForOneGroups(i).length === 0,
                        );
                        if (invalidTwoForOne) {
                            this.showChoicePopup({
                                type: "error",
                                title: "2 for 1 cannot be saved",
                                message: `"${invalidTwoForOne.name || "This item"}" must have a Side choice or Sauce selection assigned before the 2 for 1 special can be saved. Open Edit selections, assign a choice group, save it, refresh the page, and then enable 2 for 1.`,
                            });
                            return;
                        }
                        if (invalidSchedule) {
                            this.status = {
                                type: "error",
                                message: `Select at least one takeaway day for "${invalidSchedule.name || "this item"}".`,
                            };
                            return;
                        }

                        const unnamed = cat.items.find(
                            (i) =>
                                this.isItemDirty(i) &&
                                !String(i.name || "").trim(),
                        );
                        if (unnamed) {
                            this.status = {
                                type: "error",
                                message: `Please give every item a name (check "${cat.label.replace(/_/g, " ")}").`,
                            };
                            return;
                        }
                    }
                }

                this.isSaving = true;
                this.status = { type: "", message: "" };
                const errors = [];
                let saved = 0;

                // 1. Deleted items
                for (const id of [...this.deletedIds]) {
                    try {
                        await this.callCrud("delete", "menu_items", { id });
                        this.deletedIds = this.deletedIds.filter(
                            (x) => x !== id,
                        );
                        saved++;
                    } catch (err) {
                        errors.push(`Delete failed: ${err.message}`);
                    }
                }

                for (const type of this.menu) {
                    for (const cat of type.categories) {
                        // 2. Category picture
                        if (this.isCategoryDirty(cat)) {
                            try {
                                await this.callCrud(
                                    "update",
                                    "menu_categories",
                                    {
                                        id: cat.id,
                                        image_url: cat.image_url || "",
                                    },
                                );
                                this.categoryBaseline[cat.id] =
                                    cat.image_url || "";
                                saved++;
                            } catch (err) {
                                errors.push(
                                    `Category "${cat.label}": ${err.message}`,
                                );
                            }
                        }

                        // 3. Items (iterate a copy: ids change on create)
                        for (const item of [...cat.items]) {
                            if (!this.isItemDirty(item)) continue;
                            const payload = this.itemPayload(item);
                            try {
                                if (this.isNewItem(item)) {
                                    const desiredModifierIds = Array.isArray(item.item_modifier_group_ids)
                                        ? [...item.item_modifier_group_ids]
                                        : [];
                                    const createPayload = {
                                        ...payload,
                                        two_for_one: false,
                                        category_id: cat.id,
                                        sort_order: item.sort_order,
                                    };
                                    const { row } = await this.callCrud(
                                        "create",
                                        "menu_items",
                                        createPayload,
                                    );
                                    item.id = row.id;
                                    item.item_modifier_group_ids = desiredModifierIds;
                                    await this.syncItemModifierGroups(item);
                                    if (payload.two_for_one) {
                                        await this.callCrud(
                                            "update",
                                            "menu_items",
                                            { id: item.id, two_for_one: true },
                                        );
                                    }
                                } else {
                                    // Choice assignments are synced first when the 2-for-1 flag is being
                                    // enabled, so the server can verify that the item already has an eligible choice.
                                    if (payload.two_for_one) {
                                        await this.syncItemModifierGroups(item);
                                    }
                                    await this.callCrud(
                                        "update",
                                        "menu_items",
                                        {
                                            ...payload,
                                            id: item.id,
                                        },
                                    );
                                    if (!payload.two_for_one) {
                                        await this.syncItemModifierGroups(item);
                                    }
                                }

                                this.baseline[item.id] = JSON.stringify(
                                    this.itemPayload(item),
                                );
                                saved++;
                            } catch (err) {
                                if (err?.code === "two_for_one_requires_choice") {
                                    this.showChoicePopup({
                                        type: "error",
                                        title: "2 for 1 could not be enabled",
                                        message: `The server could not confirm a Side choice or Sauce selection for "${payload.name || "this item"}". Open Edit selections, assign at least one eligible choice group, press Save Menu, refresh the page, and then enable the 2 for 1 special.`,
                                    });
                                }
                                errors.push(
                                    `"${payload.name}": ${err.message}`,
                                );
                            }
                        }
                    }
                }

                this.isSaving = false;
                if (errors.length === 0) {
                    this.status = {
                        type: "success",
                        message: `Menu saved (${saved} change${saved === 1 ? "" : "s"}).`,
                    };
                } else {
                    this.status = {
                        type: "error",
                        message:
                            (saved ? `${saved} saved, ` : "") +
                            `${errors.length} failed. ` +
                            errors.slice(0, 3).join(" · "),
                    };
                }
            },
        }));
    });
</script>

