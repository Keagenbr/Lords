---
// src/components/MenuMain.astro
//
// Slider for the multi-page main menu. Images are loaded from Supabase
// Storage and shown in the order defined in src/lib/menuImages.ts (or
// via the `parts` prop if you want to override it per-page).
import { getPublicImageUrl } from "../../lib/supabaseStorage";
import { MAIN_MENU_PARTS, MAIN_MENU_FOLDER } from "../../lib/menuImages";

export interface MenuPart {
    filename: string;
    label: string;
}

interface Props {
    parts?: MenuPart[];
    folder?: string;
}

// The default pages (and their order) live in src/lib/menuImages.ts so the
// admin image editor edits exactly what is shown here.
const { parts = MAIN_MENU_PARTS, folder = MAIN_MENU_FOLDER } = Astro.props;

// Build full public URLs here, on the server. This is the part that
// used to fail — computing storage URLs in the browser via `window`.
const menuParts = parts.map((part) => ({
    ...part,
    url: getPublicImageUrl(`${folder}/${part.filename}`),
}));
---

<div class="main-menu-wrapper">
    <h2 class="section-title">Main Menu</h2>

    <div
        class="menu-slider-container"
        x-data={`mainMenuSlider(${JSON.stringify(menuParts)})`}
    >
        <!-- Slider Track -->
        <div
            class="slider-track"
            :style="`transform: translateX(-${currentIndex * 100}%)`"
        >
            <template x-for="(part, index) in menuParts" :key="index">
                <div class="menu-slide" @click="openLightbox(index)">
                    <img
                        :src="part.url"
                        :alt="part.label"
                        class="menu-image"
                        loading="lazy"
                    />

                    <div class="slide-caption">
                        <span x-text="part.label"></span>
                        <div class="download-btn">
                            <a
                                :href="part.url"
                                :download="part.filename"
                                @click.stop
                            >
                                ⬇ Download
                            </a>
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <!-- Navigation Arrows -->
        <button
            class="nav-btn prev-btn"
            @click="prevSlide()"
            :disabled="currentIndex === 0"
        >
            &lt;
        </button>
        <button
            class="nav-btn next-btn"
            @click="nextSlide()"
            :disabled="currentIndex === menuParts.length - 1"
        >
            &gt;
        </button>

        <!-- Pagination Dots -->
        <div class="pagination-dots">
            <template x-for="(part, index) in menuParts" :key="index">
                <button
                    class="dot"
                    :class="{ active: index === currentIndex }"
                    @click="goToSlide(index)"
                ></button>
            </template>
        </div>

        <!-- Lightbox Overlay -->
        <div
            class="lightbox-overlay"
            x-show="lightboxOpen"
            x-cloak
            @click="closeLightbox()"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
        >
            <div class="lightbox-content" @click.stop>
                <button class="close-lightbox-btn" @click="closeLightbox()">
                    &times;
                </button>

                <img
                    :src="menuParts[lightboxIndex].url"
                    :alt="menuParts[lightboxIndex].label"
                />

                <div
                    class="lightbox-caption"
                    x-text="menuParts[lightboxIndex].label"
                ></div>

                <a
                    :href="menuParts[lightboxIndex].url"
                    :download="menuParts[lightboxIndex].filename"
                    class="download-btn lightbox-download"
                    @click.stop
                >
                    ⬇ Download
                </a>
            </div>
        </div>
    </div>
</div>

<script is:inline>
    // is:inline matters here: without it, Astro bundles this as a
    // deferred ES module, which (in dev especially) can finish loading
    // and run AFTER Alpine's own CDN script has already auto-started
    // and walked the DOM — by then it's too late to register
    // "mainMenuSlider" and every x-data/x-bind on this component fails
    // with "mainMenuSlider is not defined". is:inline keeps this as a
    // plain classic script that runs in document order, ahead of
    // Alpine's `defer`red start, so the registration always wins the race.
    //
    // Also: is:inline scripts are injected verbatim (no TypeScript
    // transform), so this file is plain JS on purpose.
    document.addEventListener("alpine:init", () => {
        Alpine.data("mainMenuSlider", (menuParts = []) => ({
            menuParts,
            currentIndex: 0,
            lightboxOpen: false,
            lightboxIndex: 0,

            goToSlide(index) {
                this.currentIndex = index;
            },
            nextSlide() {
                this.currentIndex =
                    (this.currentIndex + 1) % this.menuParts.length;
            },
            prevSlide() {
                this.currentIndex =
                    (this.currentIndex - 1 + this.menuParts.length) %
                    this.menuParts.length;
            },
            openLightbox(index) {
                this.lightboxOpen = true;
                this.lightboxIndex = index;
            },
            closeLightbox() {
                this.lightboxOpen = false;
            },
        }));
    });
</script>
