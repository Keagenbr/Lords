---
import mainMenu from "../../data/main-menu.json";
import specials from "../../data/specials.json";
import drinks from "../../data/drinks.json";
import MenuSection from "../../components/Menu/MenuSection.astro";

const menus = [
    { id: "main", title: mainMenu.meta.title, data: mainMenu },
    { id: "specials", title: specials.meta.title, data: specials },
    { id: "drinks", title: drinks.meta.title, data: drinks },
];
---

<header>
    <!-- Menu Switcher -->
    <nav id="menu-tabs">
        {
            menus.map((m, index) => (
                <button
                    class={'rab-btn ${index === 0 ? "active" : ""} '}
                    data-menu={m.id}
                >
                    {m.title}
                </button>
            ))
        }
    </nav>
    <!-- Live Search Bar -->
    <div class="search-container">
        <input
            type="text"
            id="menu-search"
            placeholder="Search menu items..."
        />
    </div>
</header>

<main>
    {
        menus.map((m, index) => (
            <div
                class={`menu-group ${index === 0 ? "active" : "hidden"}`}
                id={`menu-${m.id}`}
            >
                {m.data.categories.map((cat) => (
                    <MenuSection
                        category={cat}
                        currency={m.data.meta.currency}
                    />
                ))}
            </div>
        ))
    }
</main>

<script>
    // Switch active menu (Main / Specials / Drinks)
    const tabs = document.querySelectorAll(".tab-btn");
    const menuGroups = document.querySelectorAll(".menu-group");

    tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
            const target = tab.getAttribute("data-menu");

            tabs.forEach((t) => t.classList.remove("active"));
            tab.classList.add("active");

            menuGroups.forEach((group) => {
                if (group.id === `menu-${target}`) {
                    group.classList.remove("hidden");
                    group.classList.add("active");
                } else {
                    group.classList.add("hidden");
                    group.classList.remove("active");
                }
            });
        });
    });

    // Filter items live using input search
    const searchInput = document.getElementById(
        "menu-search",
    ) as HTMLInputElement;

    searchInput?.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        const items = document.querySelectorAll(".menu-item");

        items.forEach((item) => {
            const name = item.getAttribute("data-name") || "";
            const tags = item.getAttribute("data-tags") || "";
            const match = name.includes(query) || tags.includes(query);

            (item as HTMLElement).style.display = match ? "block" : "none";
        });
    });
</script>
<!-- <script src="../../lib/nav.ts"></script> -->
<style>
    .hidden {
        display: none;
    }
    .tab-btn.active {
        font-weight: bold;
        border-bottom: 2px solid #000;
    }
    .menu-group {
        margin-top: 20px;
    }
    .menu-item {
        margin-bottom: 15px;
        border-bottom: 1px dashed #ccc;
        padding-bottom: 10px;
    }
    .item-header {
        display: flex;
        gap: 10px;
        align-items: baseline;
    }
    .item-prices {
        margin-left: auto;
    }
    .price {
        font-weight: bold;
        margin-left: 10px;
    }
    .tag {
        background: #eee;
        padding: 2px 6px;
        font-size: 0.8rem;
        border-radius: 4px;
    }
    .category-note {
        color: #666;
        font-size: 0.9rem;
    }
</style>
