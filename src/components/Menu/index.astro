---
import { getMenu, type MenuType } from "../../lib/menu";

let menuData: MenuType[] = [];

try {
    menuData = await getMenu();
} catch (e) {
    console.error("Failed to load menu from Supabase:", e);
}

// Serialized for potential client-side search later
const menuJson = JSON.stringify(menuData);
---

<div class="menu-container" x-data="menuApp" data-menu={menuJson}>
    <div class="menu-header">
        <h1>Lords & Legends Menu</h1>
        <p class="tagline">Good times. Cold drinks. Great company.</p>
    </div>

    <!-- Search -->
    <div class="search-box">
        <input
            type="text"
            x-model="search"
            placeholder="Search menu items..."
            class="search-input"
        />
    </div>

    <!-- Type tabs -->
    <div class="filter-buttons">
        <button
            class="filter-btn"
            :class="{ active: selectedType === 'all' }"
            @click="selectedType = 'all'"
        >
            All
        </button>
        <template x-for="t in types" :key="t.id">
            <button
                class="filter-btn"
                :class="{ active: selectedType === t.id }"
                @click="selectedType = t.id"
                x-text="t.label"
            ></button>
        </template>
    </div>

    <!-- Rendered server-side sections, filtered client-side -->
    <template x-for="type in filteredMenu" :key="type.id">
        <section class="menu-type-section">
            <h2 x-text="type.label"></h2>

            <!-- Category-level image (clickable + downloadable) -->
            <template x-for="cat in type.categories" :key="cat.id">
                <div class="category-block">
                    <h3 x-text="cat.label.replace(/_/g, ' ')"></h3>

                    <template x-if="cat.image_url">
                        <div class="menu-image-wrapper">
                            <img
                                :src="cat.image_url"
                                :alt="cat.label + ' menu'"
                                class="menu-image"
                                @click="openLightbox(cat.image_url)"
                            />
                            <a
                                :href="cat.image_url"
                                :download="cat.label + '-menu'"
                                class="download-btn"
                                target="_blank"
                                rel="noopener"
                            >
                                ⬇ Download Menu
                            </a>
                        </div>
                    </template>

                    <ul class="item-list">
                        <template
                            x-for="item in filteredItems(cat)"
                            :key="item.id"
                        >
                            <li class="menu-item">
                                <div class="item-line">
                                    <span
                                        class="item-name"
                                        x-text="item.name"
                                    ></span>
                                    <span class="dots"></span>
                                    <span
                                        class="price"
                                        x-text="item.price || ''"
                                    ></span>
                                </div>
                                <p
                                    class="description"
                                    x-show="item.description"
                                    x-text="item.description"
                                ></p>
                                <span
                                    class="serves"
                                    x-show="item.serves"
                                    x-text="item.serves"
                                ></span>
                            </li>
                        </template>
                    </ul>
                </div>
            </template>
        </section>
    </template>

    <!-- Empty state -->
    <div class="empty-state" x-show="!hasResults">
        <p>No items found matching your search.</p>
        <button class="reset-btn" @click="search = ''; selectedType = 'all'">
            Reset Filters
        </button>
    </div>

    <!-- Lightbox -->
    <div class="lightbox" x-show="lightboxOpen" @click="lightboxOpen = false">
        <img :src="lightboxSrc" alt="Menu" />
        <a
            class="download-btn lightbox-download"
            :href="lightboxSrc"
            download
            @click.stop
        >
            ⬇ Download
        </a>
        <button class="close-btn" @click="lightboxOpen = false">
            &times;
        </button>
    </div>
</div>

<script>
    document.addEventListener("alpine:init", () => {
        Alpine.data("menuApp", () => ({
            menu: JSON.parse(
                document.querySelector("[data-menu]").dataset.menu,
            ),
            search: "",
            selectedType: "all",
            lightboxOpen: false,
            lightboxSrc: "",

            get types() {
                return this.menu.map((t) => ({ id: t.id, label: t.label }));
            },

            get filteredMenu() {
                return this.menu
                    .filter(
                        (t) =>
                            this.selectedType === "all" ||
                            t.id === this.selectedType,
                    )
                    .map((t) => ({
                        ...t,
                        categories: t.categories.filter(
                            (c) =>
                                this.filteredItems(c).length > 0 || c.image_url,
                        ),
                    }))
                    .filter((t) => t.categories.length > 0);
            },

            get hasResults() {
                return this.filteredMenu.some(
                    (t) =>
                        t.categories.some(
                            (c) => this.filteredItems(c).length > 0,
                        ) || t.categories.some((c) => c.image_url),
                );
            },

            filteredItems(cat) {
                const q = this.search.toLowerCase();
                return cat.items.filter(
                    (i) =>
                        i.name.toLowerCase().includes(q) ||
                        (i.description || "").toLowerCase().includes(q),
                );
            },

            openLightbox(src) {
                this.lightboxSrc = src;
                this.lightboxOpen = true;
            },
        }));
    });
</script>

<style>
    .menu-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
    }
    .menu-header {
        text-align: center;
        margin-bottom: 2rem;
    }
    .menu-header h1 {
        font-size: 2.5rem;
        color: #1a365d;
    }
    .tagline {
        color: #718096;
        font-style: italic;
    }

    .search-box {
        margin-bottom: 1rem;
    }
    .search-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 1rem;
    }

    .filter-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2rem;
        justify-content: center;
    }
    .filter-btn {
        padding: 0.5rem 1.25rem;
        border: 2px solid #e2e8f0;
        background: white;
        border-radius: 20px;
        cursor: pointer;
        font-size: 0.9rem;
    }
    .filter-btn.active {
        background: #2b6cb0;
        color: white;
        border-color: #2b6cb0;
    }

    .menu-type-section {
        margin-bottom: 3rem;
    }
    .menu-type-section h2 {
        font-size: 1.8rem;
        color: #1a365d;
        border-bottom: 3px solid #2b6cb0;
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .category-block {
        margin-bottom: 2rem;
    }
    .category-block h3 {
        font-size: 1.2rem;
        color: #2b6cb0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
    }

    .menu-image-wrapper {
        margin-bottom: 1rem;
        text-align: center;
    }
    .menu-image {
        max-width: 100%;
        border-radius: 12px;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        transition: transform 0.2s;
    }
    .menu-image:hover {
        transform: scale(1.02);
    }
    .download-btn {
        display: inline-block;
        margin-top: 0.5rem;
        padding: 0.4rem 1rem;
        background: #2b6cb0;
        color: white;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.85rem;
    }
    .download-btn:hover {
        background: #2c5282;
    }

    .item-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .menu-item {
        margin-bottom: 0.75rem;
    }
    .item-line {
        display: flex;
        align-items: baseline;
    }
    .item-name {
        font-weight: 600;
        color: #2d3748;
    }
    .dots {
        flex: 1;
        border-bottom: 1px dotted #cbd5e0;
        margin: 0 0.5rem;
    }
    .price {
        font-weight: 700;
        color: #2b6cb0;
        white-space: nowrap;
    }
    .description {
        color: #4a5568;
        font-size: 0.875rem;
        margin: 0.25rem 0 0;
    }
    .serves {
        font-size: 0.75rem;
        color: #718096;
        font-style: italic;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #718096;
    }
    .reset-btn {
        margin-top: 1rem;
        padding: 0.6rem 1.25rem;
        background: #4299e1;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        cursor: pointer;
    }
    .lightbox img {
        max-width: 90%;
        max-height: 85vh;
        border-radius: 8px;
    }
    .lightbox-download {
        position: absolute;
        bottom: 2rem;
    }
    .close-btn {
        position: absolute;
        top: 1rem;
        right: 1.5rem;
        font-size: 2.5rem;
        color: white;
        background: none;
        border: none;
        cursor: pointer;
    }
</style>
