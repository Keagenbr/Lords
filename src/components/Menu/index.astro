---
import mainMenu from "./data/main-menu.json";
import specials from "./data/specials.json";
import drinks from "./data/drinks.json";
import MenuSection from "./MenuSection.astro";

const menus = [
    { id: "main", title: mainMenu.meta.title, data: mainMenu },
    { id: "specials", title: specials.meta.title, data: specials },
    { id: "drinks", title: drinks.meta.title, data: drinks },
];
---

<header>
    <!-- Menu Switcher -->
    <nav id="menu-tabs">
        {menus.map((m, index) => (
            <button
                class={'rab-btn ${index === 0 ? "active" : ""} '}
                data-menu={m.id}
            >
                {m.title}
            </button>
        ))}
    </nav>
    <!-- Live Search Bar -->
    <div class="search-container">
        <input
            type="text"
            id="menu-search"
            placeholder="Search menu items..."
        />
    </div>
</header>
