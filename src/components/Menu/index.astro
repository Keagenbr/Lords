---
import { getMenu, type MenuType } from "../../lib/menu";

let menuData: MenuType[] = [];

try {
    menuData = await getMenu();
} catch (e) {
    console.error("Failed to load menu from Supabase:", e);
}

// Serialized for client-side reactive rendering
const menuJson = JSON.stringify(menuData);

// ─────────────────────────────────────────────────────────────
// WHATSAPP ORDERING CONFIG
// ─────────────────────────────────────────────────────────────
const WHATSAPP_NUMBER = "27626685787";
const RESTAURANT_NAME = "Lords & Legends";
---

<section
    class="menu-container"
    x-data="menuApp"
    data-menu={menuJson}
    data-whatsapp={WHATSAPP_NUMBER}
    data-restaurant={RESTAURANT_NAME}
>
    <div class="menu-header">
        <h1>Lords & Legends Menu</h1>
        <p class="tagline">Good times. Cold drinks. Great company.</p>
    </div>

    <!-- Search input -->
    <div class="search-box">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input
            type="text"
            x-model="search"
            placeholder="Search menu items or descriptions..."
            class="search-input"
        />
        <button
            x-show="search.length > 0"
            @click="search = ''"
            class="clear-search-btn"
            title="Clear search"
        >
            ✕
        </button>
    </div>

    <!-- Type filter tabs -->
    <div class="filter-buttons">
        <button
            class="filter-btn"
            :class="{ active: selectedType === 'all' }"
            @click="selectedType = 'all'"
        >
            <i class="fa-solid fa-utensils"></i> All
        </button>
        <template x-for="t in types" :key="t.id">
            <button
                class="filter-btn"
                :class="{ active: selectedType === t.id }"
                @click="selectedType = t.id"
            >
                <i :class="getTypeIcon(t.id)"></i>
                <span x-text="t.label"></span>
            </button>
        </template>
    </div>

    <!-- Rendered server-side sections, filtered client-side -->
    <template x-for="type in filteredMenu" :key="type.id">
        <section class="menu-type-section" :id="'type-' + type.id">
            <h2 class="type-header">
                <i :class="getTypeIcon(type.id)"></i>
                <span x-text="type.label"></span>
            </h2>

            <template x-for="cat in type.categories" :key="cat.id">
                <div
                    class="category-block"
                    :id="'cat-' + cat.id"
                    :class="{ 'is-open': isCategoryOpen(cat.id) }"
                >
                    <!-- Toggleable Dropdown Header -->
                    <button
                        type="button"
                        class="category-header"
                        @click="toggleCategory(cat.id)"
                        :aria-expanded="isCategoryOpen(cat.id)"
                    >
                        <div class="category-title">
                            <!-- Category Image / Drink Logo -->
                            <img
                                :src="getCategoryImage(cat)"
                                :alt="cat.label"
                                class="category-logo"
                                loading="lazy"
                            />
                            <span x-text="cat.label.replace(/_/g, ' ')"></span>
                        </div>

                        <div class="category-meta">
                            <span
                                class="item-count-badge"
                                x-text="filteredItems(cat).length + ' items'"
                            ></span>
                            <i
                                class="fa-solid chevron-icon"
                                :class="isCategoryOpen(cat.id) ? 'fa-chevron-up' : 'fa-chevron-down'"
                            ></i>
                        </div>
                    </button>

                    <!-- Collapsible Category Items Grid -->
                    <div
                        class="category-content"
                        x-show="isCategoryOpen(cat.id)"
                        x-collapse
                    >
                        <ul class="item-list">
                            <template
                                x-for="item in filteredItems(cat)"
                                :key="item.id"
                            >
                                <li class="menu-item">
                                    <div class="item-layout">
                                        <!-- Item Image Thumbnail -->
                                        <div
                                            class="item-thumb-wrapper"
                                            x-show="getItemImage(item)"
                                        >
                                            <img
                                                :src="getItemImage(item)"
                                                :alt="item.name"
                                                class="item-thumb"
                                                loading="lazy"
                                            />
                                        </div>

                                        <div class="item-details">
                                            <div class="item-line">
                                                <span
                                                    class="item-name"
                                                    x-text="item.name"
                                                ></span>
                                                <span class="dots"></span>
                                                <span
                                                    class="price"
                                                    x-text="item.price || ''"
                                                ></span>
                                            </div>
                                            <p
                                                class="description"
                                                x-show="item.description"
                                                x-text="item.description"
                                            ></p>
                                            <div class="item-tags">
                                                <span
                                                    class="serves-tag"
                                                    x-show="item.serves"
                                                    x-text="item.serves"
                                                ></span>
                                                <span
                                                    class="dine-in-tag"
                                                    x-show="item.takeaway === false"
                                                >
                                                    <i class="fa-solid fa-chair"></i>{" "}
                                                    Dine-in only
                                                </span>
                                            </div>

                                            <button
                                                class="add-btn"
                                                x-show="isOrderable(item, type.id)"
                                                @click="openItemModal(item)"
                                            >
                                                <i class="fa-solid fa-plus"></i>{" "}
                                                Add to order
                                            </button>
                                        </div>
                                    </div>
                                </li>
                            </template>
                        </ul>
                    </div>
                </div>
            </template>
        </section>
    </template>

    <!-- Empty state -->
    <div class="empty-state" x-show="!hasResults">
        <i class="fa-solid fa-utensils-slash empty-icon"></i>
        <p>No menu items match your search.</p>
        <button class="reset-btn" @click="search = ''; selectedType = 'all'">
            Reset Filters
        </button>
    </div>

    <!-- ITEM MODAL -->
    <div
        class="modal-overlay"
        x-show="showItemModal"
        x-cloak
        @click.self="closeItemModal"
    >
        <div class="modal-box" x-show="showItemModal" x-transition>
            <template x-if="activeItem">
                <div>
                    <!-- Optional item image inside modal -->
                    <div
                        class="modal-item-img-container"
                        x-show="getItemImage(activeItem)"
                    >
                        <img
                            :src="getItemImage(activeItem)"
                            :alt="activeItem.name"
                            class="modal-item-img"
                        />
                    </div>

                    <h3 x-text="activeItem.name"></h3>
                    <p class="modal-price" x-text="activeItem.price || ''"></p>

                    <!-- Option groups -->
                    <template
                        x-for="group in (activeItem.option_groups || [])"
                        :key="group.key"
                    >
                        <div class="modal-field">
                            <label x-text="group.label"></label>
                            <div class="choice-group">
                                <template
                                    x-for="opt in group.options"
                                    :key="opt"
                                >
                                    <label class="choice-pill">
                                        <input
                                            type="radio"
                                            :name="group.key"
                                            :value="opt"
                                            x-model="modalChoices[group.key]"
                                        />
                                        <span x-text="opt"></span>
                                    </label>
                                </template>
                            </div>
                        </div>
                    </template>

                    <!-- Quantity -->
                    <div class="modal-field">
                        <label>Quantity</label>
                        <div class="qty-stepper">
                            <button
                                type="button"
                                @click="modalQty = Math.max(1, modalQty - 1)"
                            >
                                −
                            </button>
                            <span x-text="modalQty"></span>
                            <button type="button" @click="modalQty++">
                                +
                            </button>
                        </div>
                    </div>

                    <!-- Note -->
                    <div class="modal-field">
                        <label>Any specifications? (optional)</label>
                        <textarea
                            x-model="modalNote"
                            placeholder="e.g. no onions, extra spicy, allergy info..."
                            rows="2"
                        ></textarea>
                    </div>

                    <div class="modal-actions">
                        <button class="cancel-btn" @click="closeItemModal">
                            Cancel
                        </button>
                        <button class="confirm-btn" @click="confirmAddToCart">
                            Add to order
                        </button>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <!-- FLOATING CART FAB + ORDER PANEL -->
    <button
        class="cart-fab"
        x-show="cart.length > 0"
        x-cloak
        @click="showCartPanel = true"
    >
        <i class="fa-solid fa-cart-shopping"></i> View Order (
        <span x-text="cartCount"></span>)
    </button>

    <div
        class="modal-overlay"
        x-show="showCartPanel"
        x-cloak
        @click.self="showCartPanel = false"
    >
        <div class="modal-box cart-panel" x-show="showCartPanel" x-transition>
            <h3>
                <i class="fa-solid fa-receipt"></i> Your Order
            </h3>

            <div class="empty-cart" x-show="cart.length === 0">
                <p>Your order is empty.</p>
            </div>

            <ul class="cart-list" x-show="cart.length > 0">
                <template x-for="(line, index) in cart" :key="index">
                    <li class="cart-line">
                        <div class="cart-line-top">
                            <span x-text="line.qty + 'x ' + line.name"></span>
                            <button
                                class="remove-btn"
                                @click="removeFromCart(index)"
                            >
                                ✕
                            </button>
                        </div>
                        <div class="cart-line-details">
                            <template
                                x-for="opt in line.options"
                                :key="opt.label"
                            >
                                <span x-text="opt.label + ': ' + opt.value"></span>
                            </template>
                            <span x-show="line.note">
                                Note: <span x-text="line.note"></span>
                            </span>
                        </div>
                    </li>
                </template>
            </ul>

            <div class="modal-field">
                <label>Name for order</label>
                <input
                    type="text"
                    x-model="orderName"
                    placeholder="Your name"
                />
            </div>
            <div class="modal-field">
                <label>Collection time</label>
                <input
                    type="time"
                    x-model="collectTime"
                    placeholder="Leave blank for collection in 20-30 mins"
                />
            </div>

            <p class="cart-total" x-show="cartTotal > 0">
                Estimated Total: R<span x-text="cartTotal.toFixed(2)"></span>
            </p>

            <div class="modal-actions">
                <button class="cancel-btn" @click="showCartPanel = false">
                    Keep browsing
                </button>
                <button
                    class="confirm-btn whatsapp-btn"
                    :disabled="cart.length === 0"
                    @click="sendOrderViaWhatsApp"
                >
                    <i class="fa-brands fa-whatsapp"></i> Send Order via
                    WhatsApp
                </button>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener("alpine:init", () => {
        Alpine.data("menuApp", () => ({
            menu: JSON.parse(
                document.querySelector("[data-menu]").dataset.menu || "[]",
            ),
            whatsappNumber:
                document.querySelector("[data-whatsapp]").dataset.whatsapp,
            restaurantName:
                document.querySelector("[data-restaurant]").dataset.restaurant,

            search: "",
            selectedType: "all",

            // Open/closed state per category ID
            openCategories: {},

            EXCLUDED_ORDER_TYPES: ["drinks", "specials"],

            // Item modal state
            showItemModal: false,
            activeItem: null,
            modalChoices: {},
            modalQty: 1,
            modalNote: "",

            // Cart state
            cart: [],
            showCartPanel: false,
            orderName: "",
            collectTime: "",

            init() {
                // Initialize default category dropdown states (all expanded initially or default state)
                this.menu.forEach((t) => {
                    t.categories.forEach((c) => {
                        this.openCategories[c.id] = true;
                    });
                });

                // The navigation links here as /menu#type-<id> and
                // /menu#cat-<id>: show that section and scroll to it, both
                // on page load and when the link is used on this page.
                this.applyHash();
                window.addEventListener("hashchange", () => this.applyHash());
            },

            applyHash() {
                const hash = decodeURIComponent(
                    window.location.hash.replace(/^#/, ""),
                );
                let targetId = null;

                if (hash.startsWith("cat-")) {
                    const catId = hash.slice(4);
                    const type = this.menu.find((t) =>
                        t.categories.some((c) => String(c.id) === catId),
                    );
                    if (!type) return;
                    this.selectedType = type.id;
                    this.openCategories[catId] = true;
                    targetId = hash;
                } else if (hash.startsWith("type-")) {
                    const type = this.menu.find(
                        (t) => String(t.id) === hash.slice(5),
                    );
                    if (!type) return;
                    this.selectedType = type.id;
                    targetId = hash;
                } else {
                    return;
                }

                this.search = "";
                // Wait for the filtered list to render before scrolling.
                setTimeout(() => {
                    document
                        .getElementById(targetId)
                        ?.scrollIntoView({ behavior: "smooth", block: "start" });
                }, 60);
            },

            get types() {
                return this.menu.map((t) => ({ id: t.id, label: t.label }));
            },

            get filteredMenu() {
                return this.menu
                    .filter(
                        (t) =>
                            this.selectedType === "all" ||
                            t.id === this.selectedType,
                    )
                    .map((t) => ({
                        ...t,
                        categories: t.categories.filter(
                            (c) => this.filteredItems(c).length > 0,
                        ),
                    }))
                    .filter((t) => t.categories.length > 0);
            },

            get hasResults() {
                return this.filteredMenu.some((t) =>
                    t.categories.some((c) => this.filteredItems(c).length > 0),
                );
            },

            filteredItems(cat) {
                const q = this.search.trim().toLowerCase();
                if (!q) return cat.items;
                return cat.items.filter(
                    (i) =>
                        i.name.toLowerCase().includes(q) ||
                        (i.description || "").toLowerCase().includes(q),
                );
            },

            // Dropdown Toggle Logic
            toggleCategory(catId) {
                this.openCategories[catId] = !this.openCategories[catId];
            },

            isCategoryOpen(catId) {
                // Always expand dropdowns when active search is entered
                if (this.search.trim().length > 0) return true;
                return !!this.openCategories[catId];
            },

            // Category Drink Logos & Fallback Images
            getCategoryImage(cat) {
                if (cat.image_url) {
                    if (
                        cat.image_url.startsWith("http") ||
                        cat.image_url.startsWith("/")
                    ) {
                        return cat.image_url;
                    }
                    return `https://xwpwssyoetlphadybtsx.supabase.co/storage/v1/object/public/LordsImg/Categories/${cat.image_url}`;
                }

                // Temp placeholder icons matching drinks & food styling
                const categoryLogos = {
                    drinks_beer:
                        "https://images.unsplash.com/photo-1608270586620-248524c67de9?w=120&auto=format&fit=crop&q=80",
                    drinks_ciders:
                        "https://images.unsplash.com/photo-1560512823-829485b8bf24?w=120&auto=format&fit=crop&q=80",
                    drinks_cocktails:
                        "https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=120&auto=format&fit=crop&q=80",
                    drinks_cooldrinks:
                        "https://images.unsplash.com/photo-1622483767028-3f66f32aef97?w=120&auto=format&fit=crop&q=80",
                    drinks_energy_drinks:
                        "https://images.unsplash.com/photo-1622543925917-763c34d1a86e?w=120&auto=format&fit=crop&q=80",
                    drinks_hot_drinks:
                        "https://images.unsplash.com/photo-1541167760496-1628856ab772?w=120&auto=format&fit=crop&q=80",
                    drinks_other_wine:
                        "https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?w=120&auto=format&fit=crop&q=80",
                    drinks_shooters_mixed:
                        "https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?w=120&auto=format&fit=crop&q=80",
                    drinks_shooters_single:
                        "https://images.unsplash.com/photo-1527281400683-1aae777175f8?w=120&auto=format&fit=crop&q=80",
                    drinks_water:
                        "https://images.unsplash.com/photo-1548839140-29a749e1bc4e?w=120&auto=format&fit=crop&q=80",
                    drinks_wine_by_carafe:
                        "https://images.unsplash.com/photo-1558001373-a1286be6b208?w=120&auto=format&fit=crop&q=80",
                    drinks_wine_by_glass:
                        "https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?w=120&auto=format&fit=crop&q=80",
                    food_smash_burgers:
                        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=120&auto=format&fit=crop&q=80",
                    food_all_day_breakfast:
                        "https://images.unsplash.com/photo-1533089860892-a7c6f0a88666?w=120&auto=format&fit=crop&q=80",
                    food_pub_grub:
                        "https://images.unsplash.com/photo-1544025162-d76694265947?w=120&auto=format&fit=crop&q=80",
                    platters_all:
                        "https://images.unsplash.com/photo-1541529086526-db283c563270?w=120&auto=format&fit=crop&q=80",
                    specials_all:
                        "https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=120&auto=format&fit=crop&q=80",
                };

                return (
                    categoryLogos[cat.id] ||
                    "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=120&auto=format&fit=crop&q=80"
                );
            },

            // Menu Item Image Logic with temp placeholder fallback
            getItemImage(item) {
                if (item.image_url) {
                    if (
                        item.image_url.startsWith("http") ||
                        item.image_url.startsWith("/")
                    ) {
                        return item.image_url;
                    }
                    return `https://xwpwssyoetlphadybtsx.supabase.co/storage/v1/object/public/LordsImg/MenuItems/${item.image_url}`;
                }

                // Temporary styled placeholders for items without Supabase URLs
                const defaultItemPlaceholders = {
                    drinks_beer:
                        "https://images.unsplash.com/photo-1608270586620-248524c67de9?w=200&auto=format&fit=crop&q=80",
                    drinks_cocktails:
                        "https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=200&auto=format&fit=crop&q=80",
                    drinks_ciders:
                        "https://images.unsplash.com/photo-1560512823-829485b8bf24?w=200&auto=format&fit=crop&q=80",
                    food_smash_burgers:
                        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=200&auto=format&fit=crop&q=80",
                    food_loaded_fries:
                        "https://images.unsplash.com/photo-1576107232684-1279f3908594?w=200&auto=format&fit=crop&q=80",
                    food_salads_and_starters:
                        "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=200&auto=format&fit=crop&q=80",
                };

                return defaultItemPlaceholders[item.category_id] || null;
            },

            getTypeIcon(typeId) {
                const icons = {
                    food: "fa-solid fa-burger",
                    drinks: "fa-solid fa-beer-mug-empty",
                    platters: "fa-solid fa-utensils",
                    specials: "fa-solid fa-star",
                };
                return icons[typeId] || "fa-solid fa-list";
            },

            isOrderable(item, typeId) {
                if (this.EXCLUDED_ORDER_TYPES.includes(typeId)) return false;
                if (item.takeaway === false) return false;
                return true;
            },

            openItemModal(item) {
                this.activeItem = item;
                this.modalChoices = {};
                (item.option_groups || []).forEach((group) => {
                    this.modalChoices[group.key] = group.options[0] || "";
                });
                this.modalQty = 1;
                this.modalNote = "";
                this.showItemModal = true;
            },

            closeItemModal() {
                this.showItemModal = false;
                this.activeItem = null;
            },

            confirmAddToCart() {
                if (!this.activeItem) return;
                const options = (this.activeItem.option_groups || [])
                    .map((group) => ({
                        label: group.label,
                        value: this.modalChoices[group.key],
                    }))
                    .filter((o) => o.value);

                this.cart.push({
                    name: this.activeItem.name,
                    price: this.activeItem.price || "",
                    priceValue: this.parsePrice(this.activeItem.price),
                    options,
                    note: this.modalNote.trim(),
                    qty: this.modalQty,
                });
                this.closeItemModal();
                this.showCartPanel = true;
            },

            removeFromCart(index) {
                this.cart.splice(index, 1);
            },

            parsePrice(priceStr) {
                if (!priceStr) return 0;
                const n = parseFloat(String(priceStr).replace(/[^0-9.]/g, ""));
                return isNaN(n) ? 0 : n;
            },

            get cartCount() {
                return this.cart.reduce((sum, l) => sum + l.qty, 0);
            },

            get cartTotal() {
                return this.cart.reduce(
                    (sum, l) => sum + l.priceValue * l.qty,
                    0,
                );
            },

            buildOrderMessage() {
                const lines = [];
                lines.push(`*NEW ORDER – ${this.restaurantName}*`);
                lines.push(`Name: ${this.orderName || "(not given)"}`);
                lines.push(
                    `Collection time: ${this.collectTime || "(Asap - 20 to 30 mins)"}`,
                );
                lines.push("");

                this.cart.forEach((line) => {
                    let itemLine = `${line.qty}x ${line.name}`;
                    if (line.price) itemLine += ` (${line.price})`;
                    lines.push(itemLine);
                    (line.options || []).forEach((opt) => {
                        lines.push(`   • ${opt.label}: ${opt.value}`);
                    });
                    if (line.note) lines.push(`   • Note: ${line.note}`);
                });

                if (this.cartTotal > 0) {
                    lines.push("");
                    lines.push(
                        `*Estimated Total: R${this.cartTotal.toFixed(2)}*`,
                    );
                }

                return lines.join("\n");
            },

            sendOrderViaWhatsApp() {
                if (this.cart.length === 0) return;
                const message = this.buildOrderMessage();
                const url = `https://wa.me/${this.whatsappNumber}?text=${encodeURIComponent(message)}`;
                window.open(url, "_blank");
            },
        }));
    });
</script>

<style>
    [x-cloak] {
        display: none !important;
    }

    /* Keep jump targets (from the navigation) clear of the fixed header. */
    .menu-type-section,
    .category-block {
        scroll-margin-top: calc(var(--nav-header) + 1rem);
    }

    @media (max-width: 768px) {
        .menu-type-section,
        .category-block {
            scroll-margin-top: calc(var(--nav-headerM) + 1rem);
        }
    }

    .menu-container {
        max-width: 960px;
        margin: 0 auto;
        margin-top: calc(var(--nav-headerM) + 1.5rem);
        padding: 1.5rem;
        color: var(--txt-color);
    }

    .menu-header {
        text-align: center;
        margin-bottom: 2rem;
    }
    .menu-header h1 {
        font-size: 2.25rem;
        color: var(--bg-color-btn);
        margin: 0 0 0.25rem;
        font-weight: 800;
        letter-spacing: -0.02em;
    }
    .tagline {
        color: var(--text-color-hover);
        font-style: italic;
        font-size: 1.05rem;
        margin: 0;
    }

    /* Search Box */
    .search-box {
        position: relative;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
    }
    .search-icon {
        position: absolute;
        left: 1rem;
        color: var(--bg-color-btn);
        opacity: 0.7;
    }
