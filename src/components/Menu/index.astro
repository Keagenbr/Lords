---
import { getMenu, type MenuType } from "../../lib/menu";
import {
    getWhatsAppNumber,
    PLATTER_NOTICE_DAYS,
    PLATTER_NOTICE_TITLE,
    PLATTER_NOTICE_TEXT,
} from "../../lib/siteInfo";

// Owner-editable via /admin/settings — see src/lib/siteSettings.ts.
const whatsappNumber = await getWhatsAppNumber();

let menuData: MenuType[] = [];

try {
    menuData = await getMenu();
} catch (e) {
    console.error("Failed to load menu from Supabase:", e);
}

// Serialized for client-side reactive rendering
const menuJson = JSON.stringify(menuData);

// ─────────────────────────────────────────────────────────────
// WHATSAPP ORDERING CONFIG  (number / name / platter notice: src/lib/siteInfo.ts)
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// SPECIALS SUB-CATEGORIES
// If the "specials" type only has ONE category in Supabase, its items are
// split into the groups below. The first group whose `match` (a
// case-insensitive regular expression, tested against the item name,
// description and original category name) fits wins; items that match nothing
// go to the group with `match: null`.
// If you later create separate specials categories in Supabase, this is
// skipped automatically and your categories are shown as they are.
// ─────────────────────────────────────────────────────────────
const SPECIALS_GROUPS = [
    {
        id: "specials_r150",
        label: "R150 Deals",
        match: "r\\s?150|150\\s?deals?|one\\s?five\\s?o",
    },
    {
        id: "specials_drinks",
        label: "Drink Specials",
        match: "\\bdrinks?\\b|shooters?|\\bshots?\\b|\\bgin\\b|vodka|whisk(e)?y|\\brum\\b|brandy|tequila|j(a|ä)ger|beers?\\b|lager|draught|\\bpints?\\b|cider|cocktails?|\\bwine\\b|carafe|mojito|margarita|g\\s?(&|and)\\s?t\\b|tonic",
    },
    { id: "specials_daily", label: "Daily Specials", match: null },
];

const platterNotice = {
    days: PLATTER_NOTICE_DAYS,
    title: PLATTER_NOTICE_TITLE,
    text: PLATTER_NOTICE_TEXT,
};
---

<section
    class="menu-container"
    x-data="menuApp"
    data-menu={menuJson}
    data-whatsapp={whatsappNumber}
    data-specials-groups={JSON.stringify(SPECIALS_GROUPS)}
    data-platter-notice={JSON.stringify(platterNotice)}
>
    <div class="menu-header">
        <h1>Lords & Legends Menu</h1>
        <p class="tagline">Good times. Cold drinks. Great company.</p>
    </div>

    <!-- Search input -->
    <div class="search-box">
        <span
            class="search-icon ico-only"
            data-icon="search"
            aria-hidden="true"
        ></span>
        <input
            type="text"
            x-model="search"
            placeholder="Search menu items or descriptions..."
            class="search-input"
        />
        <button
            x-show="search.length > 0"
            @click="search = ''"
            class="clear-search-btn"
            title="Clear search"
        >
            ✕
        </button>
    </div>

    <!-- Type filter tabs -->
    <div class="filter-buttons">
        <button
            class="filter-btn"
            data-icon="all"
            :class="{ active: selectedType === 'all' }"
            @click="selectedType = 'all'"
        >
            All
        </button>
        <template x-for="t in types" :key="t.id">
            <button
                class="filter-btn"
                :data-icon="t.id"
                :class="{ active: selectedType === t.id }"
                @click="selectedType = t.id"
            >
                <span x-text="t.label"></span>
            </button>
        </template>
    </div>

    <!-- Rendered server-side sections, filtered client-side -->
    <template x-for="type in filteredMenu" :key="type.id">
        <section class="menu-type-section" :id="'type-' + type.id">
            <h2 class="type-header" :data-icon="type.id">
                <span x-text="type.label"></span>
            </h2>

            <template x-for="cat in type.categories" :key="cat.id">
                <div
                    class="category-block"
                    :id="'cat-' + cat.id"
                    :class="{ 'is-open': isCategoryOpen(cat.id) }"
                >
                    <!-- Toggleable Dropdown Header -->
                    <button
                        type="button"
                        class="category-header"
                        @click="toggleCategory(cat.id)"
                        :aria-expanded="isCategoryOpen(cat.id)"
                    >
                        <div class="category-title">
                            <!-- Category Image / Drink Logo -->
                            <img
                                :src="getCategoryImage(cat)"
                                :alt="cat.label"
                                class="category-logo"
                                loading="lazy"
                            />
                            <span x-text="cat.label.replace(/_/g, ' ')"></span>
                        </div>

                        <div class="category-meta">
                            <span
                                class="item-count-badge"
                                x-text="filteredItems(cat).length + ' items'"
                            ></span>
                            <span
                                class="chevron-icon ico-only"
                                data-icon="double-chevron-down"
                                :class="{ 'is-open': isCategoryOpen(cat.id) }"
                                aria-hidden="true"
                            ></span>
                        </div>
                    </button>

                    <!-- Collapsible Category Items Grid -->
                    <div
                        class="category-content"
                        x-show="isCategoryOpen(cat.id)"
                        x-collapse
                    >
                        <ul class="item-list">
                            <template
                                x-for="item in filteredItems(cat)"
                                :key="item.id"
                            >
                                <li class="menu-item">
                                    <div class="item-layout">
                                        <!-- Item Image Thumbnail -->
                                        <div
                                            class="item-thumb-wrapper"
                                            x-show="getItemImage(item)"
                                        >
                                            <img
                                                :src="getItemImage(item)"
                                                :alt="item.name"
                                                class="item-thumb"
                                                loading="lazy"
                                            />
                                        </div>

                                        <div class="item-details">
                                            <div class="item-line">
                                                <span
                                                    class="item-name"
                                                    x-text="item.name"
                                                ></span>
                                                <span class="dots"></span>
                                                <span
                                                    class="price"
                                                    x-text="item.price || ''"
                                                ></span>
                                            </div>
                                            <p
                                                class="description"
                                                x-show="item.description"
                                                x-text="item.description"
                                            ></p>
                                            <div class="item-tags">
                                                <span
                                                    class="serves-tag"
                                                    x-show="item.serves"
                                                    x-text="item.serves"
                                                ></span>
                                                <span
                                                    class="dine-in-tag dine-in-only-tag"
                                                    data-icon="seat"
                                                    x-show="item.takeaway === false"
                                                >
                                                    Dine In Only
                                                </span>
                                                <template x-if="item.takeaway !== false">
                                                    <span class="item-availability-pair">
                                                        <span
                                                            class="dine-in-tag"
                                                            data-icon="seat"
                                                        >
                                                            Dine In
                                                        </span>
                                                        <span
                                                            class="takeaway-tag"
                                                            data-icon="cart"
                                                        >
                                                            Takeaway
                                                        </span>
                                                    </span>
                                                </template>
                                                <span
                                                    class="takeaway-unavailable-tag"
                                                    data-icon="clock"
                                                    x-show="item.takeaway !== false && !isTakeawayAvailableForCurrentOrder(item)"
                                                >
                                                    Takeaway unavailable today
                                                </span>
                                                <span
                                                    class="notice-tag"
                                                    data-icon="clock"
                                                    x-show="item._platter"
                                                    x-text="notice.title"
                                                ></span>
                                            </div>

                                            <button
                                                class="add-btn"
                                                data-icon="plus"
                                                x-show="isOrderable(item, type.id, cat)"
                                                @click="openItemModal(item)"
                                            >
                                                Add to order
                                            </button>
                                        </div>
                                    </div>
                                </li>
                            </template>
                        </ul>
                    </div>
                </div>
            </template>
        </section>
    </template>

    <!-- Empty state -->
    <div class="empty-state" x-show="!hasResults">
        <span
            class="empty-icon ico-only"
            data-icon="empty"
            aria-hidden="true"
        ></span>
        <p>No menu items match your search.</p>
        <button class="reset-btn" @click="search = ''; selectedType = 'all'">
            Reset Filters
        </button>
    </div>

    <!-- ITEM MODAL -->
    <div
        class="modal-overlay"
        x-show="showItemModal"
        x-cloak
        @click.self="closeItemModal"
    >
        <div class="modal-box" x-show="showItemModal" x-transition>
            <template x-if="activeItem">
                <div>
                    <!-- Optional item image inside modal -->
                    <div
                        class="modal-item-img-container"
                        x-show="getItemImage(activeItem)"
                    >
                        <img
                            :src="getItemImage(activeItem)"
                            :alt="activeItem.name"
                            class="modal-item-img"
                        />
                    </div>

                    <h3 x-text="activeItem.name"></h3>
                    <p class="modal-price" x-text="activeItem.price || ''"></p>

                    <!-- Platters need notice -->
                    <div
                        class="notice-box"
                        data-icon="alert"
                        role="alert"
                        x-show="activeItem._platter"
                    >
                        <strong x-text="notice.title"></strong>
                        <span x-text="notice.text"></span>
                    </div>

                    <!-- Modifier groups: "single" = radio, "multiple" = checkboxes
                         (checkboxes can each add a price, e.g. Extra Sauce,
                         Schnitzel Add-ons — set up in /admin/menu-editor) -->
                    <template
                        x-for="group in (activeItem.modifier_groups || [])"
                        :key="group.id"
                    >
                        <div class="modal-field">
                            <label x-text="group.name"></label>

                            <div
                                class="choice-group"
                                x-show="group.selection_type === 'single'"
                            >
                                <template
                                    x-for="opt in group.options"
                                    :key="opt.id"
                                >
                                    <label class="choice-pill">
                                        <input
                                            type="radio"
                                            :name="group.id"
                                            :value="opt.id"
                                            x-model="modalChoices[group.id]"
                                        />
                                        <span x-text="opt.name + (opt.price > 0 ? ' (+R' + opt.price.toFixed(2) + ')' : '')"></span>
                                    </label>
                                </template>
                            </div>

                            <div
                                class="choice-group"
                                x-show="group.selection_type === 'multiple'"
                            >
                                <template
                                    x-for="opt in group.options"
                                    :key="opt.id"
                                >
                                    <label class="choice-pill">
                                        <input
                                            type="checkbox"
                                            :checked="(modalChoices[group.id] || []).includes(opt.id)"
                                            @change="toggleMultiChoice(group.id, opt.id)"
                                        />
                                        <span x-text="opt.name + (opt.price > 0 ? ' (+R' + opt.price.toFixed(2) + ')' : '')"></span>
                                    </label>
                                </template>
                            </div>
                        </div>
                    </template>

                    <!-- Quantity -->
                    <div class="modal-field">
                        <label>Quantity</label>
                        <div class="qty-stepper">
                            <button
                                type="button"
                                @click="modalQty = Math.max(1, modalQty - 1)"
                            >
                                −
                            </button>
                            <span x-text="modalQty"></span>
                            <button type="button" @click="modalQty++">
                                +
                            </button>
                        </div>
                    </div>

                    <!-- Note -->
                    <div class="modal-field">
                        <label>Any specifications? (optional)</label>
                        <textarea
                            x-model="modalNote"
                            placeholder="e.g. no onions, extra spicy, allergy info..."
                            rows="2"
                        ></textarea>
                    </div>

                    <div class="modal-actions">
                        <button class="cancel-btn" @click="closeItemModal">
                            Cancel
                        </button>
                        <button class="confirm-btn" @click="confirmAddToCart">
                            Add to order
                        </button>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <!-- FLOATING CART FAB + ORDER PANEL -->
    <button
        class="cart-fab"
        x-show="cart.length > 0"
        x-cloak
        @click="showCartPanel = true"
    >
        <span class="ico-only" data-icon="cart" aria-hidden="true"></span>
        View Order (<span x-text="cartCount"></span>)
    </button>

    <div
        class="modal-overlay"
        x-show="showCartPanel"
        x-cloak
        @click.self="showCartPanel = false"
    >
        <div class="modal-box cart-panel" x-show="showCartPanel" x-transition>
            <div class="order-panel-heading">
                <h3 data-icon="receipt">Your Order</h3>
                <button
                    type="button"
                    class="clear-order-btn"
                    x-show="cart.length > 0 && !orderSent"
                    x-cloak
                    @click="clearOrder()"
                >
                    Clear order
                </button>
            </div>

            <!-- Shown after the order is saved and WhatsApp has opened -->
            <div class="order-success" role="status" x-show="orderSent" x-cloak>
                <span class="order-success-tick" aria-hidden="true"></span>
                <h4>Order saved</h4>
                <p>
                    Thanks <span x-text="orderSent?.name"></span> — we've saved
                    your order <strong x-text="orderSent?.ref"></strong>.
                </p>
                <p>
                    Send the WhatsApp message that just opened to confirm it
                    with us — that's what actually gets it to the kitchen.
                </p>
                <button class="confirm-btn" @click="closeOrderSuccess()">
                    Done
                </button>
            </div>

            <div class="empty-cart" x-show="cart.length === 0 && !orderSent">
                <p>Your order is empty.</p>
            </div>

            <ul class="cart-list" x-show="cart.length > 0">
                <template x-for="(line, index) in cart" :key="index">
                    <li class="cart-line">
                        <div class="cart-line-top">
                            <span x-text="line.qty + 'x ' + line.name"></span>
                            <button
                                class="remove-btn"
                                @click="removeFromCart(index)"
                            >
                                ✕
                            </button>
                        </div>
                        <div class="cart-line-details">
                            <template
                                x-for="opt in line.options"
                                :key="opt.label + opt.value"
                            >
                                <span x-text="opt.label + ': ' + opt.value + (opt.price > 0 ? ' (+R' + opt.price.toFixed(2) + ')' : '')"></span>
                            </template>
                            <span x-show="line.note">
                                Note: <span x-text="line.note"></span>
                            </span>
                            <span
                                class="line-notice"
                                x-show="line.platter"
                                x-text="notice.title"
                            ></span>
                        </div>
                    </li>
                </template>
            </ul>

            <div x-show="!orderSent">
                <div class="modal-field">
                    <label for="order-name">
                        Name for order <span class="req">*</span>
                    </label>
                    <input
                        id="order-name"
                        type="text"
                        x-model="orderName"
                        @blur="touched.name = true"
                        autocomplete="name"
                        placeholder="Your name"
                        required
                    />
                    <p
                        class="field-error"
                        x-show="touched.name && !nameValid"
                        x-cloak
                    >
                        Please enter a name for the order.
                    </p>
                </div>

                <!-- Collection date is only required for platter orders. Collection time is required for all takeaway orders. -->
                <div x-show="hasPlatter" x-cloak>
                    <div class="notice-box" data-icon="alert" role="alert">
                        <strong x-text="notice.title"></strong>
                        <span x-text="notice.text"></span>
                    </div>

                    <div class="modal-field collection-field">
                        <button
                            type="button"
                            class="collection-trigger"
                            :class="{ 'is-selected': collectDate }"
                            @click="openCollectionPicker('date')"
                            :aria-expanded="collectionPicker === 'date'"
                        >
                            <span class="collection-trigger-copy">
                                <span class="collection-trigger-label">
                                    Collection date <span class="req">*</span>
                                </span>
                                <strong x-text="collectionDateLabel"></strong>
                            </span>
                            <span class="collection-trigger-arrow" aria-hidden="true">›</span>
                        </button>
                        <p class="field-hint">Choose your date, then you’ll be taken straight to the collection time.</p>
                        <p class="field-error" x-show="collectionDateError" x-cloak x-text="collectionDateError"></p>
                    </div>
                </div>

                <div class="modal-field collection-field">
                    <button
                        type="button"
                        class="collection-trigger"
                        :class="{ 'is-selected': collectTime }"
                        @click="openCollectionPicker('time')"
                        :aria-expanded="collectionPicker === 'time'"
                    >
                        <span class="collection-trigger-copy">
                            <span class="collection-trigger-label">
                                Collection time <span class="req">*</span>
                            </span>
                            <strong x-text="collectionTimeLabel"></strong>
                        </span>
                        <span class="collection-trigger-arrow" aria-hidden="true">›</span>
                    </button>
                    <p class="field-hint">Choose your collection time. Monday–Saturday: 11:00–20:00<span x-show="hasPlatter"> · Sunday: 11:00–16:00</span></p>
                    <p class="field-error" x-show="collectionTimeError" x-cloak x-text="collectionTimeError"></p>
                </div>

                <div
                    class="collection-picker-overlay"
                    x-show="collectionPicker"
                    x-cloak
                    @click.self="closeCollectionPicker"
                >
                    <div
                        class="collection-picker"
                        role="dialog"
                        aria-modal="true"
                        :aria-label="collectionPicker === 'date' ? 'Choose collection date' : 'Choose collection time'"
                        @keydown.escape.window="closeCollectionPicker"
                    >
                        <div x-show="collectionPicker === 'date' && hasPlatter" x-cloak>
                            <div class="collection-picker-head">
                                <button type="button" class="picker-nav-btn" @click="previousCalendarMonth" aria-label="Previous month">‹</button>
                                <strong x-text="calendarMonthLabel"></strong>
                                <button type="button" class="picker-nav-btn" @click="nextCalendarMonth" aria-label="Next month">›</button>
                            </div>
                            <div class="calendar-weekdays" aria-hidden="true">
                                <template x-for="day in weekdayLabels" :key="day">
                                    <span x-text="day"></span>
                                </template>
                            </div>
                            <div class="calendar-grid">
                                <template x-for="cell in calendarDays" :key="cell.key">
                                    <button
                                        type="button"
                                        class="calendar-day"
                                        :class="{
                                            'is-empty': !cell.iso,
                                            'is-today': cell.isToday,
                                            'is-selected': cell.iso === collectDate,
                                            'is-unavailable': cell.disabled,
                                        }"
                                        :disabled="!cell.iso || cell.disabled"
                                        @click="selectCollectionDate(cell.iso)"
                                        x-text="cell.day"
                                    ></button>
                                </template>
                            </div>
                            <p class="picker-note">Dates are limited to days when every item in your order is available for takeaway.</p>
                            <p class="picker-note">Platters also require the advance notice shown above.</p>
                            <div class="picker-actions">
                                <button type="button" class="cancel-btn" @click="closeCollectionPicker">Close</button>
                            </div>
                        </div>

                        <div x-show="collectionPicker === 'time'" x-cloak>
                            <div class="collection-picker-head collection-picker-head--time">
                                <button
                                    type="button"
                                    class="picker-back"
                                    @click="hasPlatter ? openCollectionPicker('date') : closeCollectionPicker()"
                                >
                                    <span x-show="hasPlatter">‹ Date</span>
                                    <span x-show="!hasPlatter">‹ Back</span>
                                </button>
                                <strong>Collection time</strong>
                                <span class="picker-head-spacer" aria-hidden="true"></span>
                            </div>
                            <p class="selected-date-summary" x-show="hasPlatter" x-text="collectionDateLabel"></p>
                            <div class="time-options">
                                <template x-for="time in timeOptions" :key="time">
                                    <button
                                        type="button"
                                        class="time-option"
                                        :class="{ 'is-selected': time === collectTime }"
                                        @click="selectCollectionTime(time)"
                                        x-text="time"
                                    ></button>
                                </template>
                            </div>
                            <p class="picker-note" x-text="hasPlatter && collectDate && isSunday(collectDate) ? 'Sunday collection hours: 11:00–16:00.' : 'Collection times are available every 30 minutes.'"></p>
                            <div class="picker-actions">
                                <button type="button" class="cancel-btn" @click="closeCollectionPicker">Close</button>
                            </div>
                        </div>
                    </div>
                </div>

                <p class="cart-total" x-show="cartTotal > 0">
                    Estimated Total: R
                    <span x-text="cartTotal.toFixed(2)"></span>
                </p>

                <p
                    class="field-error"
                    role="alert"
                    x-show="orderError"
                    x-cloak
                    x-text="orderError"
                ></p>

                <div class="modal-actions">
                    <button class="cancel-btn" @click="showCartPanel = false">
                        Keep browsing
                    </button>
                    <button
                        class="confirm-btn whatsapp-btn"
                        data-icon="whatsapp"
                        :disabled="!canSubmitOrder"
                        @click="sendOrderViaWhatsApp"
                    >
                        <span x-text="sendingOrder ? 'Sending…' : 'Send Order'"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener("alpine:init", () => {
        const root = document.querySelector("[data-menu]");

        const readJson = (value, fallback) => {
            try {
                return JSON.parse(value);
            } catch {
                return fallback;
            }
        };

        // Platter notice text + days (src/lib/siteInfo.ts)
        const notice = readJson(root.dataset.platterNotice, {
            days: 2,
            title: "2 Day notice required",
            text: "Platters must be ordered at least 2 days in advance.",
        });

        // ── Specials: split ONE category into sub-categories ───────────
        // (groups are defined at the top of this file)
        const SPECIALS_GROUPS = readJson(root.dataset.specialsGroups, []).map(
            (g) => ({ ...g, re: g.match ? new RegExp(g.match, "i") : null }),
        );

        const groupSpecials = (type) => {
            // Already split into several categories in Supabase: leave as is.
            if (type.categories.length !== 1 || SPECIALS_GROUPS.length === 0) {
                return type;
            }
            const source = type.categories[0];
            const groups = SPECIALS_GROUPS.map((g, index) => ({
                id: g.id,
                label: g.label,
                sort_order: index + 1,
                image_url: null,
                items: [],
                re: g.re,
            }));
            const fallback =
                groups.find((g) => !g.re) || groups[groups.length - 1];

            source.items.forEach((item) => {
                const text = [
                    item.name,
                    item.description,
                    source.label,
                    source.id,
                ]
                    .filter(Boolean)
                    .join(" ");
                const home =
                    groups.find((g) => g.re && g.re.test(text)) || fallback;
                home.items.push({ ...item, category_id: home.id });
            });

            return {
                ...type,
                categories: groups
                    .filter((g) => g.items.length > 0)
                    .map(({ re, ...category }) => category),
            };
        };

        // Flags items that are platters (used for the "2 Day notice" message).
        const prepareMenu = (menu) =>
            menu.map((rawType) => {
                const type =
                    String(rawType.id).toLowerCase() === "specials"
                        ? groupSpecials(rawType)
                        : rawType;
                type.categories.forEach((cat) => {
                    const isPlatterType =
                        String(type.id).toLowerCase() === "platters" ||
                        String(cat.id).toLowerCase().startsWith("platters");
                    cat.items.forEach((item) => {
                        item._platter = isPlatterType;
                    });
                });
                return type;
            });

        Alpine.data("menuApp", () => ({
            menu: prepareMenu(readJson(root.dataset.menu, [])),
            notice,
            whatsappNumber:
                document.querySelector("[data-whatsapp]").dataset.whatsapp,
            search: "",
            selectedType: "all",

            // Open/closed state per category ID
            openCategories: {},

            // Drinks remain view-only. Specials are orderable when their
            // individual item is takeaway-enabled; drink specials are still
            // treated as view-only through the category check below.
            EXCLUDED_ORDER_TYPES: ["drinks"],

            // Item modal state
            showItemModal: false,
            activeItem: null,
            modalChoices: {},
            modalQty: 1,
            modalNote: "",

            // Cart state
            cart: [],
            showCartPanel: false,
            orderName: "",
            collectTime: "",
            collectDate: "",

            // Collection picker state
            collectionPicker: "",
            calendarMonth: null,

            touched: { name: false, date: false, time: false },
            sendingOrder: false,
            orderSent: null, // { ref, name } after a successful save
            orderError: "",

            init() {
                // Initialize default category dropdown states (all expanded initially or default state)
                this.menu.forEach((t) => {
                    t.categories.forEach((c) => {
                        this.openCategories[c.id] = true;
                    });
                });

                // The navigation links here as /menu#type-<id> and
                // /menu#cat-<id>: show that section and scroll to it, both
                // on page load and when the link is used on this page.
                this.applyHash();
                window.addEventListener("hashchange", () => this.applyHash());
            },

            applyHash() {
                const hash = decodeURIComponent(
                    window.location.hash.replace(/^#/, ""),
                );
                let targetId = null;

                if (hash.startsWith("cat-")) {
                    const catId = hash.slice(4);
                    const type = this.menu.find((t) =>
                        t.categories.some((c) => String(c.id) === catId),
                    );
                    if (!type) return;
                    this.selectedType = type.id;
                    this.openCategories[catId] = true;
                    targetId = hash;
                } else if (hash.startsWith("type-")) {
                    const type = this.menu.find(
                        (t) => String(t.id) === hash.slice(5),
                    );
                    if (!type) return;
                    this.selectedType = type.id;
                    targetId = hash;
                } else {
                    return;
                }

                this.search = "";
                // Wait for the filtered list to render before scrolling.
                setTimeout(() => {
                    document.getElementById(targetId)?.scrollIntoView({
                        behavior: "smooth",
                        block: "start",
                    });
                }, 60);
            },

            get types() {
                return this.menu.map((t) => ({ id: t.id, label: t.label }));
            },

            get filteredMenu() {
                return this.menu
                    .filter(
                        (t) =>
                            this.selectedType === "all" ||
                            t.id === this.selectedType,
                    )
                    .map((t) => ({
                        ...t,
                        categories: t.categories.filter(
                            (c) => this.filteredItems(c).length > 0,
                        ),
                    }))
                    .filter((t) => t.categories.length > 0);
            },

            get hasResults() {
                return this.filteredMenu.some((t) =>
                    t.categories.some((c) => this.filteredItems(c).length > 0),
                );
            },

            filteredItems(cat) {
                const q = this.search.trim().toLowerCase();
                if (!q) return cat.items;
                return cat.items.filter(
                    (i) =>
                        i.name.toLowerCase().includes(q) ||
                        (i.description || "").toLowerCase().includes(q),
                );
            },

            // Dropdown Toggle Logic
            toggleCategory(catId) {
                this.openCategories[catId] = !this.openCategories[catId];
            },

            isCategoryOpen(catId) {
                // Always expand dropdowns when active search is entered
                if (this.search.trim().length > 0) return true;
                return !!this.openCategories[catId];
            },

            // Category Drink Logos & Fallback Images
            getCategoryImage(cat) {
                if (cat.image_url) {
                    if (
                        cat.image_url.startsWith("http") ||
                        cat.image_url.startsWith("/")
                    ) {
                        return cat.image_url;
                    }
                    return `https://xwpwssyoetlphadybtsx.supabase.co/storage/v1/object/public/LordsImg/Categories/${cat.image_url}`;
                }

                // Temp placeholder icons matching drinks & food styling
                const categoryLogos = {
                    drinks_beer:
                        "https://images.unsplash.com/photo-1608270586620-248524c67de9?w=120&auto=format&fit=crop&q=80",
                    drinks_ciders:
                        "https://images.unsplash.com/photo-1560512823-829485b8bf24?w=120&auto=format&fit=crop&q=80",
                    drinks_cocktails:
                        "https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=120&auto=format&fit=crop&q=80",
                    drinks_cooldrinks:
                        "https://images.unsplash.com/photo-1622483767028-3f66f32aef97?w=120&auto=format&fit=crop&q=80",
                    drinks_energy_drinks:
                        "https://images.unsplash.com/photo-1622543925917-763c34d1a86e?w=120&auto=format&fit=crop&q=80",
                    drinks_hot_drinks:
                        "https://images.unsplash.com/photo-1541167760496-1628856ab772?w=120&auto=format&fit=crop&q=80",
                    drinks_other_wine:
                        "https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?w=120&auto=format&fit=crop&q=80",
                    drinks_shooters_mixed:
                        "https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?w=120&auto=format&fit=crop&q=80",
                    drinks_shooters_single:
                        "https://images.unsplash.com/photo-1527281400683-1aae777175f8?w=120&auto=format&fit=crop&q=80",
                    drinks_water:
                        "https://images.unsplash.com/photo-1548839140-29a749e1bc4e?w=120&auto=format&fit=crop&q=80",
                    drinks_wine_by_carafe:
                        "https://images.unsplash.com/photo-1558001373-a1286be6b208?w=120&auto=format&fit=crop&q=80",
                    drinks_wine_by_glass:
                        "https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?w=120&auto=format&fit=crop&q=80",
                    food_smash_burgers:
                        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=120&auto=format&fit=crop&q=80",
                    food_all_day_breakfast:
                        "https://images.unsplash.com/photo-1533089860892-a7c6f0a88666?w=120&auto=format&fit=crop&q=80",
                    food_pub_grub:
                        "https://images.unsplash.com/photo-1544025162-d76694265947?w=120&auto=format&fit=crop&q=80",
                    platters_all:
                        "https://images.unsplash.com/photo-1541529086526-db283c563270?w=120&auto=format&fit=crop&q=80",
                    specials_all:
                        "https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=120&auto=format&fit=crop&q=80",
                    specials_daily:
                        "https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=120&auto=format&fit=crop&q=80",
                    specials_drinks:
                        "https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=120&auto=format&fit=crop&q=80",
                    specials_r150:
                        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=120&auto=format&fit=crop&q=80",
                };

                return (
                    categoryLogos[cat.id] ||
                    "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=120&auto=format&fit=crop&q=80"
                );
            },

            // Menu Item Image Logic with temp placeholder fallback
            getItemImage(item) {
                if (item.image_url) {
                    if (
                        item.image_url.startsWith("http") ||
                        item.image_url.startsWith("/")
                    ) {
                        return item.image_url;
                    }
                    return `https://xwpwssyoetlphadybtsx.supabase.co/storage/v1/object/public/LordsImg/MenuItems/${item.image_url}`;
                }

                // Temporary styled placeholders for items without Supabase URLs
                const defaultItemPlaceholders = {
                    drinks_beer:
                        "https://images.unsplash.com/photo-1608270586620-248524c67de9?w=200&auto=format&fit=crop&q=80",
                    drinks_cocktails:
                        "https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=200&auto=format&fit=crop&q=80",
                    drinks_ciders:
                        "https://images.unsplash.com/photo-1560512823-829485b8bf24?w=200&auto=format&fit=crop&q=80",
                    food_smash_burgers:
                        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=200&auto=format&fit=crop&q=80",
                    food_loaded_fries:
                        "https://images.unsplash.com/photo-1576107232684-1279f3908594?w=200&auto=format&fit=crop&q=80",
                    food_salads_and_starters:
                        "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=200&auto=format&fit=crop&q=80",
                };

                return defaultItemPlaceholders[item.category_id] || null;
            },

            isSpecialDrinkCategory(cat) {
                if (!cat) return false;
                const text = `${cat.id || ""} ${cat.label || ""}`.toLowerCase();
                return /specials?_?drinks?|drink specials?|beverage specials?/.test(text);
            },

            getTakeawayReferenceDate() {
                // Platter orders have an explicit collection date. All other
                // takeaway orders are same-day orders, so their availability
                // is based on today's Johannesburg weekday.
                return this.hasPlatter && this.collectDate
                    ? this.collectDate
                    : this.todayIso();
            },

            isTakeawayAvailableForCurrentOrder(item) {
                if (!item || item.takeaway === false) return false;
                return this.isItemTakeawayOnDate(item, this.getTakeawayReferenceDate());
            },

            isOrderable(item, typeId, cat) {
                if (this.EXCLUDED_ORDER_TYPES.includes(String(typeId).toLowerCase())) {
                    return false;
                }
                if (String(typeId).toLowerCase() === "specials" && this.isSpecialDrinkCategory(cat)) {
                    return false;
                }
                if (item.takeaway === false) return false;
                return this.isTakeawayAvailableForCurrentOrder(item);
            },

            openItemModal(item) {
                this.activeItem = item;
                this.modalChoices = {};
                (item.modifier_groups || []).forEach((group) => {
                    this.modalChoices[group.id] =
                        group.selection_type === "multiple"
                            ? []
                            : group.options[0]
                              ? group.options[0].id
                              : "";
                });
                this.modalQty = 1;
                this.modalNote = "";
                this.showItemModal = true;
            },

            toggleMultiChoice(groupId, optId) {
                if (!this.modalChoices[groupId])
                    this.modalChoices[groupId] = [];
                const idx = this.modalChoices[groupId].indexOf(optId);
                if (idx === -1) this.modalChoices[groupId].push(optId);
                else this.modalChoices[groupId].splice(idx, 1);
            },

            closeItemModal() {
                this.showItemModal = false;
                this.activeItem = null;
            },

            confirmAddToCart() {
                if (!this.activeItem) return;
                const options = [];
                (this.activeItem.modifier_groups || []).forEach((group) => {
                    const chosen = this.modalChoices[group.id];
                    const ids =
                        group.selection_type === "multiple"
                            ? chosen || []
                            : chosen
                              ? [chosen]
                              : [];
                    ids.forEach((optId) => {
                        const opt = group.options.find((o) => o.id === optId);
                        if (opt) {
                            options.push({
                                groupId: group.id,
                                optionId: opt.id,
                                label: group.name,
                                value: opt.name,
                                price: opt.price,
                            });
                        }
                    });
                });
                const addOnsTotal = options.reduce(
                    (sum, o) => sum + (o.price || 0),
                    0,
                );

                this.cart.push({
                    id: this.activeItem.id,
                    takeaway_days: Array.isArray(this.activeItem.takeaway_days)
                        ? [...this.activeItem.takeaway_days]
                        : [0, 1, 2, 3, 4, 5, 6],
                    name: this.activeItem.name,
                    price: this.activeItem.price || "",
                    priceValue:
                        this.parsePrice(this.activeItem.price) + addOnsTotal,
                    options,
                    note: this.modalNote.trim(),
                    qty: this.modalQty,
                    platter: !!this.activeItem._platter,
                });
                this.closeItemModal();
                this.showCartPanel = true;
            },

            removeFromCart(index) {
                this.cart.splice(index, 1);
                if (!this.hasPlatter) {
                    this.collectDate = "";
                }
                if (this.cart.length === 0) {
                    this.collectDate = "";
                    this.collectTime = "";
                    this.collectionPicker = "";
                }
            },

            clearOrder() {
                this.cart = [];
                this.orderName = "";
                this.collectDate = "";
                this.collectTime = "";
                this.collectionPicker = "";
                this.orderError = "";
                this.touched = { name: false, date: false, time: false };
            },

            parsePrice(priceStr) {
                if (!priceStr) return 0;
                const n = parseFloat(String(priceStr).replace(/[^0-9.]/g, ""));
                return isNaN(n) ? 0 : n;
            },

            // ── Platters: 2 day notice ─────────────────────────────────
            get hasPlatter() {
                return this.cart.some((l) => l.platter);
            },

            // Earliest allowed collection date for platters, as YYYY-MM-DD in
            // the visitor's local time (today + notice days).
            get minPlatterDate() {
                const d = this.parseIsoDate(this.todayIso());
                d.setDate(d.getDate() + this.notice.days);
                return this.localIso(d);
            },

            // A date was chosen but it is sooner than the notice allows.
            get dateTooSoon() {
                return (
                    this.hasPlatter &&
                    !!this.collectDate &&
                    this.collectDate < this.minPlatterDate
                );
            },

            get weekdayLabels() {
                return ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
            },

            get calendarMonthLabel() {
                if (!this.calendarMonth) return "";
                return this.calendarMonth.toLocaleDateString("en-ZA", {
                    month: "long",
                    year: "numeric",
                });
            },

            get collectionDateLabel() {
                if (!this.collectDate) return "Choose a collection date";
                return this.formatCollectionDate(this.collectDate);
            },

            get collectionTimeLabel() {
                return this.collectTime || "Choose a collection time";
            },

            get collectionDateError() {
                if (!this.hasPlatter) return "";
                if (!this.collectDate) return "Please choose a collection date.";
                if (this.dateTooSoon) {
                    return `Please choose a date that is at least ${this.notice.days} days from today.`;
                }
                if (!this.isCartDateAvailable(this.collectDate)) {
                    return "One or more items in your order is not available for takeaway on this date.";
                }
                return "";
            },

            get collectionTimeError() {
                if (this.cart.length === 0) return "";
                if (!this.collectTime) return "Please choose a collection time.";
                return this.isTimeAllowed(this.collectTime) ? "" : "Please choose a time within the collection hours.";
            },

            get calendarDays() {
                if (!this.calendarMonth) return [];
                const year = this.calendarMonth.getFullYear();
                const month = this.calendarMonth.getMonth();
                const first = new Date(year, month, 1);
                const daysInMonth = new Date(year, month + 1, 0).getDate();
                // JS Sunday=0; convert to Monday-first calendar index.
                const leading = (first.getDay() + 6) % 7;
                const cells = [];
                for (let i = 0; i < leading; i++) {
                    cells.push({ key: `empty-${i}`, iso: "", day: "", disabled: true, isToday: false });
                }
                for (let day = 1; day <= daysInMonth; day++) {
                    const d = new Date(year, month, day);
                    const iso = this.localIso(d);
                    cells.push({
                        key: iso,
                        iso,
                        day,
                        disabled: this.isCollectionDateDisabled(iso),
                        isToday: iso === this.todayIso(),
                    });
                }
                return cells;
            },

            get timeOptions() {
                const latest = this.collectDate && this.isSunday(this.collectDate) ? "16:00" : "20:00";
                const result = [];
                for (let hour = 11; hour <= Number(latest.slice(0, 2)); hour++) {
                    for (const minute of [0, 30]) {
                        const value = `${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}`;
                        if (value <= latest) result.push(value);
                    }
                }
                return result;
            },

            get cartCount() {
                return this.cart.reduce((sum, l) => sum + l.qty, 0);
            },

            get cartTotal() {
                return this.cart.reduce(
                    (sum, l) => sum + l.priceValue * l.qty,
                    0,
                );
            },

            localIso(date) {
                const pad = (n) => String(n).padStart(2, "0");
                return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
            },

            todayIso() {
                const parts = new Intl.DateTimeFormat("en-CA", {
                    timeZone: "Africa/Johannesburg",
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                }).formatToParts(new Date());
                const year = parts.find((part) => part.type === "year")?.value;
                const month = parts.find((part) => part.type === "month")?.value;
                const day = parts.find((part) => part.type === "day")?.value;
                return `${year}-${month}-${day}`;
            },

            parseIsoDate(iso) {
                const [year, month, day] = String(iso).split("-").map(Number);
                return new Date(year, month - 1, day);
            },

            formatCollectionDate(iso) {
                return this.parseIsoDate(iso).toLocaleDateString("en-ZA", {
                    weekday: "short",
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                });
            },

            isSunday(iso) {
                return this.parseIsoDate(iso).getDay() === 0;
            },

            normaliseTakeawayDays(item) {
                if (!Array.isArray(item?.takeaway_days)) {
                    return [0, 1, 2, 3, 4, 5, 6];
                }
                return item.takeaway_days.map(Number).filter((day) => day >= 0 && day <= 6);
            },

            isItemTakeawayOnDate(item, iso) {
                if (!item || item.takeaway === false || !iso) return false;
                return this.normaliseTakeawayDays(item).includes(this.parseIsoDate(iso).getDay());
            },

            isCartDateAvailable(iso) {
                return this.cart.every((line) => this.isItemTakeawayOnDate(line, iso));
            },

            isCollectionDateDisabled(iso) {
                if (!iso) return true;
                if (iso < this.todayIso()) return true;
                if (this.hasPlatter && iso < this.minPlatterDate) return true;
                return !this.isCartDateAvailable(iso);
            },

            isTimeAllowed(time) {
                if (!/^\d{2}:\d{2}$/.test(String(time))) return false;
                const latest = this.collectDate && this.isSunday(this.collectDate) ? "16:00" : "20:00";
                return String(time) >= "11:00" && String(time) <= latest;
            },

            openCollectionPicker(mode) {
                if (mode === "date" && !this.hasPlatter) {
                    mode = "time";
                }
                if (!this.calendarMonth) {
                    this.calendarMonth = this.collectDate
                        ? this.parseIsoDate(this.collectDate)
                        : new Date();
                    this.calendarMonth.setDate(1);
                } else if (mode === "date" && this.collectDate) {
                    this.calendarMonth = this.parseIsoDate(this.collectDate);
                    this.calendarMonth.setDate(1);
                }
                if (mode === "time" && !this.isTimeAllowed(this.collectTime)) {
                    this.collectTime = "";
                }
                this.collectionPicker = mode;
            },

            closeCollectionPicker() {
                this.collectionPicker = "";
            },

            previousCalendarMonth() {
                if (!this.calendarMonth) this.calendarMonth = new Date();
                this.calendarMonth = new Date(
                    this.calendarMonth.getFullYear(),
                    this.calendarMonth.getMonth() - 1,
                    1,
                );
            },

            nextCalendarMonth() {
                if (!this.calendarMonth) this.calendarMonth = new Date();
                this.calendarMonth = new Date(
                    this.calendarMonth.getFullYear(),
                    this.calendarMonth.getMonth() + 1,
                    1,
                );
            },

            selectCollectionDate(iso) {
                if (this.isCollectionDateDisabled(iso)) return;
                this.collectDate = iso;
                if (!this.isTimeAllowed(this.collectTime)) this.collectTime = "";
                // The requested flow: selecting the date takes the customer straight to time.
                this.collectionPicker = "time";
            },

            selectCollectionTime(time) {
                if (!this.isTimeAllowed(time)) return;
                this.collectTime = time;
                this.collectionPicker = "";
            },

            buildOrderMessage(orderRef = "") {
                const lines = [];
                lines.push("*NEW ORDER*");
                if (orderRef) lines.push(`Order Ref: ${orderRef}`);
                lines.push(`Name: ${this.orderName || "(not given)"}`);
                if (this.hasPlatter) {
                    lines.push(`Collection date: ${this.collectionDateLabel}`);
                }
                lines.push(`Collection time: ${this.collectTime || "(not selected)"}`);
                lines.push("");

                if (this.hasPlatter) {
                    const platters = this.cart
                        .filter((l) => l.platter)
                        .map((l) => `${l.qty}x ${l.name}`)
                        .join(", ");
                    lines.push(
                        `⚠️ *${this.notice.title.toUpperCase()}* – ${platters}`,
                    );
                    lines.push("");
                }

                this.cart.forEach((line) => {
                    let itemLine = `${line.qty}x ${line.name}`;
                    if (line.price) itemLine += ` (${line.price})`;
                    lines.push(itemLine);
                    (line.options || []).forEach((opt) => {
                        const priceSuffix =
                            opt.price > 0 ? ` (+R${opt.price.toFixed(2)})` : "";
                        lines.push(
                            `   • ${opt.label}: ${opt.value}${priceSuffix}`,
                        );
                    });
                    if (line.note) lines.push(`   • Note: ${line.note}`);
                });

                if (this.cartTotal > 0) {
                    lines.push("");
                    lines.push(
                        `*Estimated Total: R${this.cartTotal.toFixed(2)}*`,
                    );
                }

                return lines.join("\n");
            },

            get nameValid() {
                return this.orderName.trim().length > 0;
            },
            get canSubmitOrder() {
                return (
                    this.cart.length > 0 &&
                    this.nameValid &&
                    !!this.collectTime &&
                    !this.collectionTimeError &&
                    (!this.hasPlatter || (
                        !!this.collectDate &&
                        !this.collectionDateError
                    )) &&
                    !this.sendingOrder
                );
            },

            closeOrderSuccess() {
                this.orderSent = null;
                this.showCartPanel = false;
            },

            async sendOrderViaWhatsApp() {
                this.touched = { name: true, date: true, time: true };
                if (!this.canSubmitOrder) return;

                this.sendingOrder = true;
                this.orderError = "";
                // Always the fallback if the save itself fails — the order
                // still reaches us via WhatsApp even with no DB record.
                const fallbackUrl = `https://wa.me/${this.whatsappNumber}?text=${encodeURIComponent(this.buildOrderMessage())}`;

                try {
                    const res = await fetch("/api/orders/whatsapp", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            name: this.orderName.trim(),
                            collectDate: this.collectDate,
                            collectTime: this.collectTime,
                            hasPlatter: this.hasPlatter,
                            total: this.cartTotal,
                            cart: this.cart.map((l) => ({
                                id: l.id,
                                name: l.name,
                                qty: l.qty,
                                price: l.price,
                                note: l.note,
                                options: l.options || [],
                            })),
                        }),
                    });
                    const data = await res.json().catch(() => ({}));

                    if (res.ok && data.ok) {
                        // Saved — now hand off to WhatsApp. Prefix the order
                        // ref so it's easy to match the incoming WhatsApp
                        // message back to the stored record.
                        const message = this.buildOrderMessage(data.orderRef);
                        const whatsappUrl = `https://wa.me/${this.whatsappNumber}?text=${encodeURIComponent(message)}`;

                        this.orderSent = {
                            ref: data.orderRef,
                            name: this.orderName.trim(),
                        };
                        this.cart = [];
                        this.collectDate = "";
                        this.collectTime = "";
                        this.touched = {
                            name: false,
                            date: false,
                            time: false,
                        };

                        // window.open() after an await is often blocked as a
                        // pop-up, so navigate directly instead.
                        window.location.href = whatsappUrl;
                        return;
                    }

                    // Problems the customer can fix: show them, don't fall back.
                    if (data.error === "item_unavailable") {
                        this.orderError =
                            "One or more items is not available for takeaway on that collection date. Please choose another date or remove the unavailable item.";
                        return;
                    }
                    if (data.error === "invalid_time") {
                        this.orderError =
                            `Please choose a collection time between 11:00 and ${data.latest || "20:00"}.`;
                        return;
                    }
                    if (
                        data.error === "name_required" ||
                        data.error === "invalid_date" ||
                        data.error === "date_required" ||
                        data.error === "time_required"
                    ) {
                        this.orderError =
                            "Please fill in all the required fields.";
                        return;
                    }
                    if (data.error === "rate_limited") {
                        this.orderError =
                            "Too many orders in a short time – please wait a few minutes and try again.";
                        return;
                    }
                    throw new Error(data.error || `HTTP ${res.status}`);
                } catch (err) {
                    // Couldn't save the order — still let them complete it via
                    // WhatsApp directly, just without a record on our side.
                    console.warn(
                        "Order save failed, opening WhatsApp directly:",
                        err,
                    );
                    this.orderError =
                        "We couldn't save your order, but you can still send it — opening WhatsApp…";
                    setTimeout(
                        () => (window.location.href = fallbackUrl),
                        1200,
                    );
                } finally {
                    this.sendingOrder = false;
                }
            },
        }));
    });
</script>
