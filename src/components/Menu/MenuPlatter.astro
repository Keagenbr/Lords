---
// src/components/MenuPlatter.astro
import { getPublicImageUrl } from "../../lib/supabaseStorage";
import { PLATTER, PLATTER_FOLDER } from "../../lib/menuImages";

interface Props {
    filename?: string;
    folder?: string;
    label?: string;
}

const {
    filename = PLATTER.filename,
    folder = PLATTER_FOLDER,
    label = PLATTER.label,
} = Astro.props;

// Built on the server — no `window` involved.
const imageUrl = getPublicImageUrl(`${folder}/${filename}`);
---

<div class="platter-wrapper">
    <div
        class="menu-image-container"
        x-data="{ lightboxOpen: false }"
        @click="lightboxOpen = true"
    >
        <img src={imageUrl} alt={label} class="menu-image" loading="lazy" />

        <a href={imageUrl} download={filename} class="download-btn" @click.stop>
            ⬇ Download Menu
        </a>

        <div
            class="lightbox-overlay"
            x-show="lightboxOpen"
            x-cloak
            @click="lightboxOpen = false"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
        >
            <div class="lightbox-content" @click.stop>
                <button
                    class="close-lightbox-btn"
                    @click="lightboxOpen = false"
                >
                    &times;
                </button>
                <img src={imageUrl} alt={`Full screen ${label}`} />
                <a
                    href={imageUrl}
                    download={filename}
                    class="download-btn lightbox-download"
                    @click.stop
                >
                    ⬇ Download
                </a>
            </div>
        </div>
    </div>
</div>
