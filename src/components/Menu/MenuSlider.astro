---
// src/components/Menu/MenuSlider.astro
/**
 * MenuSlider.astro
 * Interactive Alpine.js weekly specials slider with lightbox support.
 * Data Fallback Hierarchy:
 *   1. Custom 'specials' array passed via Astro.props.
 *   2. Native server-side fetch from Supabase Storage ('LordsImg' bucket).
 *   3. Static fallback array (SPECIALS from src/lib/menuImages.ts).
 */
import { supabase } from "../../lib/supabase";
import { getPublicImageUrl } from "../../lib/supabaseStorage";
import { SPECIALS, SPECIALS_FOLDER } from "../../lib/menuImages";

export interface Special {
    filename: string;
    label: string;
    url?: string;
}

interface Props {
    specials?: Special[];
    folder?: string;
    title?: string;
}

// Extract props with defaults from existing configuration
const {
    specials,
    folder = SPECIALS_FOLDER,
    title = "Weekly Specials",
} = Astro.props;

let activeSpecials: Special[] = [];

// Determine slide data source
if (specials && specials.length > 0) {
    // Priority 1: Props explicitly supplied by parent page
    activeSpecials = specials;
} else {
    // Priority 2: Native dynamic fetch from Supabase Storage
    const { data: storageFiles, error } = await supabase.storage
        .from("LordsImg")
        .list(folder);

    if (!error && storageFiles && storageFiles.length > 0) {
        activeSpecials = storageFiles
            .filter(
                (file) => file.name.toLowerCase() !== ".emptyfolderplaceholder",
            )
            .map((file) => {
                const rawName = file.name
                    .replace(/\.[^/.]+$/, "")
                    .replace(/[-_]/g, " ");
                return {
                    filename: file.name,
                    label: rawName.charAt(0).toUpperCase() + rawName.slice(1),
                };
            });
    }

    // Priority 3: Fallback to menuImages.ts default array if storage is empty/unreachable
    if (activeSpecials.length === 0) {
        activeSpecials = SPECIALS;
    }
}

// Generate CDN URLs for each slide item
const slides = activeSpecials.map((special) => ({
    ...special,
    url: special.url || getPublicImageUrl(`${folder}/${special.filename}`),
}));
---

<!-- Slider Outer Wrapper -->
<div class="slider-wrapper">
    <h2 class="section-title">{title}</h2>

    <!-- Alpine.js Carousel Container with JSON slides payload -->
    <div
        class="slider-container"
        x-data={`specialsSlider(${JSON.stringify(slides)})`}
    >
        <div
            class="slider-track"
            :style="`transform: translateX(-${currentSlide * 100}%)`"
        >
            <template x-for="(slide, index) in slides" :key="index">
                <div class="slide">
                    <div class="slide-content" @click="openLightbox(index)">
                        <img
                            :src="slide.url"
                            :alt="slide.label"
                            class="slider-image"
                            loading="lazy"
                        />

                        <div class="slide-overlay">
                            <span
                                class="slide-label"
                                x-text="slide.label"
                            ></span>
                            <a
                                :href="slide.url"
                                :download="slide.filename"
                                class="slide-download"
                                @click.stop
                            >
                                Download
                            </a>
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <!-- Navigation Controls -->
        <button
            class="nav-btn prev-btn"
            @click="prev()"
            :disabled="currentSlide === 0"
            aria-label="Previous slide"
        >
            &lt;
        </button>
        <button
            class="nav-btn next-btn"
            @click="next()"
            :disabled="currentSlide === slides.length - 1"
            aria-label="Next slide"
        >
            &gt;
        </button>

        <!-- Lightbox Modal -->
        <div
            class="lightbox-overlay"
            x-show="lightboxOpen"
            x-cloak
            @click="closeLightbox()"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
        >
            <div class="lightbox-content" @click.stop>
                <button
                    class="close-lightbox-btn"
                    @click="closeLightbox()"
                    aria-label="Close lightbox"
                >
                    &times;
                </button>
                <img
                    :src="slides[lightboxIndex] ? slides[lightboxIndex].url : ''"
                    :alt="slides[lightboxIndex] ? slides[lightboxIndex].label : ''"
                />
                <a
                    :href="slides[lightboxIndex] ? slides[lightboxIndex].url : '#'"
                    :download="slides[lightboxIndex] ? slides[lightboxIndex].filename : ''"
                    class="download-btn lightbox-download"
                    @click.stop
                >
                    Download
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Inline Script: Registers Alpine component before Alpine initializes -->
<script is:inline>
    document.addEventListener("alpine:init", () => {
        Alpine.data("specialsSlider", (slides = []) => ({
            slides,
            currentSlide: 0,
            lightboxOpen: false,
            lightboxIndex: 0,

            next() {
                this.currentSlide =
                    (this.currentSlide + 1) % this.slides.length;
            },
            prev() {
                this.currentSlide =
                    (this.currentSlide - 1 + this.slides.length) %
                    this.slides.length;
            },
            openLightbox(index) {
                this.lightboxOpen = true;
                this.lightboxIndex = index;
            },
            closeLightbox() {
                this.lightboxOpen = false;
            },
        }));
    });
</script>
