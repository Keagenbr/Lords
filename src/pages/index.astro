    <style lang="scss">
        .home-header {
            display: flex;
            color: var(--text-color-dark);
            height: calc(100vh - var(--nav-header));
            margin-top: var(--nav-header);
            background:
                                                                                                    // linear-gradient(to bottom, var(--img-overlay), transparent),
                url("../../src/assets/headerImg.webp") no-repeat center center;
            background-size: cover;

            & h1 {
                color: var(--text-color-dark);
            }
            & svg {
                align-self: flex-end;
                width: 80px;
                height: 60px;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
            }
        }
        @media (max-width: 768px) {
            .home-header {
                height: calc(100vh - var(--nav-headerM));
                margin-top: var(--nav-headerM);
            }
        }
    </style>
