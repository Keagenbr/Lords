---
import Layout from "../layouts/Layout.astro"; // Import the main layout part

// import headerImg from "../../src/assets/headerImg.jpg";

const { title } = Astro.props;
---

<Layout title="Home">
    <main class="home-header">
        <!-- <img
            src="../../src/assets/headerImg.jpg"
            width="1024px"
            alt="Header Image"
            class="home-header-img"
        /> -->
        <h1>
            <span>Welcome to </span>Lords and Legends
        </h1>
    </main>

    <style lang="scss">
        .home-header {
            // top: var(--nav-header);
            color: var(--text-color);
            position: relative;
            min-height: calc(50em - var(--nav-header));
            // min-height: ;
            width: min(50%, 100%);
            max-height: 1080px;
            margin: 0 10%;
            padding: 0;
            background:
                linear-gradient(to bottom, var(--img-overlay), transparent),
                url("../../src/assets/headerImg.webp") no-repeat center center;
            background-size: cover;
            // background-attachment: fixed;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        @media (max-width: 768px) {
            .home-header {
                // top: var(--nav-headerM);
                display: flex;
                position: relative;
                align-items: center;
                justify-content: center;
                background:
                    linear-gradient(to bottom, var(--img-overlay), transparent),
                    url("../../src/assets/headerImgM.webp") no-repeat center
                        center;
                background-size: contain;
            }
        }
    </style>
</Layout>
