---
import Layout from "../layouts/Layout.astro"; // Import the main layout part
// import { Image } from "astro:assets";
// import headerImg from "../../src/assets/headerImg2.webp";
import HeaderBottom from "../../src/assets/headerBottom.svg";

const { title } = Astro.props;
---

<Layout title="Home">
    <main class="home">
        <header class="home-header">
            <h1>
                <span>Welcome to </span>
                Lords and Legends
            </h1>

            <button class="menu-btn">
                <a href="/menu">View Our Menu</a>
            </button>
            <section class="triangle"></section>
            <!-- <HeaderBottom class="home-header-down" /> -->
        </header>
        <section class="home-about">
            <h2>About Us</h2>
            <p>
                Lords and Legends was established over 15 years ago in
                Amanzimtoti, South Coast by a legend, Bruce Lithgow. Bruce had a
                vision to create a social, viby and enjoyable dining experience
                for locals and visitors. Today Lords and Legends have also
                established themselves at Brighton Beach. Proudly bringing
                people of Brighton the same food and viby environment.
            </p>
            <p>
                If you are looking for a place to enjoy your favourite sports
                broadcasts and to eat the most delicious food, then you must
                visit Lords & Legends Sports Cafe which has an extensive menu
                catering for everyone’s taste. With a great selection of food,
                refreshing drinks and party atmosphere, there is no better place
                to dine than in our Lords & Legends Sports Cafe!
            </p>
            <p>
                If you are looking for a place to enjoy your favourite sports
                broadcasts and to eat the most delicious food, then you must
                visit Lords & Legends Sports Cafe which has an extensive menu
                catering for everyone’s taste. With a great selection of food,
                refreshing drinks and party atmosphere, there is no better place
                to dine than in our Lords & Legends Sports Cafe!
            </p>
        </section>
        <aside>
            <h3>Daily Specials</h3>
        </aside>
    </main>

    <style lang="scss">
        .home-header {
            display: grid;
            grid-template-rows: 2fr auto;
            align-items: center;
            justify-items: center;
            text-align: center;
            color: var(--text-color-dark);
            height: calc(100vh - var(--nav-headerM));
            margin-top: var(--nav-headerM);
            background: url("../../src/assets/headerImg.webp") no-repeat center
                center;
            // background-size: cover;

            & h1 {
                grid-area: 1 / 1 / 2 / 2;
                & span {
                    font-family: "Noto Sans";
                }
                color: var(--text-color-dark);
                font-size: 4rem;
                font-family: "Pinyon Script";
            }
            & svg {
                bottom: 0;
                z-index: 10;
            }
        }
        .menu-btn {
            grid-area: 1 / 1 / 2 / 2;

            position: relative;
            bottom: -25%;

            padding: 0.5em 1em;
            background-color: var(--bg-color);
            color: var(--txt-color);
            border: none;
            border-radius: 5px;
            cursor: pointer;

            & a {
                text-decoration: none;
                color: var(--txt-color);
            }
        }

        .triangle {
            position: relative;
            background: #2c3e50;
            height: 30px;
        }

        .triangle::before {
            content: "";
            position: absolute;
            bottom: 0;
            width: 0;
            height: 0;
            border-style: solid;
            border-width: 0 43px 43px 43px;
            border-color: transparent transparent var(--bg-color) transparent;
            left: 49%;
            transform: translateX(-50%);
        }
        // @media (max-width: 768px) {
        //     .home-header {
        //         height: calc(100vh - var(--nav-headerM));
        //         margin-top: calc(var(--nav-headerM) - 0.25em);
        //         // margin-top: var(--nav-headerM);
        //     }
        // }
    </style>

    <script is:inline></script>
</Layout>
