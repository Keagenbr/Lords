---
import Layout from "../layouts/Layout.astro"; // Import the main layout part
// import Menu from "../components/Menu/MenuMain.astro"; // Import the menu component
// import MenuSlider from "../components/Menu/MenuSlider.astro"; // Import the menu slider component
// import MenuPlatter from "../components/Menu/MenuPlatter.astro"; // Import the menu platter component

// import { Image } from "astro:assets";
// import headerImg from "../../src/assets/headerImg2.webp";
// import HeaderBottom from "../../src/assets/headerBottom.svg";

// Gets the public URL for weekly specials image from Supabase Storage.
import { getPublicImageUrl } from "../lib/supabaseStorage";

interface Props {
    filename?: string;
    folder?: string;
    label?: string;
}

const {
    filename = "weeklySpecials.jpg",
    label = "Weekly Specials",
    folder = "MenuSpecials",
} = Astro.props;

// Built on the server — no `window` involved.
const imageUrl = getPublicImageUrl(`${folder}/${filename}`);

// import MenuMain from "../components/Menu/MenuMain.astro";
// import Special from "../components/Menu/MenuSlider.astro";

// const { title = "Home" } = Astro.props;
---

<Layout title="Home">
    <main class="home">
        <header class="home-header">
            <h1>
                <span>Welcome to </span>
                Lords and Legends
            </h1>

            <a href="/menu" class="menu-btn">
                View Our Menu
            </a>
            <section class="triangle"></section>
            <!-- <HeaderBottom class="home-header-down" /> -->
        </header>
        <section class="home-about">
            <h2>About Us</h2>
            <p>
                Lords and Legends was established over 15 years ago in
                Amanzimtoti, South Coast by a legend, Bruce Lithgow. Bruce had a
                vision to create a social, viby and enjoyable dining experience
                for locals and visitors. Today Lords and Legends have also
                established themselves at Brighton Beach. Proudly bringing
                people of Brighton the same food and viby environment.
            </p>
            <p>
                If you are looking for a place to enjoy your favourite sports
                broadcasts and to eat the most delicious food, then you must
                visit Lords & Legends Sports Cafe which has an extensive menu
                catering for everyone’s taste. With a great selection of food,
                refreshing drinks and party atmosphere, there is no better place
                to dine than in our Lords & Legends Sports Cafe!
            </p>
        </section>

        <!-- <section class="Main-menu">
            <MenuMain />
        </section>

        <section class="Specials">
            <Special />
        </section> -->

        <aside class="Specials">
            <h3>Daily Specials</h3>
            <div class="weeklySpecials-wrapper">
                <div
                    class="menu-image-container"
                    x-data="{ lightboxOpen: false }"
                    @click="lightboxOpen = true"
                >
                    <img
                        src={imageUrl}
                        alt={label}
                        class="menu-image"
                        loading="lazy"
                    />

                    <a
                        href={imageUrl}
                        download={filename}
                        class="download-btn"
                        @click.stop
                    >
                        ⬇ Download Menu
                    </a>

                    <div
                        class="lightbox-overlay"
                        x-show="lightboxOpen"
                        x-cloak
                        @click="lightboxOpen = false"
                        x-transition:enter="transition ease-out duration-300"
                        x-transition:enter-start="opacity-0"
                        x-transition:enter-end="opacity-100"
                    >
                        <div class="lightbox-content" @click.stop>
                            <button
                                class="close-lightbox-btn"
                                @click="lightboxOpen = false"
                            >
                                &times;
                            </button>
                            <img src={imageUrl} alt={`Full screen ${label}`} />
                            <a
                                href={imageUrl}
                                download={filename}
                                class="download-btn lightbox-download"
                                @click.stop
                            >
                                ⬇ Download
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </aside>
    </main>
</Layout>
