---
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";
import { getSessionUser, isAdminUser } from "../../lib/adminAuth";
import "../../styles/password-toggle.css";
import {
    checkLoginAllowed,
    recordLoginFailure,
    clearLoginFailures,
    getClientIp,
    describeLoginFailure,
} from "../../lib/authFailure";

export const prerender = false;

const slugOf = (str: string) =>
    str
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, "")
        .replace(/\s+/g, "-");

let errorMessage = "";

// Helper to calculate target slug for staff
const getTargetSlug = (user: any) => {
    const rawTarget =
        user.user_metadata?.staff_slug ||
        user.user_metadata?.name ||
        user.email?.split("@")[0] ||
        "";
    return slugOf(rawTarget);
};

// 1. If already logged in, redirect immediately. getSessionUser() also
// transparently refreshes an expired access token.
const existingUser = await getSessionUser(Astro.cookies);
if (existingUser) {
    if (isAdminUser(existingUser)) {
        return Astro.redirect("/staff");
    } else {
        return Astro.redirect(`/staff/${getTargetSlug(existingUser)}`);
    }
}

// 2. Handle POST login form submission
if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const email = formData.get("email")?.toString();
        const password = formData.get("password")?.toString();

        // Same brute-force protection and generic wording as the admin
        // sign-in route (src/lib/authFailure.ts).
        const ip = getClientIp(Astro.request, Astro.clientAddress);

        if (!email || !password) {
            errorMessage = describeLoginFailure("missing");
        } else if (!checkLoginAllowed(ip, email).allowed) {
            const gate = checkLoginAllowed(ip, email);
            Astro.response.status = 429;
            Astro.response.headers.set(
                "Retry-After",
                String(gate.retryAfterSeconds),
            );
            errorMessage = describeLoginFailure("locked", {
                retryAfterSeconds: gate.retryAfterSeconds,
            });
        } else {
            const { data, error } = await supabase.auth.signInWithPassword({
                email,
                password,
            });

            if (error || !data.session) {
                if (error && (error.status ?? 0) >= 500) {
                    // Server fault: not the person's mistake, so don't count it.
                    errorMessage = describeLoginFailure("error");
                } else {
                    const result = recordLoginFailure(ip, email);
                    errorMessage = describeLoginFailure(
                        result.locked ? "locked" : "invalid",
                        {
                            attemptsLeft: result.attemptsLeft,
                            retryAfterSeconds: result.retryAfterSeconds,
                        },
                    );
                }
            } else {
                clearLoginFailures(ip, email);
                Astro.cookies.set(
                    "sb-access-token",
                    data.session.access_token,
                    {
                        path: "/",
                        httpOnly: true,
                        secure: true,
                        sameSite: "lax",
                    },
                );
                Astro.cookies.set(
                    "sb-refresh-token",
                    data.session.refresh_token,
                    {
                        path: "/",
                        httpOnly: true,
                        secure: true,
                        sameSite: "lax",
                    },
                );

                const user = data.user;

                if (isAdminUser(user)) {
                    return Astro.redirect("/staff");
                } else {
                    return Astro.redirect(`/staff/${getTargetSlug(user)}`);
                }
            }
        }
    } catch (err) {
        // Never show raw internal error text to the visitor.
        console.error("Staff login failed:", err);
        errorMessage = describeLoginFailure("error");
    }
}
---

<Layout title="Staff Portal Login">
    <main class="login-container">
        <div class="login-card">
            <h1>Staff Portal Login</h1>
            <p class="subtitle">
                Sign in to view your sales & performance profile
            </p>

            {errorMessage && <div class="error-banner">{errorMessage}</div>}

            <form method="POST" class="login-form" data-login-form>
                <div class="form-group">
                    <label for="email" data-icon="email">
                        Email Address
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        placeholder="staff@restaurant.com"
                    />
                </div>

                <div class="form-group">
                    <label for="password" data-icon="password">
                        Password
                    </label>
                    <div class="pw-wrap" data-pw-field>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="pw-input"
                            autocomplete="current-password"
                            placeholder="••••••••"
                            required
                        />
                        <button
                            type="button"
                            class="pw-toggle"
                            aria-label="Show password"
                            aria-pressed="false"
                        >
                            <span
                                class="pw-eye ico-only"
                                data-icon="eye"
                            ></span>
                            <span
                                class="pw-eye-off ico-only"
                                data-icon="eye-off"
                            ></span>
                        </button>
                    </div>
                </div>

                <button type="submit" class="submit-btn" data-submit-label="Signing in...">
                    Sign In
                </button>
            </form>
        </div>
    </main>
</Layout>

<script>
    import "../../scripts/passwordToggle";
    import "../../scripts/submitGuard";
</script>

<style>
    .login-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .login-card {
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 2.5rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    }
    h1 {
        margin: 0 0 8px 0;
        font-size: 1.8rem;
        color: #1a202c;
        text-align: center;
    }
    .subtitle {
        text-align: center;
        color: #718096;
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }
    .error-banner {
        background: #fff5f5;
        border: 1px solid #feb2b2;
        color: #c53030;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
    }
    .form-group {
        margin-bottom: 1.25rem;
    }
    label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #4a5568;
        font-size: 0.9rem;
    }
    label[data-icon] {
        display: flex;
        align-items: center;
    }
    input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #cbd5e0;
        border-radius: 8px;
        font-size: 1rem;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }
    input:focus {
        outline: none;
        border-color: #00d4aa;
        box-shadow: 0 0 0 3px rgba(0, 212, 170, 0.2);
    }
    .submit-btn {
        width: 100%;
        background: #00d4aa;
        color: white;
        border: none;
        padding: 0.85rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.2s;
        margin-top: 0.5rem;
    }
    .submit-btn:hover {
        background: #00b894;
    }
</style>
