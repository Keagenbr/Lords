---
// /admin/menu-editor/choice-selections
// Owner-only choice library editor.
import Layout from "../../../layouts/Layout.astro";
import MenuEditorNav from "../../../components/MenuEditorNav.astro";
import MenuChoiceEditor from "../../../components/MenuChoiceEditor.astro";
import { guardOwnerPage } from "../../../lib/adminAuth";

export const prerender = false;

const { response } = await guardOwnerPage(Astro.cookies, Astro.redirect);
if (response) return response;
---

<Layout title="Menu Editor - Choice Selections">
    <MenuEditorNav active="choice-selections" owner={true} />
    <MenuChoiceEditor />
</Layout>
