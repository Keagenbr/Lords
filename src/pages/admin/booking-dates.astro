---
// -> /admin/booking-dates (Admin + Owner)
import Layout from "../../layouts/Layout.astro";
import AuthSessionManager from "../../components/AuthSessionManager.astro";
import {
    guardAdminPage,
    getDisplayName,
    getUserRole,
} from "../../lib/adminAuth";
import { supabaseAdmin } from "../../lib/supabaseAdmin";
import { getBookingCalendarLocation } from "../../lib/siteInfo";
import { buildGoogleCalendarTemplateUrl } from "../../lib/googleCalendar";
import { buildBookingConfirmationUrl } from "../../lib/bookingMessages";

export const prerender = false;

const { user, response } = await guardAdminPage(Astro.cookies, Astro.redirect);
if (response) return response;

const todayParts = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Africa/Johannesburg",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
}).formatToParts(new Date());
const southAfricaToday = `${todayParts.find((p) => p.type === "year")?.value}-${todayParts.find((p) => p.type === "month")?.value}-${todayParts.find((p) => p.type === "day")?.value}`;

const [blockedResult, pendingResult, timeBlockResult, confirmedResult] = await Promise.all([
    supabaseAdmin
        .from("blocked_dates")
        .select("id,start_date,end_date,reason,created_at,created_by,source_booking_id")
        .order("start_date", { ascending: true }),
    supabaseAdmin
        .from("booking_requests")
        .select(
            "id,booking_no,created_at,people_count,contact_name,booking_name,contact_phone,booking_date,booking_time,booking_end_time,status,decided_at,decided_by,decision_note",
        )
        .eq("status", "requested")
        .order("created_at", { ascending: true }),
    supabaseAdmin
        .from("booking_time_blocks")
        .select("id,block_date,start_time,end_time,reason,created_at,created_by,source_booking_id")
        .order("block_date", { ascending: true })
        .order("start_time", { ascending: true }),
    supabaseAdmin
        .from("booking_requests")
        .select(
            "id,booking_no,created_at,people_count,contact_name,booking_name,contact_phone,booking_date,booking_time,booking_end_time,status,decided_at,decided_by,decision_note",
        )
        .eq("status", "confirmed")
        .gte("booking_date", southAfricaToday)
        .order("booking_date", { ascending: true })
        .order("booking_time", { ascending: true })
        .limit(200),
]);

const rows = blockedResult.data ?? [];
const pendingBookings = pendingResult.data ?? [];
const timeBlockRows = timeBlockResult.data ?? [];
const bookingCalendarLocation = await getBookingCalendarLocation();
const confirmedBookings = (confirmedResult.data ?? []).map((booking) => {
    // WhatsApp message that confirms the booking to the customer (nothing is sent automatically).
    const whatsappUrl = buildBookingConfirmationUrl(booking, { location: bookingCalendarLocation });

    // Bookings made without a time have no calendar entry.
    if (!booking.booking_date || !booking.booking_time) {
        return { ...booking, calendarUrl: null, whatsappUrl };
    }

    let calendarUrl: string | null = null;
    try {
        calendarUrl = buildGoogleCalendarTemplateUrl({
            title: `Lords & Legends - Group Booking - ${booking.booking_name || booking.contact_name || `LL-B${booking.booking_no}`}`,
            date: booking.booking_date,
            startTime: String(booking.booking_time).slice(0, 5),
            endTime: booking.booking_end_time ? String(booking.booking_end_time).slice(0, 5) : null,
            details: [
                "Lords & Legends group booking",
                `Booking Ref: LL-B${booking.booking_no}`,
                `People: ${booking.people_count}`,
                `Contact: ${booking.contact_name}`,
            ].join("\n"),
            location: bookingCalendarLocation,
        });
    } catch (error) {
        console.error(`[admin/booking-dates] calendar URL generation failed for ${booking.id}:`, error);
    }

    return { ...booking, calendarUrl, whatsappUrl };
});

const initialBlocks = JSON.stringify(rows);
const initialPending = JSON.stringify(pendingBookings);
const initialTimeBlocks = JSON.stringify(timeBlockRows);
const initialConfirmed = JSON.stringify(confirmedBookings);
const initialCalendarLocation = JSON.stringify(bookingCalendarLocation);
const role = getUserRole(user);

const listError = blockedResult.error || pendingResult.error || timeBlockResult.error || confirmedResult.error;
---

<Layout title="Admin - Booking Dates">
    <main
        class="booking-dates-container"
        x-data={`bookingDatesManager(${initialBlocks}, ${initialPending}, ${initialTimeBlocks}, ${initialConfirmed}, ${initialCalendarLocation})`}
    >
        <AuthSessionManager
            displayName={getDisplayName(user)}
            userEmail={user.email}
            loginPath="/admin/login"
            timeoutMinutes={15}
        />

        <header class="booking-dates-header">
            <h1>Booking Dates</h1>
            <p>
                Admin/Owner access. Block dates or individual times customers should not be able to request for group bookings. Current role: <strong>{role}</strong>.
            </p>
            <a href="/admin" class="back-link">&larr; Back to Admin Portal</a>
        </header>

        {listError && (
            <p class="notice error">Some booking availability data could not be loaded: {listError.message}</p>
        )}

        <p
            class="save-status"
            x-show="statusMessage"
            x-text="statusMessage"
            :class="statusIsError ? 'status-error' : 'status-ok'"
            x-cloak
        ></p>

        <template x-if="pendingBookings.length > 0 || activeBooking">
            <div class="pending-booking-launcher-wrap">
                <button
                    type="button"
                    class="pending-booking-launcher"
                    @click="openReviewPanel()"
                >
                    <span class="pending-booking-dot" aria-hidden="true"></span>
                    <span>
                        <strong x-text="pendingBookings.length"></strong>
                        <span x-text="pendingBookings.length === 1 ? 'pending booking request' : 'pending booking requests'"></span>
                    </span>
                    <span class="pending-booking-launcher-arrow" aria-hidden="true">›</span>
                </button>
            </div>
        </template>

        <section class="setting-card">
            <h2>Block a date or date range</h2>
            <p class="hint">
                Use the same date for Start and End when only one day should be unavailable. Individual time blocks can be created after confirming a booking below.
            </p>

            <form class="block-form" @submit.prevent="addBlock()">
                <div class="date-grid">
                    <div>
                        <label for="block-start">Start date</label>
                        <input id="block-start" type="date" x-model="startDate" required />
                    </div>
                    <div>
                        <label for="block-end">End date</label>
                        <input id="block-end" type="date" x-model="endDate" required />
                    </div>
                </div>

                <div>
                    <label for="block-reason">Reason (optional)</label>
                    <input
                        id="block-reason"
                        type="text"
                        maxlength="200"
                        x-model="reason"
                        placeholder="e.g. Private function"
                    />
                </div>

                <button class="save-btn" type="submit" :disabled="saving">
                    <span x-text="saving ? 'Saving…' : 'Block Dates'"></span>
                </button>
            </form>
        </section>

        <section class="blocks-card">
            <div class="section-heading">
                <div>
                    <h2>Blocked dates</h2>
                    <p class="hint">These dates are checked again on every booking submission.</p>
                </div>
                <span class="count-pill" x-text="`${blocks.length} block${blocks.length === 1 ? '' : 's'}`"></span>
            </div>

            <div class="selection-toolbar" x-show="blocks.length > 0" x-cloak>
                <label class="selection-check selection-check--master">
                    <input
                        type="checkbox"
                        :checked="allBlocksSelected"
                        :indeterminate="selectedBlockIds.length > 0 && !allBlocksSelected"
                        @change="toggleAllBlocks($event.target.checked)"
                        aria-label="Select all blocked dates"
                    />
                    <span>Select all</span>
                </label>
                <span class="selection-count" x-text="selectedBlockIds.length ? `${selectedBlockIds.length} selected` : 'Select blocks to delete'" aria-live="polite"></span>
                <button
                    type="button"
                    class="bulk-delete-btn"
                    x-show="selectedBlockIds.length > 0"
                    @click="deleteSelectedBlocks()"
                    :disabled="bulkDeleting"
                >
                    <span x-text="bulkDeleting ? 'Deleting…' : 'Delete selected'"></span>
                </button>
            </div>

            <div x-show="blocks.length === 0" class="empty-state">
                No blocked dates are currently set.
            </div>

            <div class="blocks-list" x-show="blocks.length > 0">
                <template x-for="block in sortedBlocks()" :key="block.id">
                    <article class="block-row" :class="{ 'is-selected': selectedBlockIds.includes(block.id), 'is-deleting': deletingId === block.id || deletingId === 'bulk-block' && selectedBlockIds.includes(block.id) }">
                        <label class="row-select" :aria-label="`Select ${formatRange(block)} for deletion`">
                            <input type="checkbox" :value="block.id" x-model="selectedBlockIds" :disabled="bulkDeleting" />
                        </label>
                        <div class="block-row__text">
                            <strong x-text="formatRange(block)"></strong>
                            <span x-show="block.reason" x-text="block.reason"></span>
                        </div>
                        <button
                            type="button"
                            class="danger-btn delete-item-btn"
                            @click="removeBlock(block)"
                            :disabled="bulkDeleting || deletingId === block.id"
                        >
                            <span x-text="deletingId === block.id ? 'Deleting…' : 'Delete'"></span>
                        </button>
                    </article>
                </template>
            </div>
        </section>

        <section class="blocks-card">
            <div class="section-heading">
                <div>
                    <h2>Blocked time slots</h2>
                    <p class="hint">These individual time blocks are unavailable on the booking calendar. They can be created after a booking is confirmed.</p>
                </div>
                <span class="count-pill" x-text="`${timeBlocks.length} slot${timeBlocks.length === 1 ? '' : 's'}`"></span>
            </div>

            <div class="selection-toolbar" x-show="timeBlocks.length > 0" x-cloak>
                <label class="selection-check selection-check--master">
                    <input
                        type="checkbox"
                        :checked="allTimeBlocksSelected"
                        :indeterminate="selectedTimeBlockIds.length > 0 && !allTimeBlocksSelected"
                        @change="toggleAllTimeBlocks($event.target.checked)"
                        aria-label="Select all blocked time slots"
                    />
                    <span>Select all</span>
                </label>
                <span class="selection-count" x-text="selectedTimeBlockIds.length ? `${selectedTimeBlockIds.length} selected` : 'Select slots to delete'" aria-live="polite"></span>
                <button
                    type="button"
                    class="bulk-delete-btn"
                    x-show="selectedTimeBlockIds.length > 0"
                    @click="deleteSelectedTimeBlocks()"
                    :disabled="bulkDeleting"
                >
                    <span x-text="bulkDeleting ? 'Deleting…' : 'Delete selected'"></span>
                </button>
            </div>

            <div x-show="timeBlocks.length === 0" class="empty-state">
                No individual time slots are currently blocked.
            </div>

            <div class="blocks-list" x-show="timeBlocks.length > 0">
                <template x-for="block in sortedTimeBlocks()" :key="block.id">
                    <article class="block-row block-row--time" :class="{ 'is-selected': selectedTimeBlockIds.includes(block.id), 'is-deleting': deletingId === `time-${block.id}` || deletingId === 'bulk-time' && selectedTimeBlockIds.includes(block.id) }">
                        <label class="row-select" :aria-label="`Select ${formatDate(block.block_date)} ${block.start_time.slice(0,5)} to ${block.end_time.slice(0,5)} for deletion`">
                            <input type="checkbox" :value="block.id" x-model="selectedTimeBlockIds" :disabled="bulkDeleting" />
                        </label>
                        <div class="block-row__text">
                            <strong x-text="`${formatDate(block.block_date)} · ${block.start_time.slice(0,5)}–${block.end_time.slice(0,5)}`"></strong>
                            <span x-show="block.reason" x-text="block.reason"></span>
                        </div>
                        <button
                            type="button"
                            class="danger-btn delete-item-btn"
                            @click="removeTimeBlock(block)"
                            :disabled="bulkDeleting || deletingId === `time-${block.id}`"
                        >
                            <span x-text="deletingId === `time-${block.id}` ? 'Deleting…' : 'Delete'"></span>
                        </button>
                    </article>
                </template>
            </div>
        </section>

        <section class="blocks-card confirmed-bookings-card" x-show="confirmedBookings.length > 0" x-cloak>
            <div class="section-heading">
                <div>
                    <h2>Already booked</h2>
                    <p class="hint">Confirmed group bookings from the booking form. Add any booking to your Google Calendar without using a Google API.</p>
                </div>
                <span class="count-pill" x-text="`${confirmedBookings.length} booking${confirmedBookings.length === 1 ? '' : 's'}`"></span>
            </div>

            <div class="selection-toolbar" x-show="confirmedBookings.length > 0" x-cloak>
                <label class="selection-check selection-check--master">
                    <input
                        type="checkbox"
                        :checked="allConfirmedBookingsSelected"
                        :indeterminate="selectedConfirmedBookingIds.length > 0 && !allConfirmedBookingsSelected"
                        @change="toggleAllConfirmedBookings($event.target.checked)"
                        aria-label="Select all confirmed bookings"
                    />
                    <span>Select all</span>
                </label>
                <span class="selection-count" x-text="selectedConfirmedBookingIds.length ? `${selectedConfirmedBookingIds.length} selected` : 'Select bookings to delete'" aria-live="polite"></span>
                <button
                    type="button"
                    class="bulk-delete-btn"
                    x-show="selectedConfirmedBookingIds.length > 0"
                    @click="deleteSelectedConfirmedBookings()"
                    :disabled="bulkDeleting"
                >
                    <span x-text="bulkDeleting ? 'Deleting…' : 'Delete selected'"></span>
                </button>
            </div>

            <div class="confirmed-bookings-list">
                <template x-for="booking in sortedConfirmedBookings()" :key="booking.id">
                    <article class="confirmed-booking-row" :class="{ 'is-selected': selectedConfirmedBookingIds.includes(booking.id), 'is-deleting': deletingId === `booking-${booking.id}` || deletingId === 'bulk-booking' && selectedConfirmedBookingIds.includes(booking.id) }">
                        <label class="row-select" :aria-label="`Select LL-B${booking.booking_no} for deletion`">
                            <input type="checkbox" :value="booking.id" x-model="selectedConfirmedBookingIds" :disabled="bulkDeleting" />
                        </label>
                        <div class="confirmed-booking-row__text">
                            <span class="booking-ref" x-text="`LL-B${booking.booking_no}`"></span>
                            <strong x-text="booking.booking_name || booking.contact_name"></strong>
                            <span x-text="`${booking.people_count} people · ${formatDate(booking.booking_date)} · ${timeLabel(booking)}`"></span>
                        </div>
                        <template x-if="editingId === booking.id">
                            <form class="edit-booking-form" @submit.prevent="saveEdit(booking)">
                                <label>
                                    Date
                                    <input type="date" x-model="editForm.date" required />
                                </label>
                                <label>
                                    Start time
                                    <select x-model="editForm.start">
                                        <option value="">Not specified</option>
                                        <template x-for="time in timeChoices('start')" :key="time">
                                            <option :value="time" x-text="time"></option>
                                        </template>
                                    </select>
                                </label>
                                <label>
                                    Finish time
                                    <select x-model="editForm.end">
                                        <option value="">Not specified</option>
                                        <template x-for="time in timeChoices('end')" :key="time">
                                            <option :value="time" x-text="time"></option>
                                        </template>
                                    </select>
                                </label>
                                <p class="edit-booking-error" x-show="editError" x-text="editError" role="alert"></p>
                                <div class="edit-booking-actions">
                                    <button type="button" class="secondary-btn" @click="cancelEdit()" :disabled="editSaving">Cancel</button>
                                    <button type="submit" class="save-btn" :disabled="editSaving">
                                        <span x-text="editSaving ? 'Saving…' : 'Save changes'"></span>
                                    </button>
                                </div>
                            </form>
                        </template>
                        <div class="confirmed-booking-row__actions">
                            <a
                                class="whatsapp-confirm-btn"
                                :class="{ 'is-disabled': !booking.whatsappUrl }"
                                :href="booking.whatsappUrl || undefined"
                                target="_blank"
                                rel="noopener noreferrer"
                                @click="if (!booking.whatsappUrl) $event.preventDefault()"
                                :aria-disabled="booking.whatsappUrl ? 'false' : 'true'"
                            >
                                <span aria-hidden="true">&#128172;</span>
                                Confirm via WhatsApp
                            </a>
                            <button type="button" class="secondary-btn" @click="startEdit(booking)" x-show="editingId !== booking.id">
                                Change date / time
                            </button>
                            <a
                                class="calendar-btn"
                                :class="{ 'is-disabled': !canAddToCalendar(booking) }"
                                :href="canAddToCalendar(booking) ? booking.calendarUrl : undefined"
                                target="_blank"
                                rel="noopener noreferrer"
                                @click="if (!canAddToCalendar(booking)) $event.preventDefault()"
                                :aria-disabled="canAddToCalendar(booking) ? 'false' : 'true'"
                            >
                                <span aria-hidden="true">&#128197;</span>
                                Add to Google Calendar
                            </a>
                            <button
                                type="button"
                                class="danger-btn delete-item-btn"
                                @click="deleteConfirmedBooking(booking)"
                                :disabled="bulkDeleting || deletingId === `booking-${booking.id}`"
                            >
                                <span x-text="deletingId === `booking-${booking.id}` ? 'Deleting…' : 'Delete'"></span>
                            </button>
                        </div>
                    </article>
                </template>
            </div>
        </section>

        <!-- Pending booking review panel. It is only rendered/activated when there is a pending request. -->
        <div
            class="pending-booking-overlay"
            x-show="reviewOpen"
            x-cloak
            @click.self="closeReviewPanel()"
            role="presentation"
        >
            <section
                class="pending-booking-panel"
                role="dialog"
                aria-modal="true"
                aria-labelledby="pending-booking-title"
                @click.stop
                tabindex="-1"
                x-ref="reviewPanel"
            >
                <template x-if="reviewStep === 'list'">
                    <div>
                        <div class="pending-panel-header">
                            <div>
                                <p class="panel-kicker">Booking requests</p>
                                <h2 id="pending-booking-title">Pending confirmations</h2>
                                <p x-text="`${pendingBookings.length} request${pendingBookings.length === 1 ? '' : 's'} waiting for review.`"></p>
                            </div>
                            <button
                                type="button"
                                class="panel-close"
                                @click="closeReviewPanel()"
                                aria-label="Close booking requests"
                            >&times;</button>
                        </div>

                        <div class="pending-booking-list">
                            <template x-for="booking in pendingBookings" :key="booking.id">
                                <article class="pending-booking-card">
                                    <div class="pending-booking-card__top">
                                        <div>
                                            <span class="booking-ref" x-text="`LL-B${booking.booking_no}`"></span>
                                            <h3 x-text="booking.booking_name || booking.contact_name"></h3>
                                        </div>
                                        <span class="pending-pill">Pending</span>
                                    </div>

                                    <dl class="booking-summary">
                                        <div><dt>People</dt><dd x-text="booking.people_count"></dd></div>
                                        <div><dt>Contact</dt><dd x-text="booking.contact_name"></dd></div>
                                        <div><dt>Phone</dt><dd x-text="booking.contact_phone"></dd></div>
                                        <div><dt>Date</dt><dd x-text="formatDate(booking.booking_date)"></dd></div>
                                        <div><dt>Time</dt><dd x-text="timeLabel(booking)"></dd></div>
                                    </dl>

                                    <template x-if="editingId === booking.id">
                                        <form class="edit-booking-form" @submit.prevent="saveEdit(booking)">
                                            <label>
                                                Date
                                                <input type="date" x-model="editForm.date" required />
                                            </label>
                                            <label>
                                                Start time
                                                <select x-model="editForm.start">
                                                    <option value="">Not specified</option>
                                                    <template x-for="time in timeChoices('start')" :key="time">
                                                        <option :value="time" x-text="time"></option>
                                                    </template>
                                                </select>
                                            </label>
                                            <label>
                                                Finish time
                                                <select x-model="editForm.end">
                                                    <option value="">Not specified</option>
                                                    <template x-for="time in timeChoices('end')" :key="time">
                                                        <option :value="time" x-text="time"></option>
                                                    </template>
                                                </select>
                                            </label>
                                            <p class="edit-booking-error" x-show="editError" x-text="editError" role="alert"></p>
                                            <div class="edit-booking-actions">
                                                <button type="button" class="secondary-btn" @click="cancelEdit()" :disabled="editSaving">Cancel</button>
                                                <button type="submit" class="save-btn" :disabled="editSaving">
                                                    <span x-text="editSaving ? 'Saving…' : 'Save changes'"></span>
                                                </button>
                                            </div>
                                        </form>
                                    </template>

                                    <div class="pending-booking-actions">
                                        <button
                                            type="button"
                                            class="secondary-btn"
                                            @click="startEdit(booking)"
                                            x-show="editingId !== booking.id"
                                        >Change date / time</button>
                                        <button
                                            type="button"
                                            class="danger-btn"
                                            @click="denyBooking(booking)"
                                            :disabled="reviewSavingId === booking.id"
                                        >
                                            <span x-text="reviewSavingId === booking.id ? 'Saving…' : 'Deny Booking'"></span>
                                        </button>
                                        <button
                                            type="button"
                                            class="save-btn pending-confirm-btn"
                                            @click="confirmBooking(booking)"
                                            :disabled="reviewSavingId === booking.id"
                                        >
                                            <span x-text="reviewSavingId === booking.id ? 'Confirming…' : 'Confirm Booking'"></span>
                                        </button>
                                    </div>
                                </article>
                            </template>
                        </div>
                    </div>
                </template>

                <template x-if="reviewStep === 'blocks' && activeBooking">
                    <div>
                        <div class="pending-panel-header">
                            <div>
                                <p class="panel-kicker">Booking confirmed</p>
                                <h2>Block availability</h2>
                                <p>
                                    <strong x-text="`LL-B${activeBooking.booking_no}`"></strong>
                                    is confirmed. You can now block the booking time, the entire day, or add multiple time/day blocks.
                                </p>
                            </div>
                            <button
                                type="button"
                                class="panel-close"
                                @click="finishReviewWithoutBlocks()"
                                aria-label="Close availability options"
                            >&times;</button>
                        </div>

                        <div class="confirmed-booking-summary">
                            <strong x-text="activeBooking.booking_name || activeBooking.contact_name"></strong>
                            <span x-text="`${activeBooking.people_count} people · ${formatDate(activeBooking.booking_date)} · ${timeLabel(activeBooking)}`"></span>
                        </div>

                        <div class="calendar-action-row" x-show="activeBooking.whatsappUrl">
                            <a
                                class="whatsapp-confirm-btn whatsapp-confirm-btn--large"
                                :href="activeBooking.whatsappUrl"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span aria-hidden="true">&#128172;</span>
                                Confirm via WhatsApp
                            </a>
                            <p class="calendar-helper-text">Opens a chat with the customer and a ready-made confirmation message. Nothing is sent until you press Send in WhatsApp.</p>
                        </div>

                        <div class="calendar-action-row" x-show="canAddToCalendar(activeBooking)">
                            <a
                                class="calendar-btn calendar-btn--large"
                                :href="activeBooking.calendarUrl || undefined"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span aria-hidden="true">&#128197;</span>
                                Add to Google Calendar
                            </a>
                            <p class="calendar-helper-text">Opens a pre-filled 2-hour event at the configured booking location. Nothing is sent to Google until you save it there.</p>
                        </div>

                        <div class="block-presets">
                            <button type="button" class="preset-btn" @click="setBookingTimePreset()">
                                <strong>Block booking time</strong>
                                <span x-text="`${activeBooking.booking_date} · ${timeLabel(activeBooking)}`"></span>
                            </button>
                            <button type="button" class="preset-btn" @click="setBookingDayPreset()">
                                <strong>Block full day</strong>
                                <span x-text="formatDate(activeBooking.booking_date)"></span>
                            </button>
                            <button type="button" class="preset-btn" @click="startCustomBlocks()">
                                <strong>Custom / multiple blocks</strong>
                                <span>Add different days and times</span>
                            </button>
                        </div>

                        <div class="custom-block-editor">
                            <div class="custom-block-editor__head">
                                <div>
                                    <h3>Selected blocks</h3>
                                    <p>Full-day blocks use the Day option. Time blocks should cover the period you want unavailable.</p>
                                </div>
                                <button type="button" class="secondary-btn" @click="addBlockRow()">+ Add block</button>
                            </div>

                            <div class="custom-block-list">
                                <template x-for="(row, index) in blockRows" :key="row.key">
                                    <div class="custom-block-row">
                                        <label>
                                            Type
                                            <select x-model="row.type">
                                                <option value="time">Time</option>
                                                <option value="day">Full day</option>
                                            </select>
                                        </label>
                                        <label>
                                            Date
                                            <input type="date" x-model="row.date" />
                                        </label>
                                        <template x-if="row.type === 'time'">
                                            <div class="time-range-fields">
                                                <label>
                                                    Start
                                                    <select x-model="row.startTime">
                                                        <option value="">Start</option>
                                                        <template x-for="time in timeChoices('start')" :key="time">
                                                            <option :value="time" x-text="time"></option>
                                                        </template>
                                                    </select>
                                                </label>
                                                <label>
                                                    End
                                                    <select x-model="row.endTime">
                                                        <option value="">End</option>
                                                        <template x-for="time in timeChoices('end')" :key="time">
                                                            <option :value="time" x-text="time"></option>
                                                        </template>
                                                    </select>
                                                </label>
                                            </div>
                                        </template>
                                        <button
                                            type="button"
                                            class="row-remove-btn"
                                            @click="removeBlockRow(index)"
                                            :disabled="blockRows.length === 1"
                                            aria-label="Remove block row"
                                        >&times;</button>
                                    </div>
                                </template>
                            </div>
                        </div>

                        <p class="block-save-error" x-show="blockError" x-text="blockError" role="alert"></p>

                        <div class="pending-panel-actions">
                            <button type="button" class="secondary-btn" @click="finishReviewWithoutBlocks()">
                                Don't block anything
                            </button>
                            <button type="button" class="save-btn" @click="saveBookingBlocks()" :disabled="blockSaving">
                                <span x-text="blockSaving ? 'Saving blocks…' : 'Save availability blocks'"></span>
                            </button>
                        </div>
                    </div>
                </template>
            </section>
        </div>
    </main>
</Layout>

<script is:inline>
    document.addEventListener("alpine:init", () => {
        Alpine.data("bookingDatesManager", (initialBlocks, initialPendingBookings, initialTimeBlocks, initialConfirmedBookings, initialCalendarLocation) => ({
            blocks: initialBlocks || [],
            pendingBookings: initialPendingBookings || [],
            timeBlocks: initialTimeBlocks || [],
            confirmedBookings: initialConfirmedBookings || [],
            calendarLocation: initialCalendarLocation || "Lords & Legends",
            startDate: "",
            endDate: "",
            reason: "",
            saving: false,
            deletingId: "",
            statusMessage: "",
            statusIsError: false,
            reviewOpen: false,
            reviewStep: "list",
            reviewSavingId: "",
            activeBooking: null,
            blockSaving: false,
            blockError: "",
            blockRows: [],
            nextRowId: 1,

            // Inline "change date / time" editor (one booking at a time)
            editingId: "",
            editForm: { date: "", start: "", end: "" },
            editSaving: false,
            editError: "",

            // Selection state is intentionally kept separate for each data set so
            // an Admin can delete multiple entries without mixing entity types.
            selectedBlockIds: [],
            selectedTimeBlockIds: [],
            selectedConfirmedBookingIds: [],
            bulkDeleting: false,

            get allBlocksSelected() {
                return this.blocks.length > 0 && this.selectedBlockIds.length === this.blocks.length;
            },

            get allTimeBlocksSelected() {
                return this.timeBlocks.length > 0 && this.selectedTimeBlockIds.length === this.timeBlocks.length;
            },

            get allConfirmedBookingsSelected() {
                return this.confirmedBookings.length > 0 && this.selectedConfirmedBookingIds.length === this.confirmedBookings.length;
            },

            init() {
                if (this.pendingBookings.length > 0) {
                    this.reviewOpen = true;
                    this.$nextTick(() => this.$refs.reviewPanel?.focus());
                }
            },

            formatDate(iso) {
                return new Intl.DateTimeFormat("en-ZA", {
                    weekday: "short",
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                }).format(new Date(`${iso}T12:00:00`));
            },

            formatRange(block) {
                return block.start_date === block.end_date
                    ? this.formatDate(block.start_date)
                    : `${this.formatDate(block.start_date)} – ${this.formatDate(block.end_date)}`;
            },

            sortedBlocks() {
                return [...this.blocks].sort((a, b) =>
                    a.start_date.localeCompare(b.start_date),
                );
            },

            sortedTimeBlocks() {
                return [...this.timeBlocks].sort((a, b) =>
                    `${a.block_date}-${a.start_time}`.localeCompare(`${b.block_date}-${b.start_time}`),
                );
            },

            sortedConfirmedBookings() {
                return [...this.confirmedBookings].sort((a, b) =>
                    `${a.booking_date}-${a.booking_time || ""}`.localeCompare(`${b.booking_date}-${b.booking_time || ""}`),
                );
            },

            // "18:00 – 20:00", "18:00" or "Time not specified"
            timeLabel(booking) {
                const start = booking?.booking_time ? String(booking.booking_time).slice(0, 5) : "";
                const end = booking?.booking_end_time ? String(booking.booking_end_time).slice(0, 5) : "";
                if (!start) return "Time not specified";
                return end ? `${start} – ${end}` : start;
            },

            startEdit(booking) {
                this.editingId = booking.id;
                this.editError = "";
                this.editForm = {
                    date: booking.booking_date || "",
                    start: booking.booking_time ? String(booking.booking_time).slice(0, 5) : "",
                    end: booking.booking_end_time ? String(booking.booking_end_time).slice(0, 5) : "",
                };
            },

            cancelEdit() {
                this.editingId = "";
                this.editError = "";
            },

            // Saves a new date/time through POST /admin/booking-requests (action "reschedule").
            async saveEdit(booking) {
                if (this.editSaving) return;
                this.editError = "";
                const { date, start, end } = this.editForm;
                if (!date) { this.editError = "Please choose a date."; return; }
                if (start && end && end <= start) { this.editError = "The finish time must be after the start time."; return; }

                this.editSaving = true;
                try {
                    const res = await fetch("/admin/booking-requests", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({
                            id: booking.id,
                            action: "reschedule",
                            bookingDate: date,
                            bookingTime: start,
                            bookingEndTime: end,
                        }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || "Could not change the booking.");

                    const updated = data.booking;
                    // Pending list: swap in the updated row.
                    this.pendingBookings = this.pendingBookings.map((item) => (item.id === updated.id ? { ...item, ...updated } : item));
                    // Confirmed list: keep the new calendar + "updated" WhatsApp links.
                    this.confirmedBookings = this.confirmedBookings.map((item) =>
                        item.id === updated.id
                            ? { ...item, ...updated, calendarUrl: data.calendarUrl || null, whatsappUrl: data.whatsappUrl || item.whatsappUrl || null }
                            : item,
                    );
                    this.statusMessage = `LL-B${updated.booking_no} changed to ${this.formatDate(updated.booking_date)} · ${this.timeLabel(updated)}.` +
                        (data.warnings?.length ? ` Note: ${data.warnings.join(" ")}` : "") +
                        (data.whatsappUrl ? " Use “Confirm via WhatsApp” to tell the customer." : "");
                    this.statusIsError = false;
                    this.editingId = "";
                } catch (error) {
                    this.editError = error instanceof Error ? error.message : "Could not change the booking.";
                } finally {
                    this.editSaving = false;
                }
            },

            canAddToCalendar(booking) {
                return Boolean(booking?.calendarUrl);
            },


            openReviewPanel() {
                this.reviewOpen = true;
                this.reviewStep = this.activeBooking ? "blocks" : "list";
                this.$nextTick(() => this.$refs.reviewPanel?.focus());
            },

            closeReviewPanel() {
                if (this.activeBooking && this.reviewStep === "blocks" && this.pendingBookings.length === 0) {
                    this.finishReviewWithoutBlocks();
                    return;
                }
                this.reviewOpen = false;
                this.reviewStep = "list";
            },

            toggleAllBlocks(checked) {
                this.selectedBlockIds = checked ? this.blocks.map((block) => block.id) : [];
            },

            toggleAllTimeBlocks(checked) {
                this.selectedTimeBlockIds = checked ? this.timeBlocks.map((block) => block.id) : [];
            },

            toggleAllConfirmedBookings(checked) {
                this.selectedConfirmedBookingIds = checked ? this.confirmedBookings.map((booking) => booking.id) : [];
            },

            async confirmDeletion({ title, message }) {
                // Deletion is destructive; fail closed when the shared dialog system
                // is not available rather than silently approving the action.
                if (!window.siteDialog) return false;
                return window.siteDialog.confirm({
                    title,
                    message,
                    confirmText: "Delete",
                    cancelText: "Cancel",
                    tone: "danger",
                });
            },

            async deleteSelectedBlocks() {
                const ids = [...new Set(this.selectedBlockIds)].filter(Boolean);
                if (!ids.length || this.bulkDeleting) return;
                const confirmed = await this.confirmDeletion({
                    title: `Delete ${ids.length} blocked date${ids.length === 1 ? "" : "s"}?`,
                    message: "The selected date blocks will be removed and those dates will become available for booking again.",
                });
                if (!confirmed) return;

                this.bulkDeleting = true;
                this.deletingId = "bulk-block";
                try {
                    const res = await fetch("/admin/blocked-dates", {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({ ids }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || "Could not delete the selected date blocks.");
                    const deleted = new Set(data.deletedIds || ids);
                    this.blocks = this.blocks.filter((item) => !deleted.has(item.id));
                    this.selectedBlockIds = [];
                    this.statusMessage = `${ids.length} blocked date${ids.length === 1 ? "" : "s"} deleted.`;
                    this.statusIsError = false;
                } catch (error) {
                    this.statusMessage = error instanceof Error ? error.message : "Could not delete the selected date blocks.";
                    this.statusIsError = true;
                } finally {
                    this.deletingId = "";
                    this.bulkDeleting = false;
                }
            },

            async deleteSelectedTimeBlocks() {
                const ids = [...new Set(this.selectedTimeBlockIds)].filter(Boolean);
                if (!ids.length || this.bulkDeleting) return;
                const confirmed = await this.confirmDeletion({
                    title: `Delete ${ids.length} blocked time slot${ids.length === 1 ? "" : "s"}?`,
                    message: "The selected time slots will become available for group bookings again.",
                });
                if (!confirmed) return;

                this.bulkDeleting = true;
                this.deletingId = "bulk-time";
                try {
                    const res = await fetch("/admin/booking-blocks", {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({ ids, type: "time" }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || "Could not delete the selected time slots.");
                    const deleted = new Set(data.deletedIds || ids);
                    this.timeBlocks = this.timeBlocks.filter((item) => !deleted.has(item.id));
                    this.selectedTimeBlockIds = [];
                    this.statusMessage = `${ids.length} blocked time slot${ids.length === 1 ? "" : "s"} deleted.`;
                    this.statusIsError = false;
                } catch (error) {
                    this.statusMessage = error instanceof Error ? error.message : "Could not delete the selected time slots.";
                    this.statusIsError = true;
                } finally {
                    this.deletingId = "";
                    this.bulkDeleting = false;
                }
            },

            async deleteConfirmedBooking(booking) {
                if (!booking || this.bulkDeleting) return;
                const id = booking.id;
                const confirmed = await this.confirmDeletion({
                    title: `Delete LL-B${booking.booking_no}?`,
                    message: "This permanently removes the confirmed booking record. Any availability blocks created from it are not removed automatically.",
                });
                if (!confirmed) return;

                this.bulkDeleting = true;
                this.deletingId = `booking-${id}`;
                try {
                    const res = await fetch("/admin/booking-requests", {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({ ids: [id] }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || "Could not delete the booking.");
                    this.confirmedBookings = this.confirmedBookings.filter((item) => item.id !== id);
                    this.selectedConfirmedBookingIds = this.selectedConfirmedBookingIds.filter((selectedId) => selectedId !== id);
                    this.statusMessage = `LL-B${booking.booking_no} deleted.`;
                    this.statusIsError = false;
                } catch (error) {
                    this.statusMessage = error instanceof Error ? error.message : "Could not delete the booking.";
                    this.statusIsError = true;
                } finally {
                    this.deletingId = "";
                    this.bulkDeleting = false;
                }
            },

            async deleteSelectedConfirmedBookings() {
                const ids = [...new Set(this.selectedConfirmedBookingIds)].filter(Boolean);
                if (!ids.length || this.bulkDeleting) return;
                const confirmed = await this.confirmDeletion({
                    title: `Delete ${ids.length} confirmed booking${ids.length === 1 ? "" : "s"}?`,
                    message: "This permanently removes the selected confirmed booking records. Availability blocks created from them are not removed automatically.",
                });
                if (!confirmed) return;

                this.bulkDeleting = true;
                this.deletingId = "bulk-booking";
                try {
                    const res = await fetch("/admin/booking-requests", {
                        method: "DELETE",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({ ids }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || "Could not delete the selected bookings.");
                    const deleted = new Set(data.deletedIds || ids);
                    this.confirmedBookings = this.confirmedBookings.filter((item) => !deleted.has(item.id));
                    this.selectedConfirmedBookingIds = [];
                    this.statusMessage = `${ids.length} confirmed booking${ids.length === 1 ? "" : "s"} deleted.`;
                    this.statusIsError = false;
                } catch (error) {
                    this.statusMessage = error instanceof Error ? error.message : "Could not delete the selected bookings.";
                    this.statusIsError = true;
                } finally {
                    this.deletingId = "";
                    this.bulkDeleting = false;
                }
            },

            async addBlock() {
                this.statusMessage = "";
                this.statusIsError = false;

                if (!this.startDate || !this.endDate) {
                    this.statusMessage = "Choose both start and end dates.";
                    this.statusIsError = true;
                    return;
                }
                if (this.endDate < this.startDate) {
                    this.statusMessage = "End date cannot be before start date.";
                    this.statusIsError = true;
                    return;
                }

                this.saving = true;
                try {
                    const res = await fetch("/admin/blocked-dates", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({
                            startDate: this.startDate,
                            endDate: this.endDate,
                            reason: this.reason,
                        }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || "Could not block dates.");

                    this.blocks.push(data.block);
                    this.startDate = "";
                    this.endDate = "";
                    this.reason = "";
                    this.statusMessage = "Dates blocked.";
                    this.statusIsError = false;
                } catch (error) {
                    this.statusMessage = error instanceof Error ? error.message : "Could not block dates.";
                    this.statusIsError = true;
                } finally {
                    this.saving = false;
                }
            },

            async removeBlock(block) {
                if (!block || this.bulkDeleting) return;
                this.selectedBlockIds = [block.id];
                await this.deleteSelectedBlocks();
            },

            async removeTimeBlock(block) {
                if (!block || this.bulkDeleting) return;
                this.selectedTimeBlockIds = [block.id];
                await this.deleteSelectedTimeBlocks();
            },

            async confirmBooking(booking) {
                this.reviewSavingId = booking.id;
                this.blockError = "";
                try {
                    const res = await fetch("/admin/booking-requests", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({ id: booking.id, action: "confirm" }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || "Could not confirm the booking.");

                    this.pendingBookings = this.pendingBookings.filter((item) => item.id !== booking.id);
                    this.activeBooking = { ...data.booking, whatsappUrl: data.whatsappUrl || null };
                    this.confirmedBookings = [
                        { ...data.booking, calendarUrl: data.calendarUrl || null, whatsappUrl: data.whatsappUrl || null },
                        ...this.confirmedBookings.filter((item) => item.id !== data.booking.id),
                    ];
                    this.reviewStep = "blocks";
                    this.blockRows = [];
                    this.addBlockRow(this.activeBooking.booking_date, this.activeBooking.booking_time ? String(this.activeBooking.booking_time).slice(0, 5) : "", "time", this.activeBooking.booking_end_time ? String(this.activeBooking.booking_end_time).slice(0, 5) : "");
                    this.$nextTick(() => this.$refs.reviewPanel?.focus());
                } catch (error) {
                    this.blockError = error instanceof Error ? error.message : "Could not confirm the booking.";
                } finally {
                    this.reviewSavingId = "";
                }
            },

            async denyBooking(booking) {
                const confirmed = window.siteDialog
                    ? await window.siteDialog.confirm({
                        title: "Deny booking request?",
                        message: `Deny LL-B${booking.booking_no} for ${booking.people_count} people on ${this.formatDate(booking.booking_date)} (${this.timeLabel(booking)})?`,
                        confirmText: "Deny booking",
                        cancelText: "Cancel",
                        tone: "danger",
                    })
                    : true;
                if (!confirmed) return;

                this.reviewSavingId = booking.id;
                try {
                    const res = await fetch("/admin/booking-requests", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({ id: booking.id, action: "deny" }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || "Could not deny the booking.");
                    this.pendingBookings = this.pendingBookings.filter((item) => item.id !== booking.id);
                    this.statusMessage = `LL-B${booking.booking_no} denied.`;
                    this.statusIsError = false;
                    if (this.pendingBookings.length === 0) this.reviewOpen = false;
                } catch (error) {
                    this.blockError = error instanceof Error ? error.message : "Could not deny the booking.";
                } finally {
                    this.reviewSavingId = "";
                }
            },

            addBlockRow(date = "", startTime = "", type = "time", endTime = "") {
                this.blockRows.push({
                    key: this.nextRowId++,
                    type,
                    date,
                    startTime,
                    // Use the booking's finish time when it has one, else 30 minutes.
                    endTime: endTime || (startTime ? this.addThirtyMinutes(startTime) : ""),
                });
            },

            removeBlockRow(index) {
                if (this.blockRows.length === 1) return;
                this.blockRows.splice(index, 1);
            },

            addThirtyMinutes(time) {
                if (!/^\d{2}:\d{2}$/.test(time)) return "";
                const [hours, minutes] = time.split(":").map(Number);
                const total = hours * 60 + minutes + 30;
                const hh = String(Math.floor(total / 60)).padStart(2, "0");
                const mm = String(total % 60).padStart(2, "0");
                return `${hh}:${mm}`;
            },

            timeChoices(kind) {
                const values = [];
                const start = kind === "start" ? 10 * 60 + 30 : 11 * 60;
                const end = kind === "start" ? 19 * 60 + 30 : 20 * 60;
                for (let total = start; total <= end; total += 30) {
                    values.push(`${String(Math.floor(total / 60)).padStart(2, "0")}:${String(total % 60).padStart(2, "0")}`);
                }
                return values;
            },

            setBookingTimePreset() {
                this.blockRows = [];
                this.addBlockRow(
                    this.activeBooking?.booking_date || "",
                    this.activeBooking?.booking_time ? String(this.activeBooking.booking_time).slice(0, 5) : "",
                    "time",
                    this.activeBooking?.booking_end_time ? String(this.activeBooking.booking_end_time).slice(0, 5) : "",
                );
                this.blockError = "";
            },

            setBookingDayPreset() {
                this.blockRows = [];
                this.addBlockRow(this.activeBooking?.booking_date || "", "", "day");
                this.blockError = "";
            },

            startCustomBlocks() {
                this.blockRows = [];
                this.addBlockRow(this.activeBooking?.booking_date || "", this.activeBooking?.booking_time ? String(this.activeBooking.booking_time).slice(0, 5) : "", "time", this.activeBooking?.booking_end_time ? String(this.activeBooking.booking_end_time).slice(0, 5) : "");
                this.addBlockRow("", "", "day");
                this.blockError = "";
            },

            validateBlockRows() {
                const valid = [];
                for (const row of this.blockRows) {
                    if (!row.date) return "Every block needs a date.";
                    if (row.type === "time") {
                        if (!row.startTime || !row.endTime) return "Every time block needs a start and end time.";
                        if (row.endTime <= row.startTime) return "A time block must end after it starts.";
                    }
                    valid.push({
                        type: row.type,
                        date: row.date,
                        startTime: row.type === "time" ? row.startTime : "",
                        endTime: row.type === "time" ? row.endTime : "",
                    });
                }
                return valid;
            },

            async saveBookingBlocks() {
                this.blockError = "";
                const blocks = this.validateBlockRows();
                if (typeof blocks === "string") {
                    this.blockError = blocks;
                    return;
                }
                if (!blocks.length) {
                    this.finishReviewWithoutBlocks();
                    return;
                }

                this.blockSaving = true;
                try {
                    const res = await fetch("/admin/booking-blocks", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "same-origin",
                        body: JSON.stringify({
                            bookingId: this.activeBooking?.id || null,
                            blocks,
                        }),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) throw new Error(data.error || "Could not create availability blocks.");

                    this.blocks.push(...(data.dayBlocks || []));
                    this.timeBlocks.push(...(data.timeBlocks || []));
                    this.statusMessage = `Availability updated for LL-B${this.activeBooking.booking_no}.`;
                    this.statusIsError = false;
                    this.finishReviewWithoutBlocks();
                } catch (error) {
                    this.blockError = error instanceof Error ? error.message : "Could not create availability blocks.";
                } finally {
                    this.blockSaving = false;
                }
            },

            finishReviewWithoutBlocks() {
                this.activeBooking = null;
                this.reviewStep = "list";
                this.blockRows = [];
                this.blockError = "";
                if (this.pendingBookings.length > 0) {
                    this.reviewOpen = true;
                    this.$nextTick(() => this.$refs.reviewPanel?.focus());
                } else {
                    this.reviewOpen = false;
                }
            },
        }));
    });
</script>

<style lang="scss">
    [x-cloak] { display: none !important; }

    .booking-dates-container {
        max-width: 900px;
        margin: 5rem auto 2rem;
        padding: 20px;
        color: var(--txt-color);
    }

    .booking-dates-header {
        border-bottom: 3px solid var(--MenuColor, #00d4aa);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;

        h1 { margin: 0 0 0.25rem; }
        p { margin: 0 0 0.5rem; opacity: 0.78; }
    }

    .back-link {
        color: var(--bg-color-btn, #00d4aa);
        text-decoration: none;
        font-weight: 700;
    }

    .notice.error,
    .save-status {
